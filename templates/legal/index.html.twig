{% extends 'base.html.twig' %}

{% block title %}Mentions légales — DiabTrack{% endblock %}

{% block body %}

<section class="px-5 py-10 sm:px-8 lg:px-12">

    <div class="mx-auto max-w-4xl">

        {# En-tête #}
        <div class="mb-8">

            <span class="inline-flex rounded-full bg-teal-50 px-4 py-2
                         text-xs font-black uppercase tracking-wider text-teal-700">
                Informations légales
            </span>

            <h1 class="mt-5 text-3xl font-black tracking-tight text-[#102A43]
                       sm:text-4xl">
                Mentions légales
            </h1>

            <p class="mt-3 text-sm text-slate-500">
                Dernière mise à jour : 28 septembre 2026
            </p>

        </div>


        <div class="space-y-6">


            {# ÉDITEUR #}
            <article class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

                <h2 class="text-xl font-black text-[#102A43]">
                    1. Éditeur de l'application
                </h2>

                <div class="mt-4 space-y-2 leading-7 text-slate-600">

                    <p>
                        L'application web <strong>DiabTrack</strong> est éditée par :
                    </p>

                    <p>
                        <strong>Nathalie Camiul</strong><br>
                        Toulouse, France<br>
                        Email :
                        <a href="mailto:nathaliecamiul@yahoo.fr"
                           class="font-semibold text-teal-700 hover:underline">
                            nathaliecamiul@yahoo.fr
                        </a>
                    </p>

                </div>

            </article>


            {# PUBLICATION #}
            <article class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

                <h2 class="text-xl font-black text-[#102A43]">
                    2. Direction de la publication
                </h2>

                <p class="mt-4 leading-7 text-slate-600">
                    La directrice de la publication de DiabTrack est
                    <strong>Nathalie Camiul</strong>.
                </p>

            </article>


            {# HÉBERGEMENT #}
            <article class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

                <h2 class="text-xl font-black text-[#102A43]">
                    3. Hébergement
                </h2>

                <div class="mt-4 space-y-3 leading-7 text-slate-600">

                    <p>
                        L'application DiabTrack est hébergée par
                        <strong>Hostinger</strong>.
                    </p>

                    <p class="text-sm text-slate-500">
                        61 Lordou Vironos Street, 6023 Larnaca, Chypre.
                    </p>

                </div>

            </article>


            {# OBJET #}
            <article class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

                <h2 class="text-xl font-black text-[#102A43]">
                    4. Objet de DiabTrack
                </h2>

                <div class="mt-4 space-y-4 leading-7 text-slate-600">

                    <p>
                        DiabTrack est une application destinée à permettre
                        à ses utilisateurs de suivre et d'organiser des
                        informations relatives à leur diabète.
                    </p>

                    <div class="rounded-2xl border border-amber-200
                                bg-amber-50 p-5 text-amber-900">

                        <p class="font-bold">
                            Information importante
                        </p>

                        <p class="mt-2 text-sm leading-6">
                            DiabTrack ne remplace pas l'avis, le diagnostic,
                            le suivi ou le traitement d'un médecin ou d'un
                            autre professionnel de santé.
                        </p>

                    </div>

                    <p>
                        L'utilisateur ne doit pas modifier ou interrompre
                        un traitement médical sur la seule base des
                        informations présentées par l'application.
                    </p>

                    <p>
                        En cas de problème médical ou d'urgence, l'utilisateur
                        doit contacter un professionnel de santé ou les
                        services d'urgence compétents.
                    </p>

                </div>

            </article>


            {# DONNÉES #}
            <article class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

                <h2 class="text-xl font-black text-[#102A43]">
                    5. Données personnelles
                </h2>

                <div class="mt-4 space-y-3 leading-7 text-slate-600">

                    <p>
                        Dans le cadre de son fonctionnement, DiabTrack peut
                        traiter des données à caractère personnel ainsi que
                        des informations relatives à la santé renseignées
                        par ses utilisateurs.
                    </p>

                    <p>
                        Ces données peuvent être enregistrées dans la base
                        de données de l'application.
                    </p>

                    <p>
                        Les modalités relatives à leur traitement, leur
                        conservation et aux droits des utilisateurs sont
                        détaillées dans la
                        <strong>Politique de confidentialité de DiabTrack</strong>.
                    </p>

                </div>

            </article>


            {# PROPRIÉTÉ INTELLECTUELLE #}
            <article class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

                <h2 class="text-xl font-black text-[#102A43]">
                    6. Propriété intellectuelle
                </h2>

                <p class="mt-4 leading-7 text-slate-600">
                    Sauf mention contraire, la structure de l'application
                    DiabTrack, son identité visuelle, ses textes, éléments
                    graphiques et contenus originaux sont protégés par les
                    dispositions applicables en matière de propriété
                    intellectuelle.
                </p>

            </article>


            {# ÉVOLUTION #}
            <article class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

                <h2 class="text-xl font-black text-[#102A43]">
                    7. Évolution de l'application
                </h2>

                <div class="mt-4 space-y-3 leading-7 text-slate-600">

                    <p>
                        DiabTrack est actuellement proposée sous la forme
                        d'une application web.
                    </p>

                    <p>
                        Une version destinée aux appareils mobiles pourra
                        être proposée ultérieurement.
                    </p>

                </div>

            </article>

        </div>

    </div>

</section>

{% endblock %}