{% extends 'base.html.twig' %}

{% block title %}Nouvelle glycémie | DiabTrack{% endblock %}

{% block body %}

<div class="min-h-screen bg-[#F5F9FC]">

    <section class="bg-gradient-to-br from-[#102A43] via-[#123B56] to-[#0F766E] px-6 py-10 text-white">
        <div class="mx-auto max-w-4xl">

            <a
                href="{{ path('app_blood_sugar_index') }}"
                class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-cyan-100 transition hover:text-white"
            >
                ← Retour à la glycémie
            </a>

            <div class="inline-flex rounded-full bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-cyan-100">
                🩸 Suivi glycémique
            </div>

            <h1 class="mt-4 text-3xl font-black tracking-tight md:text-4xl">
                Nouvelle mesure
            </h1>

            <p class="mt-3 max-w-xl text-sm leading-6 text-slate-200">
                Enregistrez votre glycémie et ajoutez son contexte
                pour enrichir votre journal de suivi.
            </p>

        </div>
    </section>


    <div class="mx-auto max-w-4xl px-6 py-8">

        <div class="grid gap-6 lg:grid-cols-[1fr_280px]">

            <section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm md:p-8">

                <div class="mb-7">
                    <p class="text-xs font-black uppercase tracking-[0.15em] text-teal-600">
                        Nouvelle donnée
                    </p>

                    <h2 class="mt-2 text-xl font-black text-[#102A43]">
                        Informations de la mesure
                    </h2>

                    <p class="mt-2 text-xs leading-5 text-slate-400">
                        La date et l'heure sont préremplies automatiquement
                        et restent modifiables.
                    </p>
                </div>

                {{ include('blood_sugar/_form.html.twig', {
                    'button_label': 'Enregistrer la mesure'
                }) }}

            </section>


            <aside class="space-y-5">

                <div class="rounded-[24px] bg-[#102A43] p-6 text-white shadow-sm">

                    <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-xl">
                        🩸
                    </div>

                    <h3 class="mt-4 text-sm font-black">
                        Contexte de la mesure
                    </h3>

                    <p class="mt-2 text-xs leading-6 text-slate-300">
                        Indiquez si la mesure a été réalisée au réveil,
                        avant ou après un repas, au coucher ou autour
                        d'une activité physique.
                    </p>

                </div>


                <div class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm">

                    <div class="text-xl">
                        📝
                    </div>

                    <h3 class="mt-3 text-sm font-black text-[#102A43]">
                        Ajoutez une note
                    </h3>

                    <p class="mt-2 text-xs leading-6 text-slate-500">
                        Vous pouvez noter un repas inhabituel, une activité,
                        du stress, de la fatigue ou tout autre élément utile
                        pour remettre la mesure dans son contexte.
                    </p>

                </div>


                <a
                    href="{{ path('app_daily_journal') }}"
                    class="block rounded-[24px] border border-cyan-100 bg-cyan-50 p-5 transition hover:border-cyan-200 hover:bg-cyan-100/60"
                >
                    <p class="text-xs font-black uppercase tracking-wider text-cyan-700">
                        📅 Ma journée
                    </p>

                    <p class="mt-2 text-xs leading-5 text-cyan-700/70">
                        Retrouvez ensuite cette mesure dans votre journal quotidien.
                    </p>
                </a>

            </aside>

        </div>

    </div>

</div>

{% endblock %}
