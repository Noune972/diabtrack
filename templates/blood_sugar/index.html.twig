{# =============================================================
   GARDE ICI TON SCRIPT CHART.JS ACTUEL, SANS LE MODIFIER
   ============================================================= #}

<script type="module">

    document.addEventListener('DOMContentLoaded', () => {

        const canvas = document.getElementById('glycemieChart');

        if (!canvas || typeof window.Chart === 'undefined') {
            return;
        }

        /*
         * Toutes les mesures venant de Symfony/Twig.
         * On les transforme en données JavaScript.
         */
        const allMeasurements = [
            {% for blood_sugar in blood_sugars %}
                {
                    date: '{{ blood_sugar.date|date('Y-m-d') }}',
                    time: '{{ blood_sugar.time|date('H:i') }}',
                    value: {{ blood_sugar.value }},
                    relation: '{{ blood_sugar.relation|e('js') }}'
                }{% if not loop.last %},{% endif %}
            {% endfor %}
        ];

        /*
         * Conversion date + heure en véritable objet Date.
         */
        allMeasurements.forEach((measurement) => {
            measurement.datetime = new Date(
                `${measurement.date}T${measurement.time}:00`
            );
        });

        /*
         * Ordre chronologique pour le graphique.
         */
        allMeasurements.sort(
            (a, b) => a.datetime - b.datetime
        );


        /*
         * Couleur d'un point selon la classification.
         */
        const getPointColor = (value) => {

            if (value < 70) {
                return '#3B82F6';
            }

            if (value <= 110) {
                return '#10B981';
            }

            return '#EF4444';
        };


        /*
         * Création du graphique.
         */
        const chart = new window.Chart(canvas, {

            type: 'line',

            data: {
                labels: [],
                datasets: [
                    {
                        label: 'Glycémie',
                        data: [],

                        borderColor: '#0F766E',
                        backgroundColor: 'rgba(15, 118, 110, 0.08)',

                        borderWidth: 3,

                        tension: 0.35,

                        fill: true,

                        pointRadius: 5,
                        pointHoverRadius: 7,

                        pointBackgroundColor: [],
                        pointBorderColor: '#FFFFFF',
                        pointBorderWidth: 2
                    }
                ]
            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                interaction: {
                    intersect: false,
                    mode: 'index'
                },

                plugins: {

                    legend: {
                        display: false
                    },

                    tooltip: {

                        backgroundColor: '#102A43',

                        padding: 12,

                        titleFont: {
                            weight: 'bold'
                        },

                        callbacks: {

                            label: (context) => {
                                return ` ${context.parsed.y} g/L`;
                            }

                        }
                    }
                },

                scales: {

                    x: {

                        grid: {
                            display: false
                        },

                        ticks: {
                            color: '#64748B',
                            maxRotation: 0,
                            autoSkip: true,
                            maxTicksLimit: 8
                        }

                    },

                    y: {

                        beginAtZero: false,

                        suggestedMin: 50,
                        suggestedMax: 180,

                        grid: {
                            color: 'rgba(148, 163, 184, 0.15)'
                        },

                        ticks: {

                            color: '#64748B',

                            callback: (value) => {
                                return `${value} mg/L`;
                            }

                        }

                    }

                }

            }

        });


        /*
         * Met à jour le graphique.
         */
        const updateChart = (measurements) => {

            chart.data.labels = measurements.map((measurement) => {

                const date = measurement.datetime;

                return date.toLocaleDateString('fr-FR', {
                    day: '2-digit',
                    month: '2-digit'
                }) + ' ' + measurement.time;

            });


            chart.data.datasets[0].data =
                measurements.map(
                    (measurement) => measurement.value
                );


            chart.data.datasets[0].pointBackgroundColor =
                measurements.map(
                    (measurement) => getPointColor(measurement.value)
                );


            chart.update();
        };


        /*
         * Retourne le début de la journée.
         */
        const startOfDay = (date) => {

            const result = new Date(date);

            result.setHours(0, 0, 0, 0);

            return result;
        };


        /*
         * Filtres.
         */
        const filterMeasurements = (period) => {

            const now = new Date();

            let startDate = null;


            /*
             * JOUR
             */
            if (period === 'day') {

                startDate = startOfDay(now);

                return allMeasurements.filter(
                    (measurement) =>
                        measurement.datetime >= startDate
                );
            }


            /*
             * SEMAINE
             * 7 derniers jours.
             */
            if (period === 'week') {

                startDate = startOfDay(now);

                startDate.setDate(
                    startDate.getDate() - 6
                );

                return allMeasurements.filter(
                    (measurement) =>
                        measurement.datetime >= startDate
                );
            }


            /*
             * MOIS
             * 30 derniers jours.
             */
            if (period === 'month') {

                startDate = startOfDay(now);

                startDate.setDate(
                    startDate.getDate() - 29
                );

                return allMeasurements.filter(
                    (measurement) =>
                        measurement.datetime >= startDate
                );
            }


            return allMeasurements;
        };


        /*
         * Boutons de période.
         */
        const periodButtons =
            document.querySelectorAll('.period-btn');

        const customRange =
            document.getElementById('customRange');

        const customStart =
            document.getElementById('customStart');

        const customEnd =
            document.getElementById('customEnd');


        /*
         * Apparence du bouton actif.
         */
        const setActiveButton = (activeButton) => {

            periodButtons.forEach((button) => {

                button.classList.remove(
                    'bg-[#48742C]',
                    'text-white'
                );

                button.classList.add(
                    'bg-slate-100',
                    'text-slate-600'
                );

            });


            activeButton.classList.remove(
                'bg-slate-100',
                'text-slate-600'
            );

            activeButton.classList.add(
                'bg-[#48742C]',
                'text-white'
            );

        };


        /*
         * Clic sur Jour / Semaine / Mois / Personnalisé.
         */
        periodButtons.forEach((button) => {

            button.addEventListener('click', () => {

                const period =
                    button.dataset.period;

                setActiveButton(button);


                /*
                 * Période personnalisée.
                 */
                if (period === 'custom') {

                    customRange.classList.remove('hidden');

                    return;
                }


                customRange.classList.add('hidden');

                updateChart(
                    filterMeasurements(period)
                );

            });

        });


        /*
         * Filtre personnalisé.
         */
        const updateCustomRange = () => {

            if (
                !customStart.value ||
                !customEnd.value
            ) {
                return;
            }


            const start =
                new Date(`${customStart.value}T00:00:00`);

            const end =
                new Date(`${customEnd.value}T23:59:59`);


            if (start > end) {
                return;
            }


            const filtered =
                allMeasurements.filter(
                    (measurement) =>
                        measurement.datetime >= start &&
                        measurement.datetime <= end
                );


            updateChart(filtered);

        };


        customStart.addEventListener(
            'change',
            updateCustomRange
        );

        customEnd.addEventListener(
            'change',
            updateCustomRange
        );


        /*
         * Affichage initial :
         * semaine.
         */
        updateChart(
            filterMeasurements('week')
        );

    });

</script>

{% endblock %}