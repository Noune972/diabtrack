{% extends 'base.html.twig' %}

{% block title %}Ma glycémie{% endblock %}

{% block body %}

<div class="font-body bg-gray-50 min-h-screen">

    <header class=" px-6 lg:px-10 py-6">
        <div class="max-w-6xl mx-auto flex items-center justify-between">
            
            <div class="text-right">
              
            </div>
        </div>

        <div class="max-w-6xl mx-auto mt-4">
            <p class="font-display text-xl lg:text-2xl font-extrabold leading-tight">
                AJOUT <span class="text-[#48742C]">GLYCEMIE</span>
            </p>
            <p class="text-blue-900 text-sm font-medium">Historique complet</p>
        </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 lg:px-10 -mt-6 pb-10">

        {% for message in app.flashes('success') %}
            <div class="bg-[#48742C] text-white text-sm font-semibold rounded-2xl px-4 py-3 shadow-lg shadow-green-900/20 mb-4">
                ✅ {{ message }}
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <div class="lg:col-span-1 space-y-6 order-1">

                {# Dernière mesure #}
                <div class="bg-white rounded-3xl shadow-lg shadow-gray-200 ring-1 ring-gray-100 p-5">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold uppercase tracking-wide text-gray-400">Dernière mesure</span>
                        {% if blood_sugars|first %}
                            <span class="text-xs font-semibold text-gray-400">
                                {{ blood_sugars|first.date|date('d/m') }} · {{ blood_sugars|first.time|date('H:i') }}
                            </span>
                        {% endif %}
                    </div>

                    {% if blood_sugars|first %}
                        {% set last = blood_sugars|first %}
                        <div class="flex items-end gap-2">
                            <span class="font-display text-5xl font-extrabold text-gray-900">{{ last.value }}</span>
                            <span class="text-gray-400 font-semibold mb-1.5">mg/dL</span>
                        </div>
                        <div class="mt-2">
                            {% if last.relation == 'hypoglycemie' %}
                                <span class="inline-flex items-center gap-1 bg-blue-50 text-blue-700 text-xs font-bold px-2.5 py-1 rounded-full">🔵 Hypoglycémie</span>
                            {% elseif last.relation == 'hyperglycemie' %}
                                <span class="inline-flex items-center gap-1 bg-red-50 text-red-700 text-xs font-bold px-2.5 py-1 rounded-full">🔴 Hyperglycémie</span>
                            {% else %}
                                <span class="inline-flex items-center gap-1 bg-green-50 text-green-700 text-xs font-bold px-2.5 py-1 rounded-full">🟢 Normale</span>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="text-gray-400 italic text-sm py-4 text-center">Aucune mesure pour l'instant.</p>
                    {% endif %}
                </div>

                {# Formulaire de saisie #}
                <div class="bg-white rounded-3xl shadow-lg shadow-gray-200 ring-1 ring-gray-100 p-5 order-3 lg:order-none">
                    <p class="text-xs font-bold uppercase tracking-wide text-gray-400 mb-3">Nouvelle mesure</p>

                    {{ form_start(form, {'attr': {'class': 'space-y-3'}}) }}
                        <div>
                            {{ form_widget(form.value, {'attr': {
                                'class': 'w-full text-center font-display text-3xl font-extrabold border-2 border-gray-100 focus:border-[#48742C] rounded-2xl px-3 py-3 bg-gray-50 focus:bg-white outline-none transition',
                                'placeholder': '95'
                            }}) }}
                            {{ form_errors(form.value) }}
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                {{ form_widget(form.date, {'attr': {'class': 'w-full border-2 border-gray-100 focus:border-[#48742C] rounded-2xl px-3 py-2.5 bg-gray-50 focus:bg-white outline-none text-sm transition'}}) }}
                                {{ form_errors(form.date) }}
                            </div>
                            <div>
                                {{ form_widget(form.time, {'attr': {'class': 'w-full border-2 border-gray-100 focus:border-[#48742C] rounded-2xl px-3 py-2.5 bg-gray-50 focus:bg-white outline-none text-sm transition'}}) }}
                                {{ form_errors(form.time) }}
                            </div>
                        </div>

                        <button type="submit"
                            class="w-full bg-blue-900 hover:bg-blue-800 active:scale-[0.98] text-white font-display font-bold rounded-2xl py-3.5 shadow-lg shadow-blue-900/30 transition">
                            Enregistrer une glycémie
                        </button>
                    {{ form_end(form) }}
                </div>

                {# Barème #}
                <div class="bg-white rounded-3xl shadow-lg shadow-gray-200 ring-1 ring-gray-100 p-5 order-4 lg:order-none">
                    <p class="text-xs font-bold uppercase tracking-wide text-gray-400 mb-3">Barème</p>
                    <div class="grid grid-cols-2 gap-2">
                        <div class="flex items-center gap-2 bg-red-50 rounded-xl px-3 py-2">
                            <span class="w-3 h-3 rounded-full bg-red-800 shrink-0"></span>
                            <span class="text-xs font-semibold text-red-900 leading-tight">Hyper<br><span class="text-red-500 font-medium"> supp ou = 110 mg/l </span></span>
                        </div>
                        
                        <div class="flex items-center gap-2 bg-green-50 rounded-xl px-3 py-2">
                            <span class="w-3 h-3 rounded-full bg-[#48742C] shrink-0"></span>
                            <span class="text-xs font-semibold text-green-900 leading-tight">Normal<br><span class="text-green-600 font-medium"> inf ou = 110 mg/l</span></span>
                        </div>
                        <div class="flex items-center gap-2 bg-blue-50 rounded-xl px-3 py-2">
                            <span class="w-3 h-3 rounded-full bg-blue-800 shrink-0"></span>
                            <span class="text-xs font-semibold text-blue-900 leading-tight">Hypo<br><span class="text-blue-600 font-medium"> inf ou= 70 mg/l</span></span>
                        </div>
                    </div>
                </div>

            </div>

            {# ===================== CONTENU PRINCIPAL (mobile: ordre 2, 5) ===================== #}
            <div class="lg:col-span-2 space-y-6 order-2">

                {# Graphique #}
                <div class="bg-white rounded-3xl shadow-lg shadow-gray-200 ring-1 ring-gray-100 p-5 lg:p-6">
                    <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                        <p class="text-sm font-bold uppercase tracking-wide text-gray-400">Évolution</p>

                        <div class="flex gap-2 flex-wrap">
                            <button type="button" data-period="day"
                                class="period-btn text-xs font-bold px-3 py-1.5 rounded-full bg-gray-100 text-gray-600">Jour</button>
                            <button type="button" data-period="week"
                                class="period-btn text-xs font-bold px-3 py-1.5 rounded-full bg-[#48742C] text-white">Semaine</button>
                            <button type="button" data-period="month"
                                class="period-btn text-xs font-bold px-3 py-1.5 rounded-full bg-gray-100 text-gray-600">Mois</button>
                            <button type="button" data-period="custom"
                                class="period-btn text-xs font-bold px-3 py-1.5 rounded-full bg-gray-100 text-gray-600">Personnalisé</button>
                        </div>
                    </div>

                    <div id="customRange" class="hidden grid grid-cols-2 gap-2 mb-4 max-w-xs">
                        <input type="date" id="customStart" class="border-2 border-gray-100 rounded-xl px-2 py-1.5 text-xs">
                        <input type="date" id="customEnd" class="border-2 border-gray-100 rounded-xl px-2 py-1.5 text-xs">
                    </div>

                    <div class="relative h-72 lg:h-80">
                        <canvas id="glycemieChart"></canvas>
                    </div>

                    <div class="flex justify-center gap-4 mt-4 text-xs font-semibold text-gray-500">
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-blue-800"></span> Hypo</span>
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-green-800"></span> Normale</span>
                        <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-red-800"></span> Hyper</span>
                    </div>
                </div>

                {# Historique complet en tableau (desktop) #}
                <div class="bg-white rounded-3xl shadow-lg shadow-gray-200 ring-1 ring-gray-100 p-5 lg:p-6 order-5 lg:order-none">
                    <p class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-4">Historique complet</p>

                    {% if blood_sugars|length > 0 %}
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead>
                                    <tr class="border-b border-gray-200 text-xs text-gray-500 uppercase">
                                        <th class="py-2 pr-4">Date</th>
                                        <th class="py-2 pr-4">Heure</th>
                                        <th class="py-2 pr-4">Valeur</th>
                                        <th class="py-2 pr-4">Statut</th>
                                        <th class="py-2">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for blood_sugar in blood_sugars %}
                                        <tr class="border-b border-gray-50 hover:bg-gray-50 transition">
                                            <td class="py-3 pr-4 text-sm">{{ blood_sugar.date|date('d/m/Y') }}</td>
                                            <td class="py-3 pr-4 text-sm">{{ blood_sugar.time|date('H:i') }}</td>
                                            <td class="py-3 pr-4 text-sm font-bold">{{ blood_sugar.value }} <span class="text-gray-400 font-normal text-xs">mg/dL</span></td>
                                            <td class="py-3 pr-4">
                                                {% if blood_sugar.relation == 'hypoglycemie' %}
                                                    <span class="inline-block bg-blue-100 text-blue-800 text-xs font-semibold px-2 py-1 rounded-full">Hypoglycémie</span>
                                                {% elseif blood_sugar.relation == 'hyperglycemie' %}
                                                    <span class="inline-block bg-red-100 text-red-800 text-xs font-semibold px-2 py-1 rounded-full">Hyperglycémie</span>
                                                {% else %}
                                                    <span class="inline-block bg-green-100 text-green-800 text-xs font-semibold px-2 py-1 rounded-full">Normale</span>
                                                {% endif %}
                                            </td>
                                            <td class="py-3">
                                                <div class="flex items-center gap-3 text-xs">
                                                    <a href="{{ path('app_blood_sugar_show', {'id': blood_sugar.id}) }}" class="text-blue-700 font-semibold hover:underline">Voir</a>
                                                    <a href="{{ path('app_blood_sugar_edit', {'id': blood_sugar.id}) }}" class="text-gray-600 font-semibold hover:underline">Modifier</a>
                                                    <form method="post" action="{{ path('app_blood_sugar_delete', {'id': blood_sugar.id}) }}"
                                                        onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');"
                                                        style="display:inline;">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ blood_sugar.id) }}">
                                                        <button class="text-red-700 font-semibold hover:underline">Supprimer</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-gray-400 italic text-sm py-4 text-center">Aucune mesure enregistrée pour le moment.</p>
                    {% endif %}
                </div>

            </div>
        </div>
    </div>
</div>

<script type="module">
    import { Chart, registerables } from 'chart.js';
    import annotationPlugin from 'chartjs-plugin-annotation';
    import 'chartjs-adapter-date-fns';

    Chart.register(...registerables, annotationPlugin);

    const rawData = {{ blood_sugars|map(bs => {
        'datetime': (bs.date|date('Y-m-d')) ~ ' ' ~ (bs.time|date('H:i:s')),
        'value': bs.value
    })|json_encode|raw }};

    const allPoints = rawData
        .map(p => ({ x: new Date(p.datetime.replace(' ', 'T')), y: parseFloat(p.value) }))
        .sort((a, b) => a.x - b.x);

    const SEUIL_HYPO = 70;
    const SEUIL_HYPER = 110;
    const Y_MAX = 350;

    const ctx = document.getElementById('glycemieChart').getContext('2d');

    let chart = new Chart(ctx, {
        type: 'line',
        data: {
            datasets: [{
                label: 'Glycémie (mg/dL)',
                data: [],
                borderColor: '#1e3a8a',
                backgroundColor: 'rgba(30, 58, 138, 0.1)',
                pointBackgroundColor: '#1e3a8a',
                pointRadius: 4,
                tension: 0.3,
                fill: true,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    type: 'time',
                    time: { unit: 'day' },
                    ticks: { font: { size: 10 } }
                },
                y: {
                    min: 0,
                    max: Y_MAX,
                    ticks: { font: { size: 10 } }
                }
            },
            plugins: {
                legend: { display: false },
                annotation: {
                    annotations: {
                        zoneHyper: {
                            type: 'box',
                            yMin: SEUIL_HYPER,
                            yMax: Y_MAX,
                            backgroundColor: 'rgba(220, 38, 38, 0.08)',
                            borderWidth: 0,
                        },
                        zoneNormale: {
                            type: 'box',
                            yMin: SEUIL_HYPO,
                            yMax: SEUIL_HYPER,
                            backgroundColor: 'rgba(72, 116, 44, 0.08)',
                            borderWidth: 0,
                        },
                        zoneHypo: {
                            type: 'box',
                            yMin: 0,
                            yMax: SEUIL_HYPO,
                            backgroundColor: 'rgba(37, 99, 235, 0.08)',
                            borderWidth: 0,
                        },
                    }
                }
            }
        }
    });

    function filterByPeriod(period) {
        const now = new Date();
        let start;

        if (period === 'day') {
            start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        } else if (period === 'week') {
            start = new Date(now);
            start.setDate(now.getDate() - 7);
        } else if (period === 'month') {
            start = new Date(now);
            start.setMonth(now.getMonth() - 1);
        } else if (period === 'custom') {
            const startInput = document.getElementById('customStart').value;
            const endInput = document.getElementById('customEnd').value;
            if (!startInput || !endInput) return allPoints;
            const startDate = new Date(startInput);
            const endDate = new Date(endInput);
            endDate.setHours(23, 59, 59);
            return allPoints.filter(p => p.x >= startDate && p.x <= endDate);
        } else {
            start = new Date(0);
        }

        return allPoints.filter(p => p.x >= start);
    }

    function updateChart(period) {
        chart.data.datasets[0].data = filterByPeriod(period);
        chart.update();
    }

    document.querySelectorAll('.period-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.period-btn').forEach(b => {
                b.classList.remove('bg-[#48742C]', 'text-white');
                b.classList.add('bg-gray-100', 'text-gray-600');
            });
            btn.classList.remove('bg-gray-100', 'text-gray-600');
            btn.classList.add('bg-[#48742C]', 'text-white');

            const period = btn.dataset.period;
            document.getElementById('customRange').classList.toggle('hidden', period !== 'custom');
            updateChart(period);
        });
    });

    document.getElementById('customStart').addEventListener('change', () => updateChart('custom'));
    document.getElementById('customEnd').addEventListener('change', () => updateChart('custom'));

    updateChart('week');
</script>
{% endblock %}