{% extends 'base.html.twig' %}

{% block title %}Ma glycémie - DiabTrack{% endblock %}

{% block body %}

<div class="min-h-screen bg-[#F5F9FC]">

    {# =========================================================
       HERO
       ========================================================= #}

    <section class="relative overflow-hidden bg-gradient-to-br from-[#102A43] via-[#0C4A6E] to-[#0F766E]">

        <div class="absolute -right-24 -top-32 h-96 w-96 rounded-full bg-cyan-300/10 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-teal-300/10 blur-3xl"></div>

        <div class="relative mx-auto max-w-7xl px-6 py-12 lg:px-8">

            <div class="flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between">

                <div>

                    <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-cyan-100 ring-1 ring-white/10">
                        <span>💧</span>
                        Suivi glycémique
                    </div>

                    <h1 class="mt-5 text-4xl font-black tracking-tight text-white sm:text-5xl">
                        Ma
                        <span class="text-cyan-300">
                            glycémie
                        </span>
                    </h1>

                    <p class="mt-4 max-w-2xl text-sm leading-6 text-cyan-50/80 sm:text-base">
                        Enregistrez vos mesures et consultez l'évolution de votre
                        glycémie au fil du temps.
                    </p>

                </div>


<a
    href="{{ path('app_blood_sugar_new') }}"
    class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-5 py-3.5 text-sm font-black text-[#102A43] shadow-lg transition hover:-translate-y-0.5 hover:bg-cyan-50 hover:shadow-xl"
>
    <span class="text-lg">＋</span>
    Nouvelle mesure
</a>

                {% if blood_sugars|first %}

                    {% set heroLast = blood_sugars|first %}

                    <div class="flex items-center gap-4 rounded-2xl bg-white/10 px-5 py-4 ring-1 ring-white/10 backdrop-blur-sm">

                        <div>

                            <p class="text-[10px] font-black uppercase tracking-[0.16em] text-cyan-200">
                                Dernière mesure
                            </p>

                            <div class="mt-1 flex items-end gap-2">

                                <span class="text-3xl font-black text-white">
                                    {{ heroLast.value }}
                                </span>

                                <span class="mb-1 text-xs font-bold text-slate-300">
                                    g/L
                                </span>

                            </div>

                        </div>

                        <div class="h-10 w-px bg-white/20"></div>

                        <div class="text-xs font-semibold text-slate-300">

                            {{ heroLast.date|date('d/m/Y') }}

                            <br>

                            {{ heroLast.time|date('H:i') }}

                        </div>

                    </div>

                {% endif %}

            </div>

        </div>

    </section>


    {# =========================================================
       CONTENU
       ========================================================= #}

    <main class="mx-auto max-w-7xl px-6 py-10 lg:px-8">


        {# FLASH #}

        {% for message in app.flashes('success') %}

            <div class="mb-7 flex items-center gap-4 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-800">

                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 font-black">
                    ✓
                </div>

                <div>

                    <p class="text-sm font-black">
                        Mesure enregistrée
                    </p>

                    <p class="mt-0.5 text-xs">
                        {{ message }}
                    </p>

                </div>

            </div>

        {% endfor %}


        <div class="grid grid-cols-1 gap-7 xl:grid-cols-[360px_1fr]">


            {# =================================================
               COLONNE GAUCHE
               ================================================= #}

            <div class="space-y-6">


                {# =============================================
                   DERNIÈRE MESURE
                   ============================================= #}

                <section class="relative overflow-hidden rounded-[28px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70">

                    <div class="absolute -right-12 -top-12 h-36 w-36 rounded-full bg-cyan-50"></div>

                    <div class="relative">

                        <div class="flex items-center justify-between">

                            <div>

                                <p class="text-[10px] font-black uppercase tracking-[0.18em] text-teal-600">
                                    Aujourd'hui
                                </p>

                                <h2 class="mt-1 text-lg font-black text-[#102A43]">
                                    Dernière mesure
                                </h2>

                            </div>

                            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-cyan-50 text-xl">
                                💧
                            </div>

                        </div>


                        {% if blood_sugars|first %}

                            {% set last = blood_sugars|first %}

                            <div class="mt-7 flex items-end gap-2">

                                <span class="text-5xl font-black tracking-tight text-[#102A43]">
                                    {{ last.value }}
                                </span>

                                <span class="mb-1.5 text-sm font-bold text-slate-400">
                                    g/L
                                </span>

                            </div>


                            <div class="mt-4 flex flex-wrap items-center justify-between gap-3">

                               {% if last.relation == 'hypoglycemie' %}

    <span class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1.5 text-xs font-black text-blue-700">
        <span class="h-2 w-2 rounded-full bg-blue-500"></span>
        Sous l’objectif
    </span>

{% elseif last.relation == 'hyperglycemie' %}

    <span class="inline-flex items-center gap-2 rounded-full bg-red-50 px-3 py-1.5 text-xs font-black text-red-700">
        <span class="h-2 w-2 rounded-full bg-red-500"></span>
        Au-dessus de l’objectif
    </span>

{% else %}

    <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-black text-emerald-700">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        Dans l’objectif
    </span>

{% endif %}
                                <span class="text-xs font-semibold text-slate-400">
                                    {{ last.date|date('d/m/Y') }} · {{ last.time|date('H:i') }}
                                </span>

                            </div>

                        {% else %}

                            <div class="py-8 text-center">

                                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-50 text-2xl">
                                    💧
                                </div>

                                <p class="mt-4 text-sm font-semibold text-slate-400">
                                    Aucune mesure enregistrée.
                                </p>

                            </div>

                        {% endif %}

                    </div>

                </section>


                {# =============================================
                   NOUVELLE MESURE
                   ============================================= #}

                <section class="rounded-[28px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70">

                    <div class="mb-6">

                        <p class="text-[10px] font-black uppercase tracking-[0.18em] text-teal-600">
                            Ajouter
                        </p>

                        <h2 class="mt-1 text-xl font-black text-[#102A43]">
                            Nouvelle glycémie
                        </h2>

                        <p class="mt-2 text-xs leading-5 text-slate-400">
                            Saisissez votre nouvelle mesure.
                        </p>

                    </div>


                    {{ form_start(form, {
                        'attr': {
                            'class': 'space-y-4'
                        }
                    }) }}


                        <div>

                            <label class="mb-2 block text-xs font-black uppercase tracking-wider text-slate-400">
                                Glycémie
                            </label>

                            <div class="relative">

                                {{ form_widget(form.value, {
                                    'attr': {
                                        'class': 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 pr-20 text-center text-3xl font-black text-[#102A43] outline-none transition placeholder:text-slate-300 focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100',
                                        'placeholder': '0,95'
                                    }
                                }) }}

                                <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-xs font-black text-slate-400">
                                    g/L
                                </span>

                            </div>

                            <div class="mt-1 text-xs text-red-600">
                                {{ form_errors(form.value) }}
                            </div>

                        </div>


                        <div class="grid grid-cols-2 gap-3">

                            <div>

                                <label class="mb-2 block text-xs font-bold text-slate-500">
                                    Date
                                </label>

                                {{ form_widget(form.date, {
                                    'attr': {
                                        'class': 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-xs text-[#102A43] outline-none transition focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100'
                                    }
                                }) }}

                                {{ form_errors(form.date) }}

                            </div>


                            <div>

                                <label class="mb-2 block text-xs font-bold text-slate-500">
                                    Heure
                                </label>

                                {{ form_widget(form.time, {
                                    'attr': {
                                        'class': 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-xs text-[#102A43] outline-none transition focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100'
                                    }
                                }) }}

                                {{ form_errors(form.time) }}

                            </div>

                        </div>

                                                {# CONTEXTE DE LA MESURE #}
                        <div>

                            <label class="mb-2 block text-xs font-bold text-slate-500">
                                Contexte de la mesure
                            </label>

                            {{ form_widget(form.context, {
                                'attr': {
                                    'class': 'w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-3 text-xs font-semibold text-[#102A43] outline-none transition focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100'
                                }
                            }) }}

                            <div class="mt-1 text-xs text-red-600">
                                {{ form_errors(form.context) }}
                            </div>

                        </div>


                        {# NOTE PERSONNELLE #}
                        <div>

                            <label class="mb-2 block text-xs font-bold text-slate-500">
                                Note personnelle
                                <span class="font-medium text-slate-400">
                                    (facultatif)
                                </span>
                            </label>

                            {{ form_widget(form.note, {
                                'attr': {
                                    'class': 'min-h-[110px] w-full resize-y rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition placeholder:text-slate-300 focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100'
                                }
                            }) }}

                            <div class="mt-1 text-xs text-red-600">
                                {{ form_errors(form.note) }}
                            </div>

                            <p class="mt-2 text-[11px] leading-5 text-slate-400">
                                Vous pouvez indiquer un repas inhabituel, une activité,
                                du stress, de la fatigue ou tout autre élément utile.
                            </p>

                        </div>


                        <button
                            type="submit"
                            class="group flex w-full items-center justify-center gap-2 rounded-2xl bg-[#102A43] px-5 py-4 text-sm font-black text-white shadow-lg shadow-slate-900/10 transition hover:-translate-y-0.5 hover:bg-[#163B5C]"
                        >
                            Enregistrer la mesure

                            <span class="transition-transform group-hover:translate-x-1">
                                →
                            </span>
                        </button>


                    {{ form_end(form) }}

                </section>


                {# =============================================
                   BARÈME
                   ============================================= #}

                <section class="rounded-[28px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70">

                    <div class="mb-5">

                        <p class="text-[10px] font-black uppercase tracking-[0.18em] text-teal-600">
                            Repères
                        </p>

                        <h2 class="mt-1 text-lg font-black text-[#102A43]">
                            Barème glycémique
                        </h2>

                    </div>


                    <div class="space-y-3">


                        <div class="flex items-center justify-between rounded-2xl bg-blue-50 p-4">

                            <div class="flex items-center gap-3">

                                <span class="h-3 w-3 rounded-full bg-blue-500"></span>

                                <div>

                                    <p class="text-xs font-black text-blue-800">
                                        Hypoglycémie
                                    </p>

                                    <p class="mt-0.5 text-[11px] font-semibold text-blue-500">
                                        inférieur à 0,70 g/L
                                    </p>

                                </div>

                            </div>

                            <span class="text-lg font-black text-blue-700">
                                &lt; 0,70g
                            </span>

                        </div>


                        <div class="flex items-center justify-between rounded-2xl bg-emerald-50 p-4">

                            <div class="flex items-center gap-3">

                                <span class="h-3 w-3 rounded-full bg-emerald-500"></span>

                                <div>

                                    <p class="text-xs font-black text-emerald-800">
                                        Normale
                                    </p>

                                    <p class="mt-0.5 text-[11px] font-semibold text-emerald-600">
                                        de 0,70g à 1,10 g/L
                                    </p>

                                </div>

                            </div>

                            <span class="text-lg font-black text-emerald-700">
                                0,70g – 1,10g
                            </span>

                        </div>


                        <div class="flex items-center justify-between rounded-2xl bg-red-50 p-4">

                            <div class="flex items-center gap-3">

                                <span class="h-3 w-3 rounded-full bg-red-500"></span>

                                <div>

                                    <p class="text-xs font-black text-red-800">
                                        Hyperglycémie
                                    </p>

                                    <p class="mt-0.5 text-[11px] font-semibold text-red-500">
                                        supérieur à 1,10 g/L
                                    </p>

                                </div>

                            </div>

                            <span class="text-lg font-black text-red-700">
                                &gt; 1,10 g
                            </span>

                        </div>

                    </div>

                </section>

            </div>


            {# =================================================
               COLONNE DROITE
               ================================================= #}

            <div class="space-y-7">


                {# =============================================
                   GRAPHIQUE
                   ============================================= #}

                <section class="rounded-[30px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70 lg:p-8">

                    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">

                        <div>

                            <p class="text-[10px] font-black uppercase tracking-[0.18em] text-teal-600">
                                Analyse
                            </p>

                            <h2 class="mt-1 text-2xl font-black tracking-tight text-[#102A43]">
                                Évolution de la glycémie
                            </h2>

                            <p class="mt-2 text-xs text-slate-400">
                                Visualisez vos mesures dans le temps.
                            </p>

                        </div>


                        <div class="flex flex-wrap gap-2">

                            <button
                                type="button"
                                data-period="day"
                                class="period-btn rounded-full bg-slate-100 px-4 py-2 text-xs font-black text-slate-600 transition"
                            >
                                Jour
                            </button>

                            <button
                                type="button"
                                data-period="week"
                                class="period-btn rounded-full bg-[#48742C] px-4 py-2 text-xs font-black text-white transition"
                            >
                                Semaine
                            </button>

                            <button
                                type="button"
                                data-period="month"
                                class="period-btn rounded-full bg-slate-100 px-4 py-2 text-xs font-black text-slate-600 transition"
                            >
                                Mois
                            </button>

                            <button
                                type="button"
                                data-period="custom"
                                class="period-btn rounded-full bg-slate-100 px-4 py-2 text-xs font-black text-slate-600 transition"
                            >
                                Personnalisé
                            </button>

                        </div>

                    </div>


                    <div
                        id="customRange"
                        class="mt-5 hidden grid max-w-md grid-cols-2 gap-3"
                    >

                        <input
                            type="date"
                            id="customStart"
                            class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs text-[#102A43] outline-none focus:border-teal-400"
                        >

                        <input
                            type="date"
                            id="customEnd"
                            class="rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs text-[#102A43] outline-none focus:border-teal-400"
                        >

                    </div>


                    <div class="relative mt-7 h-72 lg:h-[380px]">
                        <canvas id="glycemieChart"></canvas>
                    </div>


                    <div class="mt-6 flex flex-wrap justify-center gap-5 border-t border-slate-100 pt-5 text-xs font-bold text-slate-500">

                        <span class="flex items-center gap-2">
                            <span class="h-2.5 w-2.5 rounded-full bg-blue-500"></span>
                            Hypoglycémie
                        </span>

                        <span class="flex items-center gap-2">
                            <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                            Normale
                        </span>

                        <span class="flex items-center gap-2">
                            <span class="h-2.5 w-2.5 rounded-full bg-red-500"></span>
                            Hyperglycémie
                        </span>

                    </div>

                </section>


                {# =============================================
                   HISTORIQUE
                   ============================================= #}

                <section class="overflow-hidden rounded-[30px] bg-white shadow-sm ring-1 ring-slate-200/70">

                    <div class="flex items-center justify-between border-b border-slate-100 px-6 py-6 lg:px-8">

                        <div>

                            <p class="text-[10px] font-black uppercase tracking-[0.18em] text-teal-600">
                                Historique
                            </p>

                            <h2 class="mt-1 text-xl font-black text-[#102A43]">
                                Toutes mes mesures
                            </h2>

                        </div>


                        <div class="rounded-xl bg-slate-50 px-3 py-2 text-xs font-black text-slate-500">
                            {{ blood_sugars|length }}
                            mesure{% if blood_sugars|length > 1 %}s{% endif %}
                        </div>

                    </div>

                    {# INFORMATION IMPORTANTE SUR LA CLASSIFICATION #}
<div class="mx-6 mt-6 lg:mx-8">
    <div class="rounded-2xl border-2 border-red-500 bg-red-50 p-5 shadow-sm">

        <div class="flex items-start gap-4">

            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-600 text-xl text-white shadow">
                !
            </div>

            <div>
                <p class="text-sm font-black uppercase tracking-wide text-red-700">
                    Important — interprétation des résultats
                </p>

                <p class="mt-2 text-sm font-semibold leading-6 text-red-950">
                    Les classifications affichées dans DiabTrack sont calculées
                    en fonction du
                    <strong>contexte de la mesure</strong>
                    et de
                    <strong>vos objectifs glycémiques personnels enregistrés</strong>.
                </p>

                <p class="mt-2 text-sm leading-6 text-red-800">
                    Elles indiquent la position de votre mesure par rapport à
                    vos objectifs personnels et ne constituent pas, à elles seules,
                    un diagnostic médical.
                </p>

                <a
                    href="{{ path('app_glycemic_target') }}"
                    class="mt-4 inline-flex items-center gap-2 rounded-xl bg-red-600 px-4 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-red-700"
                >
                    🎯 Voir ou modifier mes objectifs
                </a>

            </div>

        </div>

    </div>
</div>


                    {% if blood_sugars|length > 0 %}

                        <div class="overflow-x-auto">

                            <table class="w-full text-left">

                                <thead class="bg-slate-50/80">

                                    <tr class="text-[10px] font-black uppercase tracking-[0.14em] text-slate-400">

                                        <th class="px-6 py-4">
                                            Date
                                        </th>

                                        <th class="px-6 py-4">
                                            Heure
                                        </th>
                                        <th class="px-6 py-4">
                                          Contexte
                                          </th>

                                        <th class="px-6 py-4">
                                            Valeur
                                        </th>

                                        <th class="px-6 py-4">
                                            Statut
                                        </th>

                                        <th class="px-6 py-4 text-right">
                                            Actions
                                        </th>

                                    </tr>

                                </thead>


                                <tbody class="divide-y divide-slate-100">

                                {% for blood_sugar in blood_sugars %}

                                    <tr class="transition hover:bg-slate-50/70">

                                        <td class="whitespace-nowrap px-6 py-5 text-sm font-semibold text-slate-600">
                                            {{ blood_sugar.date|date('d/m/Y') }}
                                        </td>

                                        <td class="whitespace-nowrap px-6 py-5 text-sm text-slate-500">
                                            {{ blood_sugar.time|date('H:i') }}
                                        </td>

                                        <td class="px-6 py-5">

    {% set context_labels = {
        'reveil': '🌅 Au réveil',
        'avant_petit_dejeuner': '🥐 Avant petit-déjeuner',
        'apres_petit_dejeuner': '🥐 Après petit-déjeuner',
        'avant_dejeuner': '🍽️ Avant déjeuner',
        'apres_dejeuner': '🍽️ Après déjeuner',
        'avant_diner': '🌙 Avant dîner',
        'apres_diner': '🌙 Après dîner',
        'coucher': '😴 Avant le coucher',
        'avant_activite': '🏃 Avant activité',
        'apres_activite': '🏃 Après activité',
        'controle': '🩸 Contrôle ponctuel',
        'autre': '📋 Autre'
    } %}

    {% if blood_sugar.context %}

        <span class="inline-flex rounded-full bg-cyan-50 px-3 py-1.5 text-xs font-black text-cyan-700">
            {{ context_labels[blood_sugar.context]|default(blood_sugar.context) }}
        </span>

        {% if blood_sugar.note %}
            <p
                class="mt-2 max-w-[220px] truncate text-[11px] text-slate-400"
                title="{{ blood_sugar.note }}"
            >
                📝 {{ blood_sugar.note }}
            </p>
        {% endif %}

    {% else %}

        <span class="text-xs text-slate-300">
            —
        </span>

    {% endif %}

</td>


                                        <td class="whitespace-nowrap px-6 py-5">

                                            <span class="text-lg font-black text-[#102A43]">
                                                {{ blood_sugar.value }}
                                            </span>

                                            <span class="ml-1 text-[10px] font-bold text-slate-400">
                                                g/L
                                            </span>

                                        </td>


                                        <td class="whitespace-nowrap px-6 py-5">

                                         {% if blood_sugar.relation == 'hypoglycemie' %}

    <span class="inline-flex items-center gap-2 rounded-full bg-blue-50 px-3 py-1.5 text-xs font-black text-blue-700">
        <span class="h-2 w-2 rounded-full bg-blue-500"></span>
        Sous l’objectif
    </span>

{% elseif blood_sugar.relation == 'hyperglycemie' %}

    <span class="inline-flex items-center gap-2 rounded-full bg-red-50 px-3 py-1.5 text-xs font-black text-red-700">
        <span class="h-2 w-2 rounded-full bg-red-500"></span>
        Au-dessus de l’objectif
    </span>

{% else %}

    <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-black text-emerald-700">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        Dans l’objectif
    </span>

{% endif %}

                                        </td>


                                        <td class="whitespace-nowrap px-6 py-5">

                                            <div class="flex items-center justify-end gap-2">

                                                <a
                                                    href="{{ path('app_blood_sugar_show', {'id': blood_sugar.id}) }}"
                                                    class="rounded-lg bg-cyan-50 px-3 py-2 text-[11px] font-black text-cyan-700 transition hover:bg-cyan-100"
                                                >
                                                    Voir
                                                </a>


                                                <a
                                                    href="{{ path('app_blood_sugar_edit', {'id': blood_sugar.id}) }}"
                                                    class="rounded-lg bg-slate-100 px-3 py-2 text-[11px] font-black text-slate-600 transition hover:bg-slate-200"
                                                >
                                                    Modifier
                                                </a>


                                                <form
                                                    method="post"
                                                    action="{{ path('app_blood_sugar_delete', {'id': blood_sugar.id}) }}"
                                                    onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');"
                                                >

                                                    <input
                                                        type="hidden"
                                                        name="_token"
                                                        value="{{ csrf_token('delete' ~ blood_sugar.id) }}"
                                                    >

                                                    <button
                                                        type="submit"
                                                        class="rounded-lg bg-red-50 px-3 py-2 text-[11px] font-black text-red-600 transition hover:bg-red-100"
                                                    >
                                                        Supprimer
                                                    </button>

                                                </form>

                                            </div>

                                        </td>

                                    </tr>

                                {% endfor %}

                                </tbody>

                            </table>

                        </div>

                    {% else %}

                        <div class="px-6 py-16 text-center">

                            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-cyan-50 text-2xl">
