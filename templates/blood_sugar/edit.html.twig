{% extends 'base.html.twig' %}

{% block title %}Modifier une glycémie | DiabTrack{% endblock %}

{% block body %}

<div class="min-h-screen bg-[#F5F9FC]">

    <section class="bg-gradient-to-br from-[#102A43] via-[#123B56] to-[#0F766E] px-6 py-10 text-white">

        <div class="mx-auto max-w-4xl">

            <a
                href="{{ path('app_blood_sugar_index') }}"
                class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-cyan-100 transition hover:text-white"
            >
                ← Retour à la glycémie
            </a>

            <div class="inline-flex rounded-full bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-cyan-100">
                ✏️ Modification
            </div>

            <h1 class="mt-4 text-3xl font-black tracking-tight md:text-4xl">
                Modifier la mesure
            </h1>

            <p class="mt-3 max-w-xl text-sm leading-6 text-slate-200">
                Corrigez la valeur, le moment de la mesure,
                son contexte ou votre note personnelle.
            </p>

        </div>

    </section>


    <div class="mx-auto max-w-4xl px-6 py-8">

        <div class="grid gap-6 lg:grid-cols-[1fr_280px]">

            {# FORMULAIRE #}
            <section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm md:p-8">

                <div class="mb-6">
                    <p class="text-xs font-black uppercase tracking-[0.15em] text-teal-600">
                        Mesure #{{ blood_sugar.id }}
                    </p>

                    <h2 class="mt-2 text-xl font-black text-[#102A43]">
                        Informations de la mesure
                    </h2>
                </div>

                {{ include('blood_sugar/_form.html.twig', {
                    'button_label': 'Enregistrer les modifications'
                }) }}

            </section>


            {# RÉSUMÉ #}
            <aside class="space-y-5">

                <div class="rounded-[24px] bg-[#102A43] p-6 text-white shadow-sm">

                    <p class="text-xs font-black uppercase tracking-wider text-cyan-200">
                        Valeur actuelle
                    </p>

                    <div class="mt-3">
                        <span class="text-4xl font-black">
                            {{ blood_sugar.value }}
                        </span>

                        <span class="ml-1 text-xs font-bold text-slate-300">
                            mg/dL
                        </span>
                    </div>

                    <p class="mt-4 text-xs leading-5 text-slate-300">
                        {{ blood_sugar.date ? blood_sugar.date|date('d/m/Y') : '' }}
                        {% if blood_sugar.time %}
                            à {{ blood_sugar.time|date('H:i') }}
                        {% endif %}
                    </p>

                </div>


                <div class="rounded-[24px] border border-slate-200 bg-white p-6 shadow-sm">

                    <div class="mb-3 text-xl">
                        💡
                    </div>

                    <h3 class="text-sm font-black text-[#102A43]">
                        Pourquoi ajouter le contexte ?
                    </h3>

                    <p class="mt-2 text-xs leading-6 text-slate-500">
                        Le moment du repas, l'activité physique,
                        le stress ou la fatigue peuvent aider à remettre
                        une mesure dans son contexte.
                    </p>

                </div>


                <div class="rounded-[24px] border border-red-100 bg-red-50/50 p-6">

                    <h3 class="text-sm font-black text-red-700">
                        Supprimer la mesure
                    </h3>

                    <p class="mb-4 mt-2 text-xs leading-5 text-red-600/70">
                        Cette action supprimera définitivement cet enregistrement.
                    </p>

                    {{ include('blood_sugar/_delete_form.html.twig') }}

                </div>

            </aside>

        </div>

    </div>

</div>

{% endblock %}