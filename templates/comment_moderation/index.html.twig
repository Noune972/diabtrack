{% extends 'base.html.twig' %}

{% block title %}Modération des commentaires - DiabTrack{% endblock %}

{% block body %}
<section class="min-h-screen bg-white py-12 px-4">
    <div class="max-w-2xl mx-auto">

        <a href="{{ path('app_blog_index') }}" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-6">
            &larr; Retour au blog
        </a>

        <h1 class="text-3xl font-bold text-gray-800 mb-8">
            Commentaires en attente ({{ comments|length }})
        </h1>

        {% for message in app.flashes('success') %}
            <div class="bg-green-50 text-green-700 border border-green-200 rounded-xl px-4 py-3 mb-4 text-sm">
                {{ message }}
            </div>
        {% endfor %}

        {% if comments is empty %}
            <p class="text-gray-500 text-sm">Aucun commentaire en attente de modération.</p>
        {% else %}
            <div class="flex flex-col gap-4">
                {% for comment in comments %}
                    <div class="bg-gray-50 rounded-xl p-4">
                        <p class="text-xs text-gray-400 mb-2">
                            Sur l'article
                            <a href="{{ path('app_blog_show', {id: comment.article.id}) }}" class="text-blue-700 hover:underline">
                                {{ comment.article.title }}
                            </a>
                            — {{ comment.date|date('d/m/Y') }}
                        </p>
                        <p class="text-sm text-gray-700 mb-4">{{ comment.content }}</p>

                        <div class="flex gap-3">
                            <form method="post" action="{{ path('app_comment_moderation_validate', {id: comment.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('validate' ~ comment.id) }}">
                                <button type="submit"
                                        class="bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition">
                                    Valider
                                </button>
                            </form>
                            <form method="post" action="{{ path('app_comment_moderation_reject', {id: comment.id}) }}"
                                  onsubmit="return confirm('Rejeter et supprimer ce commentaire ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ comment.id) }}">
                                <button type="submit"
                                        class="bg-red-50 hover:bg-red-100 text-red-700 text-sm font-medium px-4 py-2 rounded-lg transition">
                                    Rejeter
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
{% endblock %}