                    id="home-weather-card"
                    class="absolute left-1/2 top-3 z-30 hidden w-[calc(100%-2rem)] max-w-[280px] -translate-x-1/2 rounded-3xl bg-white/95 p-4 shadow-xl shadow-slate-900/10 ring-1 ring-white/70 backdrop-blur transition-all duration-500 sm:left-8 sm:top-5 sm:w-auto sm:min-w-[210px] sm:max-w-none sm:translate-x-0 lg:left-auto lg:right-4 lg:top-2"
                >
                    <div class="flex items-center gap-3">
                        <div
                            id="home-weather-icon"
                            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-3xl"
                        >
                            ☀️
                        </div>

                        <div>
                            <p
                                id="home-weather-location"
                                class="text-[10px] font-black uppercase tracking-[0.15em] text-slate-400"
                            >
                                Autour de vous
                            </p>

                            <div class="flex items-baseline gap-1">
                                <span
                                    id="home-weather-temperature"
                                    class="text-2xl font-black text-[#102A43]"
                                >
                                    —
                                </span>
                                <span class="text-xs font-bold text-slate-400">°C</span>
                            </div>
                        </div>
                    </div>

                    <p
                        id="home-weather-description"
                        class="mt-3 text-sm font-black text-[#102A43]"
                    >
                        Belle journée ☀️
                    </p>

                    <p
                        id="home-weather-air"
                        class="mt-1 text-xs font-semibold text-teal-600"
                    >
                        🌬️ Qualité de l'air : —
                    </p>
                </div>

                {# GRAND CERCLE #}
                <div class="absolute h-[330px] w-[330px] rounded-full bg-gradient-to-br from-cyan-100 via-teal-50 to-white shadow-2xl shadow-cyan-900/10 sm:h-[520px] sm:w-[520px]"></div>


                {# MOTIF CERCLES #}
                <div class="absolute h-[285px] w-[285px] rounded-full border border-teal-200/60 sm:h-[440px] sm:w-[440px]"></div>

                <div class="absolute h-[235px] w-[235px] rounded-full border border-dashed border-cyan-300/60 sm:h-[370px] sm:w-[370px]"></div>


                {# MASCOTTE #}
                <img
                    src="{{ asset('images/mascotte.png') }}"
                    alt="Mascotte DiabTrack"
                    class="relative z-10 max-h-[270px] max-w-[58%] object-contain drop-shadow-2xl sm:max-h-[440px] sm:max-w-[80%]">


                {# CARTE GLYCEMIE #}
                <div class="absolute left-2 top-[185px] z-20 hidden rounded-2xl bg-white/95 p-4 shadow-xl shadow-slate-900/10 backdrop-blur sm:block sm:left-2 sm:top-24 lg:left-0 lg:top-28">

                    <div class="flex items-center gap-3">

                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-50 text-xl">
                            💧
                        </div>

                        <div>
                            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                                Glycémie
                            </p>

                            <p class="text-lg font-black text-[#102A43]">
                                Votre suivi
                            </p>
                        </div>

                    </div>

                    <div class="mt-3 flex h-8 items-end gap-1">
                        <span class="h-3 w-2 rounded-full bg-teal-200"></span>
                        <span class="h-5 w-2 rounded-full bg-teal-300"></span>
                        <span class="h-4 w-2 rounded-full bg-teal-300"></span>
                        <span class="h-7 w-2 rounded-full bg-teal-400"></span>
                        <span class="h-5 w-2 rounded-full bg-teal-400"></span>
                        <span class="h-8 w-2 rounded-full bg-teal-500"></span>
                        <span class="h-6 w-2 rounded-full bg-teal-400"></span>
                    </div>

                </div>


                {# CARTE ACTIVITE #}
                <div class="absolute bottom-12 right-2 z-20 rounded-2xl bg-white/95 p-3 shadow-xl shadow-slate-900/10 backdrop-blur sm:bottom-20 sm:right-2 sm:p-4">

                    <div class="flex items-center gap-3">

                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50 text-xl">
                            🏃
                        </div>

                        <div>
                            <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">
                                Activité
                            </p>

                            <p class="text-sm font-black text-[#102A43]">
                                Restez actif
                            </p>
                        </div>

                    </div>

                </div>


                {# CARTE INSULINE #}
                <div class="absolute right-4 top-[170px] z-20 flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-xl shadow-xl shadow-slate-900/10 sm:right-5 sm:top-16 sm:h-14 sm:w-14 sm:text-2xl">
                    💉
                </div>


                {# CARTE ALIMENTATION #}
                <div class="absolute bottom-10 left-5 z-20 flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-xl shadow-xl shadow-slate-900/10 sm:bottom-16 sm:left-12 sm:h-14 sm:w-14 sm:text-2xl">
                    🥗
                </div>

            </div>

        </section>


        {# =========================
           FONCTIONNALITÉS
           ========================= #}

        <section id="fonctionnalites" class="border-t border-slate-100 bg-white">

            <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">

                <div class="mx-auto max-w-2xl text-center">

                    <p class="text-xs font-black uppercase tracking-[0.2em] text-teal-600">
                        Tout au même endroit
                    </p>

                    <h2 class="mt-3 text-3xl font-black tracking-tight text-[#102A43]">
                        Un suivi pensé pour votre quotidien
                    </h2>

                    <p class="mt-3 text-sm leading-6 text-slate-500">
                        DiabTrack centralise les informations utiles pour vous aider
                        à visualiser plus facilement votre suivi.
                    </p>

                </div>


                <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">

                    <div class="group rounded-[26px] bg-[#F7FBFC] p-6 ring-1 ring-slate-100 transition duration-300 hover:-translate-y-1 hover:shadow-xl">

                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-100 text-2xl">
                            💧
                        </div>

                        <h3 class="mt-5 font-black text-[#102A43]">
                            Glycémie
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-slate-500">
                            Enregistrez et retrouvez facilement vos mesures.
                        </p>

                    </div>


                    <div class="group rounded-[26px] bg-[#F7FBFC] p-6 ring-1 ring-slate-100 transition duration-300 hover:-translate-y-1 hover:shadow-xl">

                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-100 text-2xl">
                            💉
                        </div>

                        <h3 class="mt-5 font-black text-[#102A43]">
                            Insuline
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-slate-500">
                            Centralisez vos injections dans votre espace personnel.
                        </p>

                    </div>


                    <div class="group rounded-[26px] bg-[#F7FBFC] p-6 ring-1 ring-slate-100 transition duration-300 hover:-translate-y-1 hover:shadow-xl">

                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-100 text-2xl">
                            🥗
                        </div>

                        <h3 class="mt-5 font-black text-[#102A43]">
                            Alimentation
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-slate-500">
                            Gardez une trace de vos repas et de votre alimentation.
                        </p>

                    </div>


                    <div class="group rounded-[26px] bg-[#F7FBFC] p-6 ring-1 ring-slate-100 transition duration-300 hover:-translate-y-1 hover:shadow-xl">

                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-100 text-2xl">
                            🏃
                        </div>

                        <h3 class="mt-5 font-black text-[#102A43]">
                            Activité physique
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-slate-500">
                            Suivez vos activités et votre évolution au quotidien.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        {# =========================
           BANDEAU FINAL
           ========================= #}

        <section id="securite" class="bg-[#102A43]">

            <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-8 px-6 py-12 text-center lg:flex-row lg:px-8 lg:text-left">

                <div>

                    <p class="text-xs font-black uppercase tracking-[0.2em] text-cyan-300">
                        DiabTrack
                    </p>

                    <h2 class="mt-2 text-2xl font-black text-white">
                        Votre suivi. Votre santé. Votre quotidien.
                    </h2>

                    <p class="mt-2 max-w-xl text-sm leading-6 text-slate-300">
                        Un espace personnel pour centraliser les informations
                        utiles à votre suivi du diabète.
                    </p>

                </div>


                <a href="{{ path('app_register') }}"
                   class="shrink-0 rounded-2xl bg-white px-7 py-4 text-sm font-black text-[#102A43] shadow-xl transition hover:-translate-y-1">
                    Commencer maintenant →
                </a>

            </div>

        </section>

    </main>

</div>


<script>
document.addEventListener('DOMContentLoaded', () => {

    const card = document.getElementById('home-weather-card');

    if (!card || !navigator.geolocation) {
        return;
    }

    const weatherInfo = (code) => {
        if (code === 0) return { icon: '☀️', label: 'Grand soleil' };
        if ([1, 2].includes(code)) return { icon: '🌤️', label: 'Quelques éclaircies' };
        if (code === 3) return { icon: '☁️', label: 'Ciel couvert' };
        if ([45, 48].includes(code)) return { icon: '🌫️', label: 'Brouillard' };
        if ([51, 53, 55, 56, 57].includes(code)) return { icon: '🌦️', label: 'Quelques gouttes' };
        if ([61, 63, 65, 66, 67, 80, 81, 82].includes(code)) return { icon: '🌧️', label: 'Temps pluvieux' };
        if ([71, 73, 75, 77, 85, 86].includes(code)) return { icon: '❄️', label: 'Temps neigeux' };
        if ([95, 96, 99].includes(code)) return { icon: '⛈️', label: 'Temps orageux' };
        return { icon: '🌈', label: 'Conditions variables' };
    };

    const airLabel = (aqi) => {
        if (aqi === null || aqi === undefined) return 'indisponible';
        if (aqi <= 20) return 'bonne';
        if (aqi <= 40) return 'correcte';
        if (aqi <= 60) return 'moyenne';
        if (aqi <= 80) return 'dégradée';
        if (aqi <= 100) return 'mauvaise';
        return 'très mauvaise';
    };

    const showWeather = async (latitude, longitude) => {
        try {
            const url = new URL('{{ path('app_environment') }}', window.location.origin);
            url.searchParams.set('latitude', latitude);
            url.searchParams.set('longitude', longitude);

            const response = await fetch(url.toString(), {
                headers: { 'Accept': 'application/json' }
            });

            if (!response.ok) {
                return;
            }

            const result = await response.json();

            if (!result.success || !result.data) {
                return;
            }

            const weather = result.data.weather ?? {};
            const air = result.data.airQuality ?? {};
            const info = weatherInfo(weather.weatherCode);

            document.getElementById('home-weather-icon').textContent = info.icon;
            document.getElementById('home-weather-temperature').textContent =
                weather.temperature ?? '—';
            document.getElementById('home-weather-description').textContent =
                info.label;
            document.getElementById('home-weather-air').textContent =
                `🌬️ Qualité de l'air : ${airLabel(air.europeanAqi)}`;

            card.classList.remove('hidden');
        } catch (error) {
            // La météo reste simplement masquée si elle est indisponible.
        }
    };

    navigator.geolocation.getCurrentPosition(
        (position) => {
            showWeather(
                position.coords.latitude,
                position.coords.longitude
            );
        },
        () => {
            // Pas d'autorisation : aucune météo n'est affichée.
        },
        {
            enableHighAccuracy: false,
            timeout: 8000,
            maximumAge: 300000
        }
    );
});
</script>

{% endblock %}