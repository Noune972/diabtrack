{% extends 'base.html.twig' %}

{% block title %}Mes notifications | DiabTrack{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50">

    <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">

        {# HERO #}
        <section class="relative overflow-hidden rounded-3xl bg-[#102A43] p-7 text-white shadow-xl sm:p-9">

            <div class="absolute -right-16 -top-16 h-52 w-52 rounded-full bg-teal-400/10"></div>
            <div class="absolute -bottom-20 right-20 h-44 w-44 rounded-full bg-cyan-400/10"></div>

            <div class="relative flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">

                <div>
                    <div class="mb-3 flex items-center gap-3">
                        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-2xl">
                            🔔
                        </div>

                        {% if unreadCount > 0 %}
                            <span class="rounded-full bg-teal-400 px-3 py-1 text-xs font-bold text-[#102A43]">
                                {{ unreadCount }}
                                non {{ unreadCount > 1 ? 'lues' : 'lue' }}
                            </span>
                        {% endif %}
                    </div>

                    <h1 class="text-2xl font-black sm:text-3xl">
                        Mes notifications
                    </h1>

                    <p class="mt-2 max-w-xl text-sm leading-6 text-slate-300">
                        Retrouvez ici les rappels et informations envoyés
                        automatiquement par DiabTrack.
                    </p>
                </div>

                {% if unreadCount > 0 %}
                    <form
                        method="post"
                        action="{{ path('app_notification_read_all') }}"
                    >
                        <button
                            type="submit"
                            class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-5 py-3 text-sm font-bold text-[#102A43] shadow-lg transition hover:bg-slate-100"
                        >
                            ✓ Tout marquer comme lu
                        </button>
                    </form>
                {% endif %}

            </div>
        </section>


        {# COMPTEUR #}
        <section class="mt-6 grid gap-4 sm:grid-cols-2">

            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center gap-4">

                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-teal-50 text-xl">
                        🔔
                    </div>

                    <div>
                        <div class="text-2xl font-black text-[#102A43]">
                            {{ notifications|length }}
                        </div>

                        <div class="text-sm font-medium text-slate-500">
                            Notifications récentes
                        </div>
                    </div>

                </div>
            </div>

            <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-center gap-4">

                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-50 text-xl">
                        ✨
                    </div>

                    <div>
                        <div class="text-2xl font-black text-[#102A43]">
                            {{ unreadCount }}
                        </div>

                        <div class="text-sm font-medium text-slate-500">
                            Non {{ unreadCount > 1 ? 'lues' : 'lue' }}
                        </div>
                    </div>

                </div>
            </div>

        </section>


        {# LISTE #}
        <section class="mt-6">

            {% if notifications is empty %}

                <div class="rounded-3xl border border-slate-200 bg-white px-6 py-16 text-center shadow-sm">

                    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-100 text-3xl">
                        🔕
                    </div>

                    <h2 class="mt-5 text-xl font-black text-[#102A43]">
                        Aucune notification
                    </h2>

                    <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-500">
                        Lorsque l'un de vos rappels DiabTrack arrivera à
                        échéance, sa notification apparaîtra ici.
                    </p>

                    <a
                        href="{{ path('app_reminder_index') }}"
                        class="mt-6 inline-flex items-center gap-2 rounded-2xl bg-teal-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-teal-700"
                    >
                        🔔 Gérer mes rappels
                    </a>

                </div>

            {% else %}

                <div class="space-y-3">

                    {% for notification in notifications %}

                        <article
                            class="relative overflow-hidden rounded-2xl border p-5 shadow-sm transition hover:shadow-md
                            {{ notification.isRead
                                ? 'border-slate-200 bg-white'
                                : 'border-teal-200 bg-teal-50/60' }}"
                        >

                            {% if not notification.isRead %}
                                <div class="absolute bottom-0 left-0 top-0 w-1 bg-teal-500"></div>
                            {% endif %}

                            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

                                <div class="flex min-w-0 items-start gap-4">

                                    <div
                                        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-xl
                                        {{ notification.isRead
                                            ? 'bg-slate-100'
                                            : 'bg-white shadow-sm' }}"
                                    >
                                        🔔
                                    </div>

                                    <div class="min-w-0">

                                        <div class="flex flex-wrap items-center gap-2">

                                            <h2 class="font-bold text-[#102A43]">
                                                Rappel DiabTrack
                                            </h2>

                                            {% if not notification.isRead %}
                                                <span class="rounded-full bg-teal-500 px-2.5 py-1 text-[11px] font-black uppercase tracking-wide text-white">
                                                    Nouveau
                                                </span>
                                            {% endif %}

                                        </div>

                                        <p class="mt-2 text-sm leading-6 text-slate-700">
                                            {{ notification.message }}
                                        </p>

                                        <div class="mt-2 flex items-center gap-2 text-xs font-medium text-slate-400">
                                            <span>🕐</span>

                                            <span>
                                                {{ notification.createdAt|date('d/m/Y à H:i') }}
                                            </span>
                                        </div>

                                    </div>

                                </div>

                                {% if not notification.isRead %}

                                    <form
                                        method="post"
                                        action="{{ path(
                                            'app_notification_read',
                                            {id: notification.id}
                                        ) }}"
                                        class="shrink-0"
                                    >
                                        <button
                                            type="submit"
                                            class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-teal-200 bg-white px-4 py-2.5 text-xs font-bold text-teal-700 transition hover:bg-teal-600 hover:text-white sm:w-auto"
                                        >
                                            ✓ Marquer comme lue
                                        </button>
                                    </form>

                                {% else %}

                                    <div class="shrink-0 text-xs font-bold text-slate-400">
                                        ✓ Lue
                                    </div>

                                {% endif %}

                            </div>

                        </article>

                    {% endfor %}

                </div>

            {% endif %}

        </section>


        {# RETOUR #}
        <div class="mt-7">
            <a
                href="{{ path('app_dashboard') }}"
                class="inline-flex items-center gap-2 text-sm font-bold text-slate-500 transition hover:text-[#102A43]"
            >
                ← Retour au tableau de bord
            </a>
        </div>

    </div>
</div>
{% endblock %}