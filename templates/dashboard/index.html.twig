{% extends 'base.html.twig' %}

{% block title %}Mon tableau de bord - DiabTrack{% endblock %}

{% block body %}

<div class="min-h-screen bg-[#F5F9FC]">

    {# =========================================================
       HERO
       ========================================================= #}
    <section class="relative overflow-hidden bg-gradient-to-br from-[#0F2D46] via-[#0C4A6E] to-[#0F766E]">

        <div class="absolute -right-24 -top-32 h-96 w-96 rounded-full bg-cyan-300/10 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-teal-300/10 blur-3xl"></div>

        <div class="relative mx-auto max-w-7xl px-6 py-12 lg:px-8 lg:py-16">

            <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">

                <div class="max-w-2xl">

                    <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-cyan-100 ring-1 ring-white/10">
                        <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
                        Mon espace santé
                    </div>

                    <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl">
                        Mon tableau de bord
                    </h1>

                    <p class="mt-4 max-w-xl text-base leading-7 text-cyan-50/80">
                        Retrouvez tous vos suivis au même endroit et accédez rapidement
                        aux informations utiles pour votre quotidien.
                    </p>

                </div>


                {# MINI CARTE #}
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">

                    <div class="rounded-2xl bg-white/10 px-5 py-4 backdrop-blur ring-1 ring-white/10">
                        <span class="text-xl">🩸</span>
                        <p class="mt-2 text-xs font-semibold text-cyan-100">
                            Glycémie
                        </p>
                    </div>

                    <div class="rounded-2xl bg-white/10 px-5 py-4 backdrop-blur ring-1 ring-white/10">
                        <span class="text-xl">💉</span>
                        <p class="mt-2 text-xs font-semibold text-cyan-100">
                            Insuline
                        </p>
                    </div>

                    <div class="col-span-2 rounded-2xl bg-white/10 px-5 py-4 backdrop-blur ring-1 ring-white/10 sm:col-span-1">
                        <span class="text-xl">🏃</span>
                        <p class="mt-2 text-xs font-semibold text-cyan-100">
                            Activité
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </section>


    {# =========================================================
   VUE D'ENSEMBLE SANTÉ
   ========================================================= #}

<section class="mx-auto max-w-7xl px-6 pt-10 lg:px-8">

    <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">

        <div>
            <p class="text-xs font-black uppercase tracking-[0.2em] text-teal-600">
                Aujourd'hui
            </p>

            <h2 class="mt-1 text-2xl font-black tracking-tight text-[#102A43] sm:text-3xl">
                Vue d'ensemble santé
            </h2>

            <p class="mt-2 text-sm text-slate-500">
                Un aperçu rapide des données enregistrées aujourd'hui.
            </p>
        </div>

        <a href="{{ path('app_daily_journal') }}"
           class="inline-flex items-center gap-2 text-sm font-black text-teal-600 transition hover:text-teal-700">
            Voir ma journée
            <span>→</span>
        </a>

    </div>


    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-5">

        {# GLYCÉMIE #}
        <a href="{{ path('app_blood_sugar_index') }}"
           class="group rounded-[26px] bg-white p-5 shadow-sm ring-1 ring-slate-200/70 transition hover:-translate-y-1 hover:shadow-lg">

            <div class="flex items-start justify-between">

                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-rose-50 text-xl">
                    🩸
                </span>

                <span class="rounded-full bg-rose-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-rose-600">
                    {{ blood_sugar_count }} mesure{{ blood_sugar_count > 1 ? 's' : '' }}
                </span>

            </div>

            <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-400">
                Dernière glycémie
            </p>

            {% if last_blood_sugar %}

                <div class="mt-1 flex items-baseline gap-1">
                    <span class="text-3xl font-black text-[#102A43]">
                        {{ last_blood_sugar.value }}
                    </span>

                    <span class="text-xs font-bold text-slate-400">
                        mg/L
                    </span>
                </div>

                <p class="mt-2 text-xs text-slate-400">
                    {{ last_blood_sugar.time
                        ? 'À ' ~ last_blood_sugar.time|date('H:i')
                        : 'Aujourd’hui' }}
                </p>

            {% else %}

                <p class="mt-2 text-xl font-black text-[#102A43]">
                    —
                </p>

                <p class="mt-2 text-xs text-slate-400">
                    Aucune mesure aujourd'hui
                </p>

            {% endif %}

        </a>


        {# REPAS #}
        <a href="{{ path('app_meal_new') }}"
           class="group rounded-[26px] bg-white p-5 shadow-sm ring-1 ring-slate-200/70 transition hover:-translate-y-1 hover:shadow-lg">

            <div class="flex items-start justify-between">

                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-50 text-xl">
                    🥗
                </span>

                <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-emerald-600">
                    {{ meal_count }} repas
                </span>

            </div>

            <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-400">
                Nutrition
            </p>

            <div class="mt-1 flex items-baseline gap-1">
                <span class="text-3xl font-black text-[#102A43]">
                    {{ meal_calories_today }}
                </span>

                <span class="text-xs font-bold text-slate-400">
                    kcal
                </span>
            </div>

            <p class="mt-2 text-xs text-slate-400">
                Total enregistré aujourd'hui
            </p>

        </a>


        {# INSULINE #}
        <a href="{{ path('app_insuline_index') }}"
           class="group rounded-[26px] bg-white p-5 shadow-sm ring-1 ring-slate-200/70 transition hover:-translate-y-1 hover:shadow-lg">

            <div class="flex items-start justify-between">

                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-50 text-xl">
                    💉
                </span>

                <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-indigo-600">
                    {{ insuline_count }} injection{{ insuline_count > 1 ? 's' : '' }}
                </span>

            </div>

            <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-400">
                Insuline
            </p>

            <div class="mt-1 flex items-baseline gap-1">
                <span class="text-3xl font-black text-[#102A43]">
                    {{ insuline_dose_today|number_format(1, ',', ' ') }}
                </span>

                <span class="text-xs font-bold text-slate-400">
                    U
                </span>
            </div>

            <p class="mt-2 text-xs text-slate-400">
                Dose totale aujourd'hui
            </p>

        </a>


        {# ACTIVITÉ #}
        <a href="{{ path('app_sporting_activity_index') }}"
           class="group rounded-[26px] bg-white p-5 shadow-sm ring-1 ring-slate-200/70 transition hover:-translate-y-1 hover:shadow-lg">

            <div class="flex items-start justify-between">

                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-50 text-xl">
                    🏃
                </span>

                <span class="rounded-full bg-sky-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-sky-600">
                    {{ activity_count }} séance{{ activity_count > 1 ? 's' : '' }}
                </span>

            </div>

            <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-400">
                Activité physique
            </p>

            <div class="mt-1 flex items-baseline gap-1">
                <span class="text-3xl font-black text-[#102A43]">
                    {{ activity_duration_today }}
                </span>

                <span class="text-xs font-bold text-slate-400">
                    min
                </span>
            </div>

            <p class="mt-2 text-xs text-slate-400">
                {{ activity_calories_today }} kcal dépensées
            </p>

        </a>


        {# HBA1C #}
        <a href="{{ path('app_hba1c_index') }}"
           class="group rounded-[26px] bg-white p-5 shadow-sm ring-1 ring-slate-200/70 transition hover:-translate-y-1 hover:shadow-lg">

            <div class="flex items-start justify-between">

                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-violet-50 text-xl">
                    🧪
                </span>

                <span class="rounded-full bg-violet-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-violet-600">
                    Dernière valeur
                </span>

            </div>

            <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-400">
                HbA1c
            </p>

            {% if last_hba1c %}

                <div class="mt-1 flex items-baseline gap-1">
                    <span class="text-3xl font-black text-[#102A43]">
                        {{ last_hba1c.value }}
                    </span>

                    <span class="text-xs font-bold text-slate-400">
                        %
                    </span>
                </div>

                <p class="mt-2 text-xs text-slate-400">
                    Mesurée le {{ last_hba1c.date|date('d/m/Y') }}
                </p>

            {% else %}

                <p class="mt-2 text-xl font-black text-[#102A43]">
                    —
                </p>

                <p class="mt-2 text-xs text-slate-400">
                    Aucune mesure enregistrée
                </p>

            {% endif %}

        </a>

    </div>

</section>

{# =========================================================
   MON ENVIRONNEMENT
   ========================================================= #}

<section class="mx-auto max-w-7xl px-6 pt-10 lg:px-8">

    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">

        <div>
            <p class="text-xs font-black uppercase tracking-[0.2em] text-teal-600">
                Autour de moi
            </p>

            <h2 class="mt-1 text-2xl font-black tracking-tight text-[#102A43] sm:text-3xl">
                Mon environnement
            </h2>

            <p class="mt-2 text-sm text-slate-500">
                Météo, qualité de l'air, pollens et activité adaptée aux conditions extérieures.
            </p>

            <p id="environment-location-label" class="mt-2 text-xs font-bold text-teal-700">
                📍 Recherche de votre position actuelle...
            </p>
        </div>

        <button
            type="button"
            id="environment-location-button"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#102A43] px-5 py-3 text-sm font-black text-white shadow-sm transition hover:bg-[#163A5F]"
        >
            <span>📍</span>
            Utiliser ma position actuelle
        </button>

    </div>


    {# ÉTAT INITIAL #}
    <div
        id="environment-empty"
        class="rounded-[30px] bg-white p-8 text-center shadow-sm ring-1 ring-slate-200/70"
    >
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-cyan-50 text-2xl">
            📍
        </div>

        <h3 class="mt-4 text-lg font-black text-[#102A43]">
            Découvrez les conditions autour de vous
        </h3>

        <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-slate-500">
            Autorisez temporairement votre localisation pour afficher
            la météo, la qualité de l'air, les pollens et une suggestion
            d'activité physique.
        </p>

        <p class="mt-3 text-xs text-slate-400">
            Votre position n'est pas enregistrée dans votre profil.
        </p>
    </div>


    {# CHARGEMENT #}
    <div
        id="environment-loading"
        class="hidden rounded-[30px] bg-white p-8 text-center shadow-sm ring-1 ring-slate-200/70"
    >
        <div class="mx-auto h-9 w-9 animate-spin rounded-full border-4 border-slate-200 border-t-teal-600"></div>

        <p class="mt-4 text-sm font-bold text-slate-500">
            Récupération des conditions autour de vous...
        </p>
    </div>


    {# ERREUR #}
    <div
        id="environment-error"
        class="hidden rounded-[30px] border border-amber-200 bg-amber-50 p-6"
    >
        <div class="flex items-start gap-4">

            <span class="text-2xl">⚠️</span>

            <div>
                <h3 class="font-black text-[#102A43]">
                    Localisation indisponible
                </h3>

                <p
                    id="environment-error-message"
                    class="mt-1 text-sm text-amber-800"
                >
                    Impossible de récupérer votre position.
                </p>
            </div>

        </div>
    </div>


    {# DONNÉES ENVIRONNEMENTALES #}
    <div id="environment-content" class="hidden">

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">

            {# MÉTÉO #}
            <div
                id="environment-weather-card"
                class="rounded-[26px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70 transition-all duration-500"
            >

                <div class="flex items-start justify-between">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-50 text-2xl">
                        <span id="environment-weather-icon">🌤️</span>
                    </div>

                    <span class="rounded-full bg-sky-50 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-sky-600">
                        Météo
                    </span>

                </div>

                <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-400">
                    Température
                </p>

                <div class="mt-1 flex items-baseline gap-1">

                    <span
                        id="environment-temperature"
                        class="text-3xl font-black text-[#102A43]"
                    >
                        —
                    </span>

                    <span class="text-sm font-bold text-slate-400">
                        °C
                    </span>

                </div>

                <p
                    id="environment-weather-description"
                    class="mt-2 text-sm font-bold text-slate-600"
                >
                    —
                </p>

                <div
    id="environment-weather-cheer"
    class="mt-4 rounded-2xl bg-gradient-to-r from-sky-50 to-amber-50 p-4"
>
    <p
        id="environment-weather-greeting"
        class="font-black text-[#102A43]"
    >
        Une belle journée ! ☀️
    </p>

    <p
        id="environment-weather-message"
        class="mt-1 text-xs leading-5 text-slate-500"
    >
        Découvrez les conditions autour de vous.
    </p>
</div>

                <div class="mt-4 space-y-1 text-xs text-slate-500">

                    <p>
                        Ressenti :
                        <strong
                            id="environment-apparent-temperature"
                            class="text-slate-700"
                        >
                            —
                        </strong>
                    </p>

                    <p>
                        Min / Max :
                        <strong
                            id="environment-min-max"
                            class="text-slate-700"
                        >
                            —
                        </strong>
                    </p>

                    <p>
                        Vent :
                        <strong
                            id="environment-wind"
                            class="text-slate-700"
                        >
                            —
                        </strong>
                    </p>

                </div>

            </div>


            {# UV #}
            <div class="rounded-[26px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70">

                <div class="flex items-start justify-between">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-2xl">
                        ☀️
                    </div>

                    <span class="rounded-full bg-amber-50 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-amber-600">
                        UV
                    </span>

                </div>

                <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-400">
                    Indice UV maximum
                </p>

                <p
                    id="environment-uv"
                    class="mt-1 text-3xl font-black text-[#102A43]"
                >
                    —
                </p>

                <p
                    id="environment-uv-label"
                    class="mt-2 text-sm font-bold text-slate-500"
                >
                    —
                </p>

            </div>


            {# QUALITÉ DE L'AIR #}
            <div class="rounded-[26px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70">

                <div class="flex items-start justify-between">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-50 text-2xl">
                        🌬️
                    </div>

                    <span class="rounded-full bg-teal-50 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-teal-600">
                        Air
                    </span>

                </div>

                <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-400">
                    Indice européen
                </p>

                <p
                    id="environment-aqi"
                    class="mt-1 text-3xl font-black text-[#102A43]"
                >
                    —
                </p>

                <p
                    id="environment-aqi-label"
                    class="mt-2 text-sm font-bold text-slate-500"
                >
                    —
                </p>

                <div class="mt-4 flex gap-4 text-xs text-slate-500">

                    <p>
                        PM2.5
                        <strong
                            id="environment-pm25"
                            class="block text-slate-700"
                        >
                            —
                        </strong>
                    </p>

                    <p>
                        PM10
                        <strong
                            id="environment-pm10"
                            class="block text-slate-700"
                        >
                            —
                        </strong>
                    </p>

                </div>

            </div>


            {# POLLENS #}
            <div class="rounded-[26px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70">

                <div class="flex items-start justify-between">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 text-2xl">
                        🌿
                    </div>

                    <span class="rounded-full bg-emerald-50 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-emerald-600">
                        Pollens
                    </span>

                </div>

                <p class="mt-5 text-xs font-bold uppercase tracking-wider text-slate-400">
                    Concentrations actuelles
                </p>

                <div class="mt-3 space-y-2 text-sm">

                    <div class="flex justify-between">
                        <span class="text-slate-500">Graminées</span>
                        <strong id="pollen-grass" class="text-[#102A43]">—</strong>
                    </div>

                    <div class="flex justify-between">
                        <span class="text-slate-500">Bouleau</span>
                        <strong id="pollen-birch" class="text-[#102A43]">—</strong>
                    </div>

                    <div class="flex justify-between">
                        <span class="text-slate-500">Aulne</span>
                        <strong id="pollen-alder" class="text-[#102A43]">—</strong>
                    </div>

                    <div class="flex justify-between">
                        <span class="text-slate-500">Armoise</span>
                        <strong id="pollen-mugwort" class="text-[#102A43]">—</strong>
                    </div>

                    <div class="flex justify-between">
                        <span class="text-slate-500">Ambroisie</span>
                        <strong id="pollen-ragweed" class="text-[#102A43]">—</strong>
                    </div>

                </div>

            </div>

        </div>


        {# ===================== SPORT SUGGÉRÉ ===================== #}
        <div class="relative mt-5 overflow-hidden rounded-[30px] bg-gradient-to-r from-[#0F2D46] to-[#0F766E] p-6 text-white shadow-lg sm:p-7">

            <div class="absolute -right-16 -top-20 h-52 w-52 rounded-full bg-cyan-300/10 blur-2xl"></div>

            <div class="relative flex flex-col gap-5 md:flex-row md:items-center md:justify-between">

                <div class="flex items-start gap-4">

                    <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/10 text-3xl">
                        <span id="environment-sport-icon">🏃</span>
                    </div>

                    <div>

                        <p class="text-xs font-black uppercase tracking-[0.2em] text-cyan-200">
                            Activité suggérée aujourd'hui
                        </p>

                        <h3
                            id="environment-sport-title"
                            class="mt-1 text-xl font-black"
                        >
                            —
                        </h3>

                        <p
                            id="environment-sport-description"
                            class="mt-2 max-w-3xl text-sm leading-6 text-cyan-50/80"
                        >
                            —
                        </p>

                    </div>

                </div>

                <a
                    href="{{ path('app_sporting_activity_index') }}"
                    class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-black text-[#102A43] transition hover:bg-cyan-50"
                >
                    Mes activités
                    <span>→</span>
                </a>

            </div>

            <p class="relative mt-4 text-[11px] leading-5 text-cyan-100/60">
                Suggestion générale basée sur les conditions environnementales.
                Adaptez toujours l'activité à votre état de santé et à vos capacités.
            </p>

        </div>

    </div>

</section>


    {# =========================================================
       CONTENU
       ========================================================= #}

    <main class="mx-auto max-w-7xl px-6 py-10 lg:px-8">

        <div class="mb-8">

            <p class="text-xs font-black uppercase tracking-[0.2em] text-teal-600">
                Mes suivis
            </p>

            <div class="mt-1 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">

                <div>
                    <h2 class="text-3xl font-black tracking-tight text-[#102A43]">
                        Que souhaitez-vous suivre ?
                    </h2>

                    <p class="mt-2 text-sm text-slate-500">
                        Choisissez une catégorie pour consulter ou ajouter vos données.
                    </p>
                </div>

                <div class="hidden items-center gap-2 rounded-xl bg-white px-4 py-2 text-xs font-bold text-slate-400 shadow-sm ring-1 ring-slate-100 sm:flex">
                    <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                    Espace personnel
                </div>

            </div>

        </div>


        {# =========================================================
           CARTES PRINCIPALES
           ========================================================= #}

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-6">


            {# ================= GLYCEMIE ================= #}

            <a href="{{ path('app_blood_sugar_index') }}"
               class="group relative overflow-hidden rounded-[30px] bg-white shadow-sm ring-1 ring-slate-200/70 transition duration-300 hover:-translate-y-1 hover:shadow-xl md:col-span-1 xl:col-span-3">

                <div class="absolute -right-16 -top-16 h-52 w-52 rounded-full bg-rose-100/60"></div>

                <div class="relative flex min-h-[280px]">

                    <div class="flex flex-1 flex-col justify-between p-7">

                        <div>

                            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-50 text-2xl">
                                🩸
                            </div>

                            <h3 class="mt-5 text-2xl font-black tracking-tight text-[#102A43]">
                                Glycémie
                            </h3>

                            <p class="mt-2 max-w-xs text-sm leading-6 text-slate-500">
                                Enregistrez vos mesures et visualisez leur évolution
                                dans le temps.
