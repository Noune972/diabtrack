<script>
document.addEventListener('DOMContentLoaded', () => {

    const button = document.getElementById('environment-location-button');
    const empty = document.getElementById('environment-empty');
    const loading = document.getElementById('environment-loading');
    const error = document.getElementById('environment-error');
    const errorMessage = document.getElementById('environment-error-message');
    const content = document.getElementById('environment-content');

    if (!button) {
        return;
    }

    const setText = (id, value) => {
        const element = document.getElementById(id);

        if (element) {
            element.textContent = value ?? '—';
        }
    };


    // =========================================================
    // MÉTÉO
    // =========================================================

   const getWeather = (code) => {

    // ☀️ GRAND SOLEIL
    if (code === 0) {
        return {
            label: 'Grand soleil',
            icon: '☀️',
            greeting: 'Le soleil est de sortie ! ☀️',
            message: 'Une belle journée pour profiter de l’extérieur.',
            mood: 'sunny'
        };
    }

    // 🌤️ QUELQUES NUAGES
    if ([1, 2].includes(code)) {
        return {
            label: 'Éclaircies',
            icon: '🌤️',
            greeting: 'Soleil et petits nuages 🌤️',
            message: 'Une météo agréable pour prendre l’air.',
            mood: 'cloudy'
        };
    }

    // ☁️ COUVERT
    if (code === 3) {
        return {
            label: 'Ciel couvert',
            icon: '☁️',
            greeting: 'Les nuages sont de sortie ☁️',
            message: 'Pas besoin de grand soleil pour bouger !',
            mood: 'cloudy'
        };
    }

    // 🌫️ BROUILLARD
    if ([45, 48].includes(code)) {
        return {
            label: 'Brouillard',
            icon: '🌫️',
            greeting: 'Ambiance brumeuse ce matin 🌫️',
            message: 'Prenez votre temps si vous sortez.',
            mood: 'fog'
        };
    }

    // 🌦️ BRUINE
    if ([51, 53, 55, 56, 57].includes(code)) {
        return {
            label: 'Bruine',
            icon: '🌦️',
            greeting: 'Quelques gouttes aujourd’hui 🌦️',
            message: 'Un peu de pluie, mais la journée continue !',
            mood: 'rain'
        };
    }

    // 🌧️ PLUIE
    if ([61, 63, 65, 66, 67, 80, 81, 82].includes(code)) {
        return {
            label: 'Pluie',
            icon: '🌧️',
            greeting: 'La pluie s’invite aujourd’hui 🌧️',
            message: 'Parfait pour trouver une activité sympa en intérieur.',
            mood: 'rain'
        };
    }

    // ❄️ NEIGE
    if ([71, 73, 75, 77, 85, 86].includes(code)) {
        return {
            label: 'Neige',
            icon: '❄️',
            greeting: 'Ça se rafraîchit ! ❄️',
            message: 'Une journée hivernale : restez actif tout en restant prudent.',
            mood: 'snow'
        };
    }

    // ⛈️ ORAGE
    if ([95, 96, 99].includes(code)) {
        return {
            label: 'Orage',
            icon: '⛈️',
            greeting: 'Orage dehors, énergie dedans ! ⛈️',
            message: 'Aujourd’hui, on privilégie une activité à l’intérieur.',
            mood: 'storm'
        };
    }

    return {
        label: 'Conditions variables',
        icon: '🌈',
        greeting: 'Une nouvelle journée commence ! 🌈',
        message: 'Voyons ce que la météo nous réserve.',
        mood: 'default'
    };
};

    // =========================================================
    // UV
    // =========================================================

    const getUvLabel = (uv) => {

        if (uv === null || uv === undefined) {
            return 'Donnée indisponible';
        }

        if (uv < 3) {
            return 'Faible';
        }

        if (uv < 6) {
            return 'Modéré';
        }

        if (uv < 8) {
            return 'Élevé';
        }

        if (uv < 11) {
            return 'Très élevé';
        }

        return 'Extrême';
    };


    // =========================================================
    // QUALITÉ DE L'AIR
    // =========================================================

    const getAqiLabel = (aqi) => {

        if (aqi === null || aqi === undefined) {
            return 'Donnée indisponible';
        }

        if (aqi <= 20) {
            return 'Bonne';
        }

        if (aqi <= 40) {
            return 'Correcte';
        }

        if (aqi <= 60) {
            return 'Moyenne';
        }

        if (aqi <= 80) {
            return 'Dégradée';
        }

        if (aqi <= 100) {
            return 'Mauvaise';
        }

        return 'Très mauvaise';
    };


    // =========================================================
    // SUGGESTION SPORTIVE
    // =========================================================

    const getSportSuggestion = (weather, airQuality) => {

        const temperature = weather?.temperature ?? null;
        const uv = weather?.uvIndex ?? null;
        const wind = weather?.windSpeed ?? null;
        const weatherCode = weather?.weatherCode ?? null;
        const aqi = airQuality?.europeanAqi ?? null;

        const pollen = airQuality?.pollen ?? {};

        const maxPollen = Math.max(
            pollen.alder ?? 0,
            pollen.birch ?? 0,
            pollen.grass ?? 0,
            pollen.mugwort ?? 0,
            pollen.ragweed ?? 0
        );


        // ORAGE
        if ([95, 96, 99].includes(weatherCode)) {
            return {
                icon: '🏠',
                title: 'Activité en intérieur',
                description:
                    'Des orages sont présents. Une séance en intérieur est plus adaptée aux conditions extérieures.'
            };
        }


        // FORTE CHALEUR
        if (temperature !== null && temperature >= 30) {
            return {
                icon: '🧘',
                title: 'Activité douce ou en intérieur',
                description:
                    'La température est élevée. Privilégiez une activité modérée dans un endroit frais ou aux heures les moins chaudes.'
            };
        }


        // QUALITÉ DE L'AIR
        if (aqi !== null && aqi > 80) {
            return {
                icon: '🏠',
                title: 'Sport en intérieur',
                description:
                    'La qualité de l’air est actuellement dégradée. Une activité physique en intérieur peut être préférable.'
            };
        }


        // PLUIE
        if (
            weatherCode !== null &&
            [51, 53, 55, 56, 57, 61, 63, 65, 66, 67, 80, 81, 82].includes(weatherCode)
        ) {
            return {
                icon: '🏋️',
                title: 'Renforcement ou activité en intérieur',
                description:
                    'Le temps est pluvieux. C’est une bonne occasion de privilégier une séance en intérieur.'
            };
        }


        // NEIGE
        if (
            weatherCode !== null &&
            [71, 73, 75, 77, 85, 86].includes(weatherCode)
        ) {
            return {
                icon: '🏠',
                title: 'Activité en intérieur',
                description:
                    'Les conditions neigeuses peuvent rendre les déplacements plus difficiles. Une activité intérieure est plus adaptée.'
            };
        }


        // VENT
        if (wind !== null && wind >= 40) {
            return {
                icon: '🚶',
                title: 'Marche légère ou activité en intérieur',
                description:
                    'Le vent est assez fort. Évitez les activités extérieures où les rafales pourraient être gênantes.'
            };
        }


        // UV
        if (uv !== null && uv >= 8) {
            return {
                icon: '🏊',
                title: 'Activité à l’abri du soleil',
                description:
                    'L’indice UV est élevé. Privilégiez une activité à l’ombre, en intérieur ou aux heures où le soleil est moins intense.'
            };
        }


        // POLLENS
        if (maxPollen >= 50) {
            return {
                icon: '🏠',
                title: 'Activité intérieure',
                description:
                    'Les concentrations de certains pollens sont importantes. Si vous y êtes sensible, une activité en intérieur peut être plus confortable.'
            };
        }


        // FROID
        if (temperature !== null && temperature < 5) {
            return {
                icon: '🚶',
                title: 'Marche dynamique',
                description:
                    'Il fait froid. Une marche dynamique ou une activité intérieure permet de rester actif tout en limitant une exposition prolongée.'
            };
        }


        // CONDITIONS IDÉALES
        if (
            temperature !== null &&
            temperature >= 12 &&
            temperature <= 25 &&
            (aqi === null || aqi <= 40)
        ) {
            return {
                icon: '🏃',
                title: 'Marche, vélo ou footing léger',
                description:
                    'Les conditions extérieures sont favorables. Une activité d’endurance modérée en extérieur peut être agréable aujourd’hui.'
            };
        }


        // CAS GÉNÉRAL
        return {
            icon: '🚶',
            title: 'Marche ou activité modérée',
            description:
                'Les conditions permettent une activité modérée. Adaptez la durée et l’intensité à votre forme du moment.'
        };
    };


    // =========================================================
    // AFFICHAGE
    // =========================================================

    const displayEnvironment = (data) => {

        const weather = data.weather ?? {};
        const airQuality = data.airQuality ?? {};
        const pollen = airQuality.pollen ?? {};

        const weatherInfo = getWeather(weather.weatherCode);

        // =========================================================
        // 🎨 AMBIANCE VISUELLE SELON LA MÉTÉO
        // =========================================================
        const weatherCard = document.getElementById('environment-weather-card');
        const weatherCheer = document.getElementById('environment-weather-cheer');

        if (weatherCard && weatherCheer) {
            weatherCard.classList.remove(
                'bg-gradient-to-br', 'from-amber-50', 'via-yellow-50', 'to-white',
                'from-sky-50', 'via-cyan-50', 'from-slate-100', 'via-slate-50',
                'from-blue-50', 'via-sky-50', 'from-indigo-100', 'via-slate-100'
            );

            weatherCheer.className = 'mt-4 rounded-2xl p-4 transition-all duration-500';

            switch (weatherInfo.mood) {
                case 'sunny':
                    weatherCard.classList.add('bg-gradient-to-br', 'from-amber-50', 'via-yellow-50', 'to-white');
                    weatherCheer.classList.add('bg-amber-100/70');
                    break;
                case 'cloudy':
                    weatherCard.classList.add('bg-gradient-to-br', 'from-sky-50', 'via-slate-50', 'to-white');
                    weatherCheer.classList.add('bg-sky-100/70');
                    break;
                case 'rain':
                    weatherCard.classList.add('bg-gradient-to-br', 'from-blue-50', 'via-sky-50', 'to-white');
                    weatherCheer.classList.add('bg-blue-100/70');
                    break;
                case 'snow':
                    weatherCard.classList.add('bg-gradient-to-br', 'from-cyan-50', 'via-sky-50', 'to-white');
                    weatherCheer.classList.add('bg-cyan-100/70');
                    break;
                case 'storm':
                    weatherCard.classList.add('bg-gradient-to-br', 'from-indigo-100', 'via-slate-100', 'to-white');
                    weatherCheer.classList.add('bg-indigo-100');
                    break;
                case 'fog':
                    weatherCard.classList.add('bg-gradient-to-br', 'from-slate-100', 'via-slate-50', 'to-white');
                    weatherCheer.classList.add('bg-slate-200/70');
                    break;
                default:
                    weatherCard.classList.add('bg-gradient-to-br', 'from-sky-50', 'via-cyan-50', 'to-white');
                    weatherCheer.classList.add('bg-cyan-100/60');
            }
        }



        // MÉTÉO

        setText(
            'environment-temperature',
            weather.temperature ?? '—'
        );

        setText(
            'environment-weather-icon',
            weatherInfo.icon
        );

        setText(
            'environment-weather-description',
            weatherInfo.label
        );

        setText(
    'environment-weather-greeting',
    weatherInfo.greeting
);

setText(
    'environment-weather-message',
    weatherInfo.message
);

        setText(
            'environment-apparent-temperature',
            weather.apparentTemperature !== null &&
            weather.apparentTemperature !== undefined
                ? `${weather.apparentTemperature} °C`
                : '—'
        );

        setText(
            'environment-min-max',
            weather.temperatureMin !== null &&
            weather.temperatureMin !== undefined &&
            weather.temperatureMax !== null &&
            weather.temperatureMax !== undefined
                ? `${weather.temperatureMin} °C / ${weather.temperatureMax} °C`
                : '—'
        );

        setText(
            'environment-wind',
            weather.windSpeed !== null &&
            weather.windSpeed !== undefined
                ? `${weather.windSpeed} km/h`
                : '—'
        );


        // UV

        setText(
            'environment-uv',
            weather.uvIndex ?? '—'
        );

        setText(
            'environment-uv-label',
            getUvLabel(weather.uvIndex)
        );


        // AIR

        setText(
            'environment-aqi',
            airQuality.europeanAqi ?? '—'
        );

        setText(
            'environment-aqi-label',
            getAqiLabel(airQuality.europeanAqi)
        );

        setText(
            'environment-pm25',
            airQuality.pm25 !== null &&
            airQuality.pm25 !== undefined
                ? `${airQuality.pm25} µg/m³`
                : '—'
        );

        setText(
            'environment-pm10',
            airQuality.pm10 !== null &&
            airQuality.pm10 !== undefined
                ? `${airQuality.pm10} µg/m³`
                : '—'
        );


        // POLLENS

        setText(
            'pollen-grass',
            pollen.grass ?? '—'
        );

        setText(
            'pollen-birch',
            pollen.birch ?? '—'
        );

        setText(
            'pollen-alder',
            pollen.alder ?? '—'
        );

        setText(
            'pollen-mugwort',
            pollen.mugwort ?? '—'
        );

        setText(
            'pollen-ragweed',
            pollen.ragweed ?? '—'
        );


        // SPORT

        const sport = getSportSuggestion(
            weather,
            airQuality
        );

        setText(
            'environment-sport-icon',
            sport.icon
        );

        setText(
            'environment-sport-title',
            sport.title
        );

        setText(
            'environment-sport-description',
            sport.description
        );


        loading.classList.add('hidden');
        error.classList.add('hidden');
        empty.classList.add('hidden');
        content.classList.remove('hidden');
    };


    // =========================================================
    // API + LOCALISATION
    // =========================================================

    const locationLabel = document.getElementById('environment-location-label');

    const setLocationLabel = (data, fallbackText = 'Position actuelle') => {
        if (!locationLabel) {
            return;
        }

        const location = data?.location ?? {};
        const parts = [
            location.name,
            location.admin1,
        ].filter(Boolean);

        locationLabel.textContent = parts.length
            ? `📍 ${parts.join(' · ')}`
            : `📍 ${fallbackText}`;
    };

    const setLoadingState = () => {
        empty.classList.add('hidden');
        error.classList.add('hidden');
        content.classList.add('hidden');
        loading.classList.remove('hidden');
    };

    const loadEnvironment = async (latitude = null, longitude = null) => {
        setLoadingState();

        try {
            const url = new URL(
                '{{ path('app_environment') }}',
                window.location.origin
            );

            // Sans coordonnées, le contrôleur utilise la ville du profil.
            if (latitude !== null && longitude !== null) {
                url.searchParams.set('latitude', latitude);
                url.searchParams.set('longitude', longitude);
            }

            const response = await fetch(url.toString(), {
                headers: {
                    'Accept': 'application/json'
                }
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                throw new Error(
                    result.message ??
                    'Impossible de récupérer les données environnementales.'
                );
            }

            displayEnvironment(result.data);

            if (result.data.source === 'profile') {
                setLocationLabel(result.data, 'Ville du profil');

                if (result.data.location?.name) {
                    button.innerHTML =
                        `📍 ${result.data.location.name} · Utiliser ma position actuelle`;
                }
            } else {
                setLocationLabel(result.data, 'Position actuelle');
                button.innerHTML = '📍 Utiliser ma position actuelle';
            }

            return true;
        } catch (exception) {
            loading.classList.add('hidden');
            content.classList.add('hidden');
            error.classList.remove('hidden');

            errorMessage.textContent =
                exception.message ??
                'Les données environnementales sont momentanément indisponibles.';

            return false;
        }
    };

    const loadProfileFallback = async () => {
        if (locationLabel) {
            locationLabel.textContent = '🏡 Localisation du profil';
        }

        await loadEnvironment();
    };

    const loadCurrentPosition = ({ fallbackToProfile = false } = {}) => {
        if (!navigator.geolocation) {
            if (fallbackToProfile) {
                loadProfileFallback();
                return;
            }

            loading.classList.add('hidden');
            error.classList.remove('hidden');
            errorMessage.textContent =
                'Votre navigateur ne prend pas en charge la géolocalisation.';
            return;
        }

        setLoadingState();

        if (locationLabel) {
            locationLabel.textContent = '📍 Recherche de votre position actuelle...';
        }

        navigator.geolocation.getCurrentPosition(
            async (position) => {
                const loaded = await loadEnvironment(
                    position.coords.latitude,
                    position.coords.longitude
                );

                // Si l'API GPS échoue au chargement, on conserve un fallback profil.
                if (!loaded && fallbackToProfile) {
                    await loadProfileFallback();
                }
            },
            async (geolocationError) => {
                if (fallbackToProfile) {
                    await loadProfileFallback();
                    return;
                }

                loading.classList.add('hidden');
                content.classList.add('hidden');
                error.classList.remove('hidden');

                if (geolocationError.code === 1) {
                    errorMessage.textContent =
                        'Vous avez refusé l’accès à votre position. La météo de votre profil reste disponible en rechargeant la page.';
                } else if (geolocationError.code === 2) {
                    errorMessage.textContent =
                        'Votre position actuelle est indisponible.';
                } else if (geolocationError.code === 3) {
                    errorMessage.textContent =
                        'La récupération de votre position a pris trop de temps.';
                } else {
                    errorMessage.textContent =
                        'Impossible de récupérer votre position actuelle.';
                }
            },
            {
                enableHighAccuracy: false,
                timeout: 10000,
                maximumAge: 60000
            }
        );
    };

    // Au chargement : priorité à la position GPS réelle.
    // Si elle est refusée ou indisponible : ville enregistrée dans le profil.
    loadCurrentPosition({ fallbackToProfile: true });

    // Clic manuel : nouvelle demande de position GPS actuelle.
    button.addEventListener('click', () => {
        loadCurrentPosition({ fallbackToProfile: false });
    });

});
</script>

{% endblock %}
