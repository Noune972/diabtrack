{% extends 'base.html.twig' %}

{% block title %}Administration - DiabTrack{% endblock %}

{% block body %}

<div class="min-h-screen bg-gray-50 px-6 py-8 lg:px-10">


{# =========================================================
   EN-TÊTE
   ========================================================= #}

<div class="mb-8 flex flex-col gap-5 md:flex-row md:items-center md:justify-between">

    <div>
        <p class="text-sm font-bold uppercase tracking-widest text-[#48742C]">
            DiabTrack
        </p>

        <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-gray-900 lg:text-4xl">
            Administration
        </h1>

        <p class="mt-2 text-base text-gray-500">
            Vue globale de l'activité de votre application.
        </p>
    </div>

    <div class="rounded-2xl bg-white px-5 py-3 shadow-sm ring-1 ring-gray-100">
        <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">
            Espace sécurisé
        </p>

        <p class="mt-1 text-sm font-bold text-[#48742C]">
            Administrateur
        </p>
    </div>

</div>


{# =========================================================
   MESSAGE DE SUCCÈS
   ========================================================= #}

{% for message in app.flashes('success') %}

    <div class="mb-6 flex items-center gap-3 rounded-2xl border border-green-200 bg-green-50 px-5 py-4 text-sm font-semibold text-green-700">

        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-green-100">
            ✓
        </span>

        {{ message }}

    </div>

{% endfor %}


{# =========================================================
   STATISTIQUES PRINCIPALES
   ========================================================= #}

<div class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">

    {# UTILISATEURS #}

    <a href="{{ path('app_admin_user') }}"
       class="group rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100 transition duration-200 hover:-translate-y-1 hover:shadow-lg">

        <div class="flex items-center justify-between">

            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-green-100 text-2xl">
                👥
            </div>

            <span class="text-sm font-bold text-[#48742C] group-hover:underline">
                Gérer →
            </span>

        </div>

        <p class="mt-5 text-sm font-semibold text-gray-500">
            Utilisateurs
        </p>

        <p class="mt-1 text-4xl font-extrabold text-gray-900">
            {{ numberOfUsers|default(0) }}
        </p>

        <p class="mt-2 text-sm text-gray-400">
            Comptes enregistrés
        </p>

        <div class="mt-4 flex items-center gap-2 text-xs font-bold text-[#48742C]">
            <span class="h-2 w-2 rounded-full bg-green-500"></span>
            Gestion des utilisateurs
        </div>

    </a>


    {# SUIVIS PATIENTS #}

    <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100">

        <div class="flex items-center justify-between">

            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-100 text-2xl">
                📈
            </div>

            <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-600">
                Suivi
            </span>

        </div>

        <p class="mt-5 text-sm font-semibold text-gray-500">
            Patients actifs
        </p>

        <p class="mt-1 text-4xl font-extrabold text-gray-900">
            {{ numberOfActiveUsers|default(numberOfUsers|default(0)) }}
        </p>

        <p class="mt-2 text-sm text-gray-400">
            Utilisateurs actuellement actifs
        </p>

    </div>


    {# ARTICLES #}

    <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100">

        <div class="flex items-center justify-between">

            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-100 text-2xl">
                📝
            </div>

            <span class="rounded-full bg-orange-50 px-3 py-1 text-xs font-bold text-orange-600">
                Blog
            </span>

        </div>

        <p class="mt-5 text-sm font-semibold text-gray-500">
            Articles
        </p>

        <p class="mt-1 text-4xl font-extrabold text-gray-900">
            {{ numberOfArticles|default(0) }}
        </p>

        <p class="mt-2 text-sm text-gray-400">
            Articles disponibles
        </p>

    </div>


    {# COMMENTAIRES #}

    <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100">

        <div class="flex items-center justify-between">

            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-purple-100 text-2xl">
                💬
            </div>

            <span class="rounded-full bg-purple-50 px-3 py-1 text-xs font-bold text-purple-600">
                Modération
            </span>

        </div>

        <p class="mt-5 text-sm font-semibold text-gray-500">
            Commentaires
        </p>

        <p class="mt-1 text-4xl font-extrabold text-gray-900">
            {{ numberOfComments|default(0) }}
        </p>

        <p class="mt-2 text-sm text-gray-400">
            Commentaires enregistrés
        </p>

    </div>

</div>


{# =========================================================
   SUIVI DES DONNÉES DE SANTÉ
   ========================================================= #}

<div class="mb-8">

    <div class="mb-5">

        <p class="text-sm font-bold uppercase tracking-widest text-[#48742C]">
            Suivi santé
        </p>

        <h2 class="mt-1 text-2xl font-extrabold text-gray-900">
            Indicateurs de l'application
        </h2>

        <p class="mt-1 text-sm text-gray-500">
            Données présentées sous forme d'indicateurs globaux.
        </p>

    </div>


    {# Passage de 4 à 5 indicateurs #}

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-5">


        {# GLYCÉMIES #}

        <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100">

            <div class="flex items-center gap-3">

                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-green-100 text-xl">
                    🩸
                </div>

                <div>
                    <p class="text-sm font-bold text-gray-900">
                        Glycémies
                    </p>

                    <p class="text-xs text-gray-400">
                        Mesures enregistrées
                    </p>
                </div>

            </div>

            <p class="mt-5 text-3xl font-extrabold text-gray-900">
                {{ numberOfBloodSugars|default(0) }}
            </p>

        </div>


        {# HbA1C #}

        <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100">

            <div class="flex items-center gap-3">

                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-100 text-xl">
                    🧪
                </div>

                <div>
                    <p class="text-sm font-bold text-gray-900">
                        HbA1c
                    </p>

                    <p class="text-xs text-gray-400">
                        Mesures renseignées
                    </p>
                </div>

            </div>

            <p class="mt-5 text-3xl font-extrabold text-gray-900">
                {{ numberOfHba1c|default(0) }}
            </p>

        </div>


        {# POIDS #}

        <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100">

            <div class="flex items-center gap-3">

                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-100 text-xl">
                    ⚖️
                </div>

                <div>
                    <p class="text-sm font-bold text-gray-900">
                        Poids
                    </p>

                    <p class="text-xs text-gray-400">
                        Suivis renseignés
                    </p>
                </div>

            </div>

            <p class="mt-5 text-3xl font-extrabold text-gray-900">
                {{ numberOfWeights|default(0) }}
            </p>

        </div>


        {# ACTIVITÉ PHYSIQUE #}

        <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100">

            <div class="flex items-center gap-3">

                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-purple-100 text-xl">
                    🏃
                </div>

                <div>
                    <p class="text-sm font-bold text-gray-900">
                        Activité physique
                    </p>

                    <p class="text-xs text-gray-400">
                        Activités enregistrées
                    </p>
                </div>

            </div>

            <p class="mt-5 text-3xl font-extrabold text-gray-900">
                {{ numberOfActivities|default(0) }}
            </p>

        </div>


        {# =====================================================
           INSULINE — AJOUT
           ===================================================== #}

        <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100">

            <div class="flex items-center gap-3">

                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-pink-100 text-xl">
                    💉
                </div>

                <div>
                    <p class="text-sm font-bold text-gray-900">
                        Insuline
                    </p>

                    <p class="text-xs text-gray-400">
                        Injections enregistrées
                    </p>
                </div>

            </div>

            <p class="mt-5 text-3xl font-extrabold text-gray-900">
                {{ numberOfInsulines|default(0) }}
            </p>

        </div>

    </div>

</div>


{# =========================================================
   GRAPHIQUE
   ========================================================= #}

<div class="mb-8 grid grid-cols-1 gap-6 xl:grid-cols-3">


    {# GRAPHIQUE ACTIVITÉ #}

    <div class="xl:col-span-2 rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100">

        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">

            <div>

                <p class="text-sm font-bold uppercase tracking-wide text-[#48742C]">
                    Activité
                </p>

                <h2 class="mt-1 text-xl font-extrabold text-gray-900">
                    Activité de l'application
                </h2>

            </div>

            <span class="rounded-full bg-gray-50 px-3 py-1 text-xs font-semibold text-gray-500">
                7 derniers jours
            </span>

        </div>


        <div class="mt-8 flex h-64 items-end justify-between gap-3 border-b border-gray-100 px-2">

            <div class="flex h-full flex-1 flex-col justify-end">
                <div class="mx-auto w-full max-w-[45px] rounded-t-xl bg-[#48742C]/20" style="height: 35%;"></div>
            </div>

            <div class="flex h-full flex-1 flex-col justify-end">
                <div class="mx-auto w-full max-w-[45px] rounded-t-xl bg-[#48742C]/30" style="height: 55%;"></div>
            </div>

            <div class="flex h-full flex-1 flex-col justify-end">
                <div class="mx-auto w-full max-w-[45px] rounded-t-xl bg-[#48742C]/40" style="height: 42%;"></div>
            </div>

            <div class="flex h-full flex-1 flex-col justify-end">
                <div class="mx-auto w-full max-w-[45px] rounded-t-xl bg-[#48742C]/50" style="height: 72%;"></div>
            </div>

            <div class="flex h-full flex-1 flex-col justify-end">
                <div class="mx-auto w-full max-w-[45px] rounded-t-xl bg-[#48742C]/60" style="height: 62%;"></div>
            </div>

            <div class="flex h-full flex-1 flex-col justify-end">
                <div class="mx-auto w-full max-w-[45px] rounded-t-xl bg-[#48742C]/70" style="height: 84%;"></div>
            </div>

            <div class="flex h-full flex-1 flex-col justify-end">
                <div class="mx-auto w-full max-w-[45px] rounded-t-xl bg-[#48742C]" style="height: 70%;"></div>
            </div>

        </div>


        <div class="mt-3 grid grid-cols-7 text-center text-xs font-semibold text-gray-400">

            <span>Lun</span>
            <span>Mar</span>
            <span>Mer</span>
            <span>Jeu</span>
            <span>Ven</span>
            <span>Sam</span>
            <span>Dim</span>

        </div>

    </div>


    {# RÉPARTITION #}

    <div class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-gray-100">

        <p class="text-sm font-bold uppercase tracking-wide text-[#48742C]">
            Vue globale
        </p>

        <h2 class="mt-1 text-xl font-extrabold text-gray-900">
            Activité patients
        </h2>


        <div class="mt-8 space-y-6">


            <div>

                <div class="mb-2 flex justify-between text-sm">

                    <span class="font-semibold text-gray-600">
                        Suivi glycémique
                    </span>

                    <span class="font-bold text-[#48742C]">
                        {{ numberOfBloodSugars|default(0) }}
                    </span>

                </div>

                <div class="h-3 overflow-hidden rounded-full bg-gray-100">

                    <div class="h-full rounded-full bg-[#48742C]"
                         style="width: 78%;">
                    </div>

                </div>

            </div>


            <div>

                <div class="mb-2 flex justify-between text-sm">

                    <span class="font-semibold text-gray-600">
                        Activité physique
                    </span>

                    <span class="font-bold text-[#48742C]">
                        {{ numberOfActivities|default(0) }}
                    </span>

                </div>

                <div class="h-3 overflow-hidden rounded-full bg-gray-100">

                    <div class="h-full rounded-full bg-[#48742C]/70"
                         style="width: 61%;">
                    </div>

                </div>

            </div>


            <div>

                <div class="mb-2 flex justify-between text-sm">

                    <span class="font-semibold text-gray-600">
                        Suivi HbA1c
                    </span>

                    <span class="font-bold text-[#48742C]">
                        {{ numberOfHba1c|default(0) }}
                    </span>

                </div>

                <div class="h-3 overflow-hidden rounded-full bg-gray-100">

                    <div class="h-full rounded-full bg-[#48742C]/50"
                         style="width: 44%;">
                    </div>

                </div>

            </div>


            {# INSULINE AJOUTÉE À LA RÉPARTITION #}

            <div>

                <div class="mb-2 flex justify-between text-sm">

                    <span class="font-semibold text-gray-600">
                        Suivi insuline
                    </span>

                    <span class="font-bold text-[#48742C]">
                        {{ numberOfInsulines|default(0) }}
                    </span>

                </div>

                <div class="h-3 overflow-hidden rounded-full bg-gray-100">

                    <div class="h-full rounded-full bg-[#48742C]/40"
                         style="width: 38%;">
                    </div>

                </div>

            </div>


        </div>

    </div>

</div>


{# =========================================================
   COMMENTAIRES
   ========================================================= #}

<div class="mb-8 rounded-3xl bg-white shadow-sm ring-1 ring-gray-100">

    <div class="flex flex-col gap-4 border-b border-gray-100 px-6 py-5 md:flex-row md:items-center md:justify-between">

        <div>

            <p class="text-sm font-bold uppercase tracking-wide text-[#48742C]">
                Modération
            </p>

            <h2 class="mt-1 text-xl font-extrabold text-gray-900">
                Commentaires à vérifier
            </h2>

            <p class="mt-1 text-sm text-gray-500">
                Les commentaires sont soumis à validation avant publication.
            </p>

        </div>

        <span class="rounded-full bg-orange-50 px-4 py-2 text-sm font-bold text-orange-600">
            {{ numberOfPendingComments|default(0) }} en attente
        </span>

    </div>


    <div class="divide-y divide-gray-100">

        {% for comment in pendingComments|default([]) %}

            <div class="px-6 py-5">

                <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">

                    <div class="min-w-0">

                        <div class="flex items-center gap-3">

                            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#48742C]/10 font-bold text-[#48742C]">
                                {{ comment.patient.firstname|first|upper }}
                            </div>

                            <div>

                                <p class="font-bold text-gray-900">
                                    {{ comment.patient.firstname }}
                                </p>

                                <p class="text-xs text-gray-400">
                                    {{ comment.date|date('d/m/Y') }}
                                </p>

                            </div>

                        </div>

                        <p class="mt-3 text-sm leading-6 text-gray-600">
                            {{ comment.content }}
                        </p>

                    </div>


                    <div class="flex shrink-0 gap-2">

                        <form method="post"
                              action="{{ path('admin_comment_approve', {id: comment.id}) }}">

                            <input type="hidden"
                                   name="_token"
                                   value="{{ csrf_token('approve-comment-' ~ comment.id) }}">

                            <button type="submit"
                                    class="rounded-xl bg-green-50 px-4 py-2.5 text-sm font-bold text-green-700 transition hover:bg-green-100">

                                ✓ Autoriser

                            </button>

                        </form>


                        <form method="post"
                              action="{{ path('admin_comment_refuse', {id: comment.id}) }}">

                            <input type="hidden"
                                   name="_token"
                                   value="{{ csrf_token('refuse-comment-' ~ comment.id) }}">

                            <button type="submit"
                                    class="rounded-xl bg-red-50 px-4 py-2.5 text-sm font-bold text-red-600 transition hover:bg-red-100">

                                ✕ Refuser

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        {% else %}

            <div class="px-6 py-12 text-center">

                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-green-50 text-2xl">
                    ✓
                </div>

                <p class="mt-4 font-bold text-gray-900">
                    Aucun commentaire à modérer
                </p>

                <p class="mt-1 text-sm text-gray-500">
                    Tous les commentaires ont été traités.
                </p>

            </div>

        {% endfor %}

    </div>

</div>


{# =========================================================
   RGPD / SÉCURITÉ
   ========================================================= #}

<div class="rounded-3xl bg-[#48742C] p-6 text-white shadow-sm lg:p-8">

    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">

        <div class="max-w-2xl">

            <p class="text-sm font-bold uppercase tracking-widest text-green-100">
                Confidentialité
            </p>

            <h2 class="mt-2 text-2xl font-extrabold">
                Protection des données
            </h2>

            <p class="mt-2 text-sm leading-6 text-green-50">
                Les données de santé sont sensibles. L'administration
                privilégie la minimisation des données et limite
                l'accès aux informations nécessaires à la gestion
                de l'application.
            </p>

        </div>


        <div class="grid grid-cols-2 gap-3 text-sm">

            <div class="rounded-2xl bg-white/10 px-4 py-3">

                <p class="font-bold">
                    ✓
                </p>

                <p class="mt-1 text-green-50">
                    Accès sécurisé
                </p>

            </div>


            <div class="rounded-2xl bg-white/10 px-4 py-3">

                <p class="font-bold">
                    ✓
                </p>

                <p class="mt-1 text-green-50">
                    Données minimisées
                </p>

            </div>


            <div class="rounded-2xl bg-white/10 px-4 py-3">

                <p class="font-bold">
                    ✓
                </p>

                <p class="mt-1 text-green-50">
                    Accès restreint
                </p>

            </div>


            <div class="rounded-2xl bg-white/10 px-4 py-3">

                <p class="font-bold">
                    ✓
                </p>

                <p class="mt-1 text-green-50">
                    Sécurité RGPD
                </p>

            </div>

        </div>

    </div>

</div>


</div>

{% endblock %}
