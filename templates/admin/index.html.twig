{% extends 'base.html.twig' %}

{% block title %}Administration - DiabTrack{% endblock %}

{% block body %}

<div class="min-h-screen bg-[#F4F8FB]">

    {# =========================================================
       HEADER
       ========================================================= #}
    <div class="border-b border-slate-200/80 bg-white">
        <div class="mx-auto flex max-w-[1600px] items-center justify-between gap-6 px-6 py-4 lg:px-10">

            <div>
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-teal-600">
                    DiabTrack
                </p>

                <h1 class="mt-1 text-2xl font-black tracking-tight text-slate-900">
                    Administration
                </h1>
            </div>

            <div class="hidden flex-1 md:block">
                <div class="mx-auto max-w-xl">
                    <div class="flex items-center gap-3 rounded-2xl bg-slate-100 px-4 py-3 text-sm text-slate-400">
                        <span class="text-lg">⌕</span>
                        <span>Rechercher dans l'administration...</span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="hidden text-right sm:block">
                    <p class="text-sm font-bold text-slate-900">
                        Administrateur
                    </p>
                    <p class="text-xs text-slate-400">
                        Espace sécurisé
                    </p>
                </div>

                <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-teal-400 to-cyan-500 font-black text-white shadow-lg shadow-teal-500/20">
                    A
                </div>
            </div>

        </div>
    </div>


    <main class="mx-auto max-w-[1600px] px-6 py-8 lg:px-10">

        {# =========================================================
           HERO
           ========================================================= #}

        <section class="relative mb-7 overflow-hidden rounded-[32px] bg-gradient-to-r from-[#082F49] via-[#075985] to-[#0F766E] p-7 text-white shadow-xl shadow-slate-900/10 lg:p-10">

            <div class="absolute -right-16 -top-24 h-72 w-72 rounded-full bg-cyan-300/20 blur-3xl"></div>
            <div class="absolute bottom-[-100px] right-1/3 h-64 w-64 rounded-full bg-emerald-300/10 blur-3xl"></div>

            <div class="relative z-10 flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">

                <div class="max-w-2xl">
                    <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-bold uppercase tracking-widest text-cyan-100 ring-1 ring-white/10">
                        <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
                        Centre de contrôle
                    </div>

                    <h2 class="text-3xl font-black tracking-tight sm:text-4xl lg:text-5xl">
                        Bonjour 👋
                    </h2>

                    <p class="mt-3 max-w-xl text-sm leading-6 text-cyan-50/80 sm:text-base">
                        Retrouvez les données essentielles de DiabTrack et pilotez
                        simplement les utilisateurs, le suivi santé et la communauté.
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">

                    <div class="rounded-2xl bg-white/10 px-5 py-4 backdrop-blur ring-1 ring-white/10">
                        <p class="text-xs text-cyan-100">Glycémie</p>
                        <p class="mt-1 font-black">Suivi</p>
                    </div>

                    <div class="rounded-2xl bg-white/10 px-5 py-4 backdrop-blur ring-1 ring-white/10">
                        <p class="text-xs text-cyan-100">HbA1c</p>
                        <p class="mt-1 font-black">Analyse</p>
                    </div>

                    <div class="col-span-2 rounded-2xl bg-white/10 px-5 py-4 backdrop-blur ring-1 ring-white/10 sm:col-span-1">
                        <p class="text-xs text-cyan-100">Insuline</p>
                        <p class="mt-1 font-black">Contrôle</p>
                    </div>

                </div>

            </div>
        </section>


        {# FLASH SUCCESS #}

        {% for message in app.flashes('success') %}
            <div class="mb-6 flex items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-bold text-emerald-700">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-100">
                    ✓
                </span>
                {{ message }}
            </div>
        {% endfor %}


        {# =========================================================
           STATISTIQUES
           ========================================================= #}

        <div class="mb-7 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">

            {# UTILISATEURS #}
            <a href="{{ path('app_admin_user') }}"
               class="group relative overflow-hidden rounded-[26px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70 transition duration-300 hover:-translate-y-1 hover:shadow-xl">

                <div class="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-teal-100/70"></div>

                <div class="relative flex items-start justify-between">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-50 text-2xl">
                        👥
                    </div>

                    <span class="rounded-full bg-teal-50 px-3 py-1 text-xs font-bold text-teal-600">
                        Gérer →
                    </span>
                </div>

                <p class="mt-6 text-sm font-semibold text-slate-500">
                    Utilisateurs
                </p>

                <div class="mt-1 flex items-end gap-3">
                    <p class="text-4xl font-black tracking-tight text-slate-900">
                        {{ numberOfUsers|default(0) }}
                    </p>

                    <span class="mb-1 text-xs font-bold text-emerald-600">
                        comptes
                    </span>
                </div>

                <p class="mt-2 text-xs text-slate-400">
                    Utilisateurs enregistrés sur DiabTrack
                </p>

            </a>


            {# PATIENTS #}
            <div class="relative overflow-hidden rounded-[26px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70">

                <div class="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-sky-100/70"></div>

                <div class="relative flex items-start justify-between">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-50 text-2xl">
                        📊
                    </div>

                    <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-bold text-sky-600">
                        Actifs
                    </span>

                </div>

                <p class="mt-6 text-sm font-semibold text-slate-500">
                    Patients actifs
                </p>

                <p class="mt-1 text-4xl font-black tracking-tight text-slate-900">
                    {{ numberOfActiveUsers|default(numberOfUsers|default(0)) }}
                </p>

                <p class="mt-2 text-xs text-slate-400">
                    Utilisateurs actuellement actifs
                </p>

            </div>


            {# ARTICLES #}
            <div class="relative overflow-hidden rounded-[26px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70">

                <div class="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-orange-100/70"></div>

                <div class="relative flex items-start justify-between">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-50 text-2xl">
                        📝
                    </div>

                    <span class="rounded-full bg-orange-50 px-3 py-1 text-xs font-bold text-orange-600">
                        Contenu
                    </span>

                </div>

                <p class="mt-6 text-sm font-semibold text-slate-500">
                    Articles
                </p>

                <p class="mt-1 text-4xl font-black tracking-tight text-slate-900">
                    {{ numberOfArticles|default(0) }}
                </p>

                <p class="mt-2 text-xs text-slate-400">
                    Ressources disponibles
                </p>

            </div>


            {# COMMENTAIRES #}
            <div class="relative overflow-hidden rounded-[26px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70">

                <div class="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-violet-100/70"></div>

                <div class="relative flex items-start justify-between">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-50 text-2xl">
                        💬
                    </div>

                    <span class="rounded-full bg-violet-50 px-3 py-1 text-xs font-bold text-violet-600">
                        Communauté
                    </span>

                </div>

                <p class="mt-6 text-sm font-semibold text-slate-500">
                    Commentaires
                </p>

                <p class="mt-1 text-4xl font-black tracking-tight text-slate-900">
                    {{ numberOfComments|default(0) }}
                </p>

                <p class="mt-2 text-xs text-slate-400">
                    Échanges enregistrés
                </p>

            </div>

        </div>


        {# =========================================================
           SUIVI SANTÉ
           ========================================================= #}

        <div class="mb-7 rounded-[30px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70 lg:p-7">

            <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">

                <div>
                    <p class="text-xs font-black uppercase tracking-[0.2em] text-teal-600">
                        Santé
                    </p>

                    <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-900">
                        Vue d'ensemble des suivis
                    </h2>

                    <p class="mt-1 text-sm text-slate-400">
                        Activité globale enregistrée par les utilisateurs.
                    </p>
                </div>

                <span class="rounded-xl bg-slate-100 px-4 py-2 text-xs font-bold text-slate-500">
                    Données DiabTrack
                </span>

            </div>


            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">

                {# GLYCEMIE #}
                <div class="rounded-2xl bg-gradient-to-br from-teal-50 to-white p-5 ring-1 ring-teal-100">

                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-500 text-xl text-white shadow-md shadow-teal-500/20">
                        🩸
                    </div>

                    <p class="mt-4 text-sm font-bold text-slate-700">
                        Glycémies
                    </p>

                    <p class="mt-1 text-3xl font-black text-slate-900">
                        {{ numberOfBloodSugars|default(0) }}
                    </p>

                    <p class="mt-1 text-xs text-slate-400">
                        mesures
                    </p>

                </div>


                {# HBA1C #}
                <div class="rounded-2xl bg-gradient-to-br from-sky-50 to-white p-5 ring-1 ring-sky-100">

                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-sky-500 text-xl text-white shadow-md shadow-sky-500/20">
                        🧪
                    </div>

                    <p class="mt-4 text-sm font-bold text-slate-700">
                        HbA1c
                    </p>

                    <p class="mt-1 text-3xl font-black text-slate-900">
                        {{ numberOfHba1c|default(0) }}
                    </p>

                    <p class="mt-1 text-xs text-slate-400">
                        analyses
                    </p>

                </div>


                {# INSULINE #}
                <div class="rounded-2xl bg-gradient-to-br from-indigo-50 to-white p-5 ring-1 ring-indigo-100">

                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-500 text-xl text-white shadow-md shadow-indigo-500/20">
                        💉
                    </div>

                    <p class="mt-4 text-sm font-bold text-slate-700">
                        Insuline
                    </p>

                    <p class="mt-1 text-3xl font-black text-slate-900">
                        {{ numberOfInsulines|default(0) }}
                    </p>

                    <p class="mt-1 text-xs text-slate-400">
                        injections
                    </p>

                </div>


                {# ACTIVITE #}
                <div class="rounded-2xl bg-gradient-to-br from-violet-50 to-white p-5 ring-1 ring-violet-100">

                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-500 text-xl text-white shadow-md shadow-violet-500/20">
                        🏃
                    </div>

                    <p class="mt-4 text-sm font-bold text-slate-700">
                        Activité
                    </p>

                    <p class="mt-1 text-3xl font-black text-slate-900">
                        {{ numberOfActivities|default(0) }}
                    </p>

                    <p class="mt-1 text-xs text-slate-400">
                        activités
                    </p>

                </div>


                {# POIDS #}
                <div class="rounded-2xl bg-gradient-to-br from-orange-50 to-white p-5 ring-1 ring-orange-100">

                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-orange-500 text-xl text-white shadow-md shadow-orange-500/20">
                        ⚖️
                    </div>

                    <p class="mt-4 text-sm font-bold text-slate-700">
                        Poids
                    </p>

                    <p class="mt-1 text-3xl font-black text-slate-900">
                        {{ numberOfWeights|default(0) }}
                    </p>

                    <p class="mt-1 text-xs text-slate-400">
                        suivis
                    </p>

                </div>

            </div>

        </div>


        {# =========================================================
           ANALYTIQUE + MODÉRATION
           ========================================================= #}

        <div class="mb-7 grid grid-cols-1 gap-6 xl:grid-cols-5">

            {# ANALYTIQUE #}
            <div class="rounded-[30px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70 xl:col-span-3 lg:p-7">

                <div class="flex items-center justify-between">

                    <div>
                        <p class="text-xs font-black uppercase tracking-[0.2em] text-teal-600">
                            Analytique
                        </p>

                        <h2 class="mt-1 text-xl font-black text-slate-900">
                            Activité de la plateforme
                        </h2>
                    </div>

                    <span class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-bold text-slate-500">
                        Cette semaine
                    </span>

                </div>


                <div class="mt-10 flex h-56 items-end gap-3 border-b border-slate-100">

                    {% set bars = [38, 56, 44, 72, 61, 88, 76] %}

                    {% for height in bars %}

                        <div class="group flex h-full flex-1 items-end">

                            <div
                                class="w-full rounded-t-xl bg-gradient-to-t from-teal-600 to-cyan-400 transition duration-300 group-hover:from-teal-500 group-hover:to-cyan-300"
                                style="height: {{ height }}%;">
                            </div>

                        </div>

                    {% endfor %}

                </div>


                <div class="mt-3 grid grid-cols-7 text-center text-xs font-bold text-slate-400">
                    <span>Lun</span>
                    <span>Mar</span>
                    <span>Mer</span>
                    <span>Jeu</span>
                    <span>Ven</span>
                    <span>Sam</span>
                    <span>Dim</span>
                </div>

            </div>


            {# MODERATION #}
            <div class="rounded-[30px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70 xl:col-span-2 lg:p-7">

                <div class="flex items-center justify-between">

                    <div>
                        <p class="text-xs font-black uppercase tracking-[0.2em] text-violet-600">
                            Communauté
                        </p>

                        <h2 class="mt-1 text-xl font-black text-slate-900">
                            Modération
                        </h2>
                    </div>

                    <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-violet-50 text-xl">
                        💬
                    </div>

                </div>


                <div class="mt-7 rounded-2xl bg-gradient-to-r from-violet-50 to-fuchsia-50 p-5">

                    <p class="text-sm font-semibold text-slate-500">
                        Commentaires en attente
                    </p>

                    <div class="mt-2 flex items-end justify-between">

                        <p class="text-4xl font-black text-slate-900">
                            {{ numberOfPendingComments|default(0) }}
                        </p>

                        <span class="rounded-full bg-white px-3 py-1 text-xs font-bold text-violet-600 shadow-sm">
                            À vérifier
                        </span>

                    </div>

                </div>


                <div class="mt-5 space-y-3">

                    {% for comment in pendingComments|default([])|slice(0, 3) %}

                        <div class="rounded-2xl border border-slate-100 p-4">

                            <div class="flex items-center gap-3">

                                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-teal-50 text-sm font-black text-teal-700">
                                    {{ comment.patient.firstname|first|upper }}
                                </div>

                                <div class="min-w-0 flex-1">

                                    <p class="truncate text-sm font-bold text-slate-800">
                                        {{ comment.patient.firstname }}
                                    </p>

                                    <p class="text-xs text-slate-400">
                                        {{ comment.date|date('d/m/Y') }}
                                    </p>

                                </div>

                            </div>


                            <p class="mt-3 line-clamp-2 text-xs leading-5 text-slate-500">
                                {{ comment.content }}
                            </p>


                            <div class="mt-4 flex gap-2">

                                <form
                                    class="flex-1"
                                    method="post"
                                    action="{{ path('admin_comment_approve', {id: comment.id}) }}">

                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('approve-comment-' ~ comment.id) }}">

                                    <button
                                        type="submit"
                                        class="w-full rounded-xl bg-emerald-50 px-3 py-2 text-xs font-black text-emerald-700 transition hover:bg-emerald-100">
                                        ✓ Autoriser
                                    </button>

                                </form>


                                <form
                                    class="flex-1"
                                    method="post"
                                    action="{{ path('admin_comment_refuse', {id: comment.id}) }}">

                                    <input
                                        type="hidden"
                                        name="_token"
                                        value="{{ csrf_token('refuse-comment-' ~ comment.id) }}">

                                    <button
                                        type="submit"
                                        class="w-full rounded-xl bg-rose-50 px-3 py-2 text-xs font-black text-rose-600 transition hover:bg-rose-100">
                                        ✕ Refuser
                                    </button>

                                </form>

                            </div>

                        </div>

                    {% else %}

                        <div class="rounded-2xl border border-dashed border-emerald-200 bg-emerald-50/50 px-5 py-8 text-center">

                            <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                                ✓
                            </div>

                            <p class="mt-3 text-sm font-black text-slate-800">
                                Tout est à jour
                            </p>

                            <p class="mt-1 text-xs text-slate-400">
                                Aucun commentaire à modérer.
                            </p>

                        </div>

                    {% endfor %}

                </div>

            </div>

        </div>


        {# =========================================================
           ACTIONS RAPIDES
           ========================================================= #}

        <div class="mb-7">

            <div class="mb-4">
                <p class="text-xs font-black uppercase tracking-[0.2em] text-teal-600">
                    Administration
                </p>

                <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-900">
                    Actions rapides
                </h2>
            </div>


            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">

                <a href="{{ path('app_admin_user') }}"
                   class="group flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200/70 transition hover:-translate-y-1 hover:shadow-lg">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-teal-50 text-xl">
                        👥
                    </div>

                    <div class="min-w-0 flex-1">
                        <p class="font-black text-slate-800">
                            Utilisateurs
                        </p>
                        <p class="mt-1 text-xs text-slate-400">
                            Gérer les comptes
                        </p>
                    </div>

                    <span class="font-black text-teal-500 transition group-hover:translate-x-1">
                        →
                    </span>

                </a>


                <div class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200/70">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-50 text-xl">
                        🩸
                    </div>

                    <div>
                        <p class="font-black text-slate-800">
                            Suivis patients
                        </p>
                        <p class="mt-1 text-xs text-slate-400">
                            Consulter les indicateurs
                        </p>
                    </div>

                </div>


                <div class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200/70">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-50 text-xl">
                        📝
                    </div>

                    <div>
                        <p class="font-black text-slate-800">
                            Articles
                        </p>
                        <p class="mt-1 text-xs text-slate-400">
                            Contenu éducatif
                        </p>
                    </div>

                </div>


                <div class="flex items-center gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200/70">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-50 text-xl">
                        💬
                    </div>

                    <div>
                        <p class="font-black text-slate-800">
                            Modération
                        </p>
                        <p class="mt-1 text-xs text-slate-400">
                            Gérer la communauté
                        </p>
                    </div>

                </div>

            </div>

        </div>


        {# =========================================================
           SECURITE
           ========================================================= #}

        <div class="overflow-hidden rounded-[30px] bg-[#0F172A] p-7 text-white shadow-xl lg:p-8">

            <div class="flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between">

                <div class="max-w-2xl">

                    <div class="mb-3 flex items-center gap-2 text-xs font-black uppercase tracking-[0.2em] text-teal-300">
                        <span>🛡️</span>
                        Données de santé
                    </div>

                    <h2 class="text-2xl font-black">
                        Confidentialité et sécurité
                    </h2>

                    <p class="mt-2 text-sm leading-6 text-slate-400">
                        Les informations de santé nécessitent une attention particulière.
                        DiabTrack limite l'accès aux données nécessaires à
                        l'administration de la plateforme.
                    </p>

                </div>


                <div class="grid grid-cols-2 gap-3">

                    <div class="rounded-2xl bg-white/5 px-5 py-4 ring-1 ring-white/10">
                        <span class="text-emerald-400">✓</span>
                        <p class="mt-2 text-xs font-bold text-slate-300">
                            Accès sécurisé
                        </p>
                    </div>

                    <div class="rounded-2xl bg-white/5 px-5 py-4 ring-1 ring-white/10">
                        <span class="text-emerald-400">✓</span>
                        <p class="mt-2 text-xs font-bold text-slate-300">
                            Accès restreint
                        </p>
                    </div>

                    <div class="rounded-2xl bg-white/5 px-5 py-4 ring-1 ring-white/10">
                        <span class="text-emerald-400">✓</span>
                        <p class="mt-2 text-xs font-bold text-slate-300">
                            Données minimisées
                        </p>
                    </div>

                    <div class="rounded-2xl bg-white/5 px-5 py-4 ring-1 ring-white/10">
                        <span class="text-emerald-400">✓</span>
                        <p class="mt-2 text-xs font-bold text-slate-300">
                            RGPD
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </main>

</div>

{% endblock %}
