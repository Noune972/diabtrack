{% extends 'base.html.twig' %}

{% block title %}Ajouter un repas - DiabTrack{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#F5F9FC]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">

        {# ===================== HEADER ===================== #}
        <div class="mb-8">
            <div class="flex items-center gap-2 text-sm font-semibold text-cyan-700 mb-3">
                <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                Nutrition & alimentation
            </div>

            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#102A43]">
                Ajouter un repas
            </h1>

            <p class="mt-2 text-gray-500 max-w-2xl">
                Enregistrez votre repas et les aliments consommés pour faciliter
                le suivi de votre alimentation.
            </p>
        </div>


        {# ===================== FLASH ===================== #}
        {% for message in app.flashes('success') %}
            <div class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-semibold text-emerald-800">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-semibold text-red-700">
                {{ message }}
            </div>
        {% endfor %}


        {# ===================== CONTENU ===================== #}
        <div class="grid lg:grid-cols-[0.85fr_1.4fr] gap-7 items-start">

            {# ===================== VISUEL GAUCHE ===================== #}
            <div class="space-y-5">

                <div class="relative overflow-hidden rounded-3xl bg-[#102A43] shadow-lg">
                    <img
                        src="{{ asset('images/ajout_plat.jpg') }}"
                        alt="Ajouter un repas"
                        class="w-full h-72 lg:h-80 object-cover opacity-80"
                    >

                    <div class="absolute inset-0 bg-gradient-to-t from-[#102A43] via-[#102A43]/30 to-transparent"></div>

                    <div class="absolute bottom-0 left-0 right-0 p-6">
                        <span class="inline-flex items-center rounded-full bg-white/15 backdrop-blur-sm px-3 py-1 text-xs font-bold text-white mb-3">
                            SUIVI NUTRITIONNEL
                        </span>

                        <h2 class="text-2xl font-bold text-white">
                            Votre alimentation au quotidien
                        </h2>

                        <p class="mt-2 text-sm text-blue-100 leading-relaxed">
                            Ajoutez les différents aliments de votre repas et
                            indiquez les quantités réellement consommées.
                        </p>
                    </div>
                </div>


                {# ===================== CONSEIL ===================== #}
                <div class="rounded-2xl border border-cyan-100 bg-cyan-50 p-5">
                    <div class="flex gap-4">

                        <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-white flex items-center justify-center shadow-sm">
                            <svg
                                class="w-5 h-5 text-cyan-700"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                />
                            </svg>
                        </div>

                        <div>
                            <p class="font-bold text-[#102A43]">
                                Calcul au grammage
                            </p>

                            <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                                Indiquez le poids réellement consommé.
                                DiabTrack calcule automatiquement les calories
                                à partir des valeurs pour 100 g.
                            </p>
                        </div>

                    </div>
                </div>

            </div>


            {# ===================== FORMULAIRE ===================== #}
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">

                <div class="px-6 sm:px-8 py-6 border-b border-slate-100">
                    <div class="flex items-center gap-4">

                        <div class="w-11 h-11 rounded-xl bg-[#102A43] flex items-center justify-center">
                            <svg
                                class="w-5 h-5 text-white"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 4v16m8-8H4"
                                />
                            </svg>
                        </div>

                        <div>
                            <h2 class="text-xl font-bold text-[#102A43]">
                                Nouveau repas
                            </h2>

                            <p class="text-sm text-gray-500">
                                Renseignez les informations de votre repas.
                            </p>
                        </div>

                    </div>
                </div>


                {{ form_start(form, {
                    'attr': {
                        'id': 'meal-form',
                        'class': 'p-6 sm:p-8'
                    }
                }) }}

                    {# ===================== NOM ===================== #}
                    <div class="mb-6">

                        {{ form_label(form.dishName, null, {
                            'label_attr': {
                                'class': 'block text-sm font-bold text-[#102A43] mb-2'
                            }
                        }) }}

                        {{ form_widget(form.dishName, {
                            'attr': {
                                'class': 'w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-gray-800 outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100',
                                'placeholder': 'Ex. Déjeuner, dîner, collation...'
                            }
                        }) }}

                        <div class="text-sm text-red-600 mt-1">
                            {{ form_errors(form.dishName) }}
                        </div>

                    </div>


                    {# ===================== DATE / HEURE ===================== #}
                    <div class="grid sm:grid-cols-2 gap-5 mb-8">

                        <div>
                            {{ form_label(form.date, null, {
                                'label_attr': {
                                    'class': 'block text-sm font-bold text-[#102A43] mb-2'
                                }
                            }) }}

                            {{ form_widget(form.date, {
                                'attr': {
                                    'class': 'w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-gray-800 outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="text-sm text-red-600 mt-1">
                                {{ form_errors(form.date) }}
                            </div>
                        </div>


                        <div>
                            {{ form_label(form.hour, null, {
                                'label_attr': {
                                    'class': 'block text-sm font-bold text-[#102A43] mb-2'
                                }
                            }) }}

                            {{ form_widget(form.hour, {
                                'attr': {
                                    'class': 'w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-gray-800 outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="text-sm text-red-600 mt-1">
                                {{ form_errors(form.hour) }}
                            </div>
                        </div>

                    </div>


                    {# ===================== ALIMENTS ===================== #}
                    <div class="border-t border-slate-100 pt-7">

                        <div class="mb-5">
                            <h3 class="text-lg font-bold text-[#102A43]">
                                Aliments de ce repas
                            </h3>

                            <p class="text-sm text-gray-500 mt-1">
                                Sélectionnez un aliment et indiquez la quantité consommée en grammes.
                            </p>
                        </div>


                        {# ===================== OPEN FOOD FACTS ===================== #}
                        <div class="mb-6 overflow-hidden rounded-2xl border border-cyan-200 bg-gradient-to-br from-cyan-50 to-white">

                            <div class="p-5 sm:p-6">
                                <div class="flex flex-col sm:flex-row sm:items-center gap-4">

                                    <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl bg-cyan-100 text-2xl">
                                        🥫
                                    </div>

                                    <div class="flex-1">
                                        <div class="flex flex-wrap items-center gap-2">
                                            <h4 class="font-extrabold text-[#102A43]">
                                                Open Food Facts
                                            </h4>

                                            <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-[11px] font-bold text-emerald-700">
                                                DONNÉES PRODUIT
                                            </span>
                                        </div>

                                        <p class="mt-1 text-sm leading-relaxed text-gray-600">
                                            Recherchez un produit avec son code-barres,
                                            puis indiquez le grammage réellement consommé.
                                        </p>
                                    </div>

                                </div>


                                <div class="mt-5">
                                    <a
                                        href="{{ path('app_meal_open_food_facts') }}"
                                        class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-cyan-700 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-cyan-800 focus:ring-4 focus:ring-cyan-100"
                                    >
                                        <svg
                                            class="w-5 h-5"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M3 5v14M7 5v14M11 5v14M15 5v14M19 5v14M21 5v14"
                                            />
                                        </svg>

                                        Rechercher par code-barres
                                    </a>
                                </div>

                            </div>

                            <div class="border-t border-cyan-100 bg-cyan-50/60 px-5 py-3">
                                <p class="text-xs text-gray-500">
                                    Les valeurs nutritionnelles proviennent d'Open Food Facts.
                                    Vérifiez l'étiquette du produit en cas de doute.
                                </p>
                            </div>

                        </div>


                        {# ===================== AJOUT MANUEL ===================== #}
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">

                            <div>
                                <p class="text-sm font-bold text-[#102A43]">
                                    Aliments sélectionnés
                                </p>

                                <p class="text-xs text-gray-500 mt-1">
                                    Vous pouvez également rechercher un aliment déjà enregistré.
                                </p>
                            </div>

                            <button
                                type="button"
                                id="add-meal-item"
                                class="inline-flex items-center justify-center gap-2 rounded-xl bg-cyan-50 border border-cyan-200 px-4 py-2.5 text-sm font-bold text-cyan-800 transition hover:bg-cyan-100"
                            >
                                <svg
                                    class="w-4 h-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 4v16m8-8H4"
                                    />
                                </svg>

                                Ajouter un aliment
                            </button>

                        </div>


                        <div
                            id="meal-items-list"
                            data-prototype="{{ form_widget(form.mealItems.vars.prototype)|e('html_attr') }}"
                            data-index="{{ form.mealItems|length }}"
                            class="space-y-3 mb-7"
                        >

                            {% for mealItemForm in form.mealItems %}

                                <div class="meal-item-row rounded-2xl border border-slate-200 bg-slate-50 p-4">

                                    <div class="grid sm:grid-cols-[1fr_150px_auto] gap-3 sm:items-end">

                                        <div>
                                            {{ form_label(mealItemForm.alimentReference, null, {
                                                'label_attr': {
                                                    'class': 'block text-xs font-bold text-gray-600 mb-1.5'
                                                }
                                            }) }}

                                            {{ form_widget(mealItemForm.alimentReference, {
                                                'attr': {
                                                    'class': 'w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 outline-none focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                                }
                                            }) }}
                                        </div>


                                        <div>
                                            {{ form_label(mealItemForm.quantity, 'Quantité (g)', {
                                                'label_attr': {
                                                    'class': 'block text-xs font-bold text-gray-600 mb-1.5'
                                                }
                                            }) }}

                                            {{ form_widget(mealItemForm.quantity, {
                                                'attr': {
                                                    'class': 'w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 outline-none focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100',
                                                    'placeholder': 'Ex. 150',
                                                    'min': '0',
                                                    'step': '1'
                                                }
                                            }) }}
                                        </div>


                                        <button
                                            type="button"
                                            class="remove-meal-item flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl border border-red-200 bg-white text-red-600 transition hover:bg-red-50"
                                            title="Supprimer"
                                        >
                                            ✕
                                        </button>

                                    </div>

                                    <p class="mt-3 text-xs text-gray-500">
                                        Les calories seront calculées automatiquement selon la quantité consommée.
                                    </p>

                                </div>

                            {% endfor %}

                        </div>

                    </div>


                    {# ===================== ACTIONS ===================== #}
                    <div class="flex flex-col-reverse sm:flex-row gap-3 pt-2">

                        <a
                            href="{{ path('app_meal_index') }}"
                            class="sm:w-auto flex items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3.5 font-bold text-gray-600 transition hover:bg-slate-50"
                        >
                            Retour
                        </a>

                        <button
                            type="submit"
                            class="flex-1 flex items-center justify-center gap-2 rounded-xl bg-[#102A43] px-6 py-3.5 font-bold text-white shadow-sm transition hover:bg-[#163A5F] focus:ring-4 focus:ring-blue-100"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 13l4 4L19 7"
                                />
                            </svg>

                            Enregistrer le repas
                        </button>

                    </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
</div>


{# ===================== JAVASCRIPT ===================== #}
<script>
    function initMealForm() {
        const list = document.getElementById('meal-items-list');
        const addButton = document.getElementById('add-meal-item');

        if (!list || !addButton) {
            return;
        }

        /*
         * Évite d'enregistrer plusieurs fois les événements
         * avec Turbo.
         */
        if (list.dataset.initialized === 'true') {
            return;
        }

        list.dataset.initialized = 'true';

        addButton.addEventListener('click', function () {
            const index = list.dataset.index;

            const prototype = list.dataset.prototype.replace(
                /__name__/g,
                index
            );

            const wrapper = document.createElement('div');

            wrapper.classList.add(
                'meal-item-row',
                'rounded-2xl',
                'border',
                'border-slate-200',
                'bg-slate-50',
                'p-4'
            );

            wrapper.innerHTML = `
                <div class="flex flex-col sm:flex-row sm:items-end gap-3">
                    <div class="flex-1">
                        ${prototype}
                    </div>

                    <button
                        type="button"
                        class="remove-meal-item flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl border border-red-200 bg-white text-red-600 transition hover:bg-red-50"
                        title="Supprimer"
                    >
                        ✕
                    </button>
                </div>
            `;

            list.appendChild(wrapper);

            list.dataset.index = parseInt(index, 10) + 1;
        });

        list.addEventListener('click', function (event) {
            const removeButton = event.target.closest(
                '.remove-meal-item'
            );

            if (removeButton) {
                removeButton
                    .closest('.meal-item-row')
                    ?.remove();
            }
        });
    }

    document.addEventListener(
        'DOMContentLoaded',
        initMealForm
    );

    document.addEventListener(
        'turbo:load',
        initMealForm
    );
</script>
{% endblock %}