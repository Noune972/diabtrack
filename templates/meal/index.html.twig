{% extends 'base.html.twig' %}

{% block title %}Mes repas - DiabTrack{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#F5F9FC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">

        {# ================= HEADER ================= #}
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-8">

            <div>
                <div class="flex items-center gap-2 text-sm font-semibold text-cyan-700 mb-3">
                    <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                    Nutrition & alimentation
                </div>

                <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#102A43]">
                    Mes repas
                </h1>

                <p class="mt-2 text-gray-500 max-w-2xl">
                    Retrouvez l'historique de vos repas et consultez
                    facilement leurs informations nutritionnelles.
                </p>
            </div>

            <a
                href="{{ path('app_meal_new') }}"
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#102A43] px-5 py-3 font-bold text-white shadow-sm transition hover:bg-[#163A5F]"
            >
                <svg class="w-5 h-5"
                     fill="none"
                     stroke="currentColor"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M12 4v16m8-8H4"/>
                </svg>

                Ajouter un repas
            </a>
        </div>


        {# ================= STATISTIQUES ================= #}
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-7">

            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-semibold text-gray-500">
                            Repas enregistrés
                        </p>

                        <p class="mt-1 text-3xl font-extrabold text-[#102A43]">
                            {{ meals|length }}
                        </p>
                    </div>

                    <div class="w-12 h-12 rounded-xl bg-cyan-50 flex items-center justify-center">
                        <svg class="w-6 h-6 text-cyan-700"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M3 3h18v18H3V3zm4 4h10M7 12h10M7 17h6"/>
                        </svg>
                    </div>
                </div>
            </div>


            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm font-semibold text-gray-500">
                            Suivi nutritionnel
                        </p>

                        <p class="mt-1 text-lg font-extrabold text-[#102A43]">
                            Historique
                        </p>
                    </div>

                    <div class="w-12 h-12 rounded-xl bg-blue-50 flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-700"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M9 17v-6m4 6V7m4 10v-3M5 21h14"/>
                        </svg>
                    </div>
                </div>
            </div>


            <div class="sm:col-span-2 lg:col-span-1 bg-gradient-to-br from-[#102A43] to-[#163A5F] rounded-2xl p-5 shadow-sm">
                <p class="text-sm font-semibold text-cyan-200">
                    DiabTrack
                </p>

                <p class="mt-1 text-lg font-bold text-white">
                    Suivez vos habitudes alimentaires
                </p>

                <p class="mt-2 text-sm text-blue-100">
                    Consultez vos repas et leurs calories en un coup d'œil.
                </p>
            </div>

        </div>


        {# ================= TABLEAU ================= #}
        <div class="bg-white border border-slate-200 rounded-3xl shadow-sm overflow-hidden">

            <div class="px-6 py-5 border-b border-slate-100">
                <div class="flex items-center gap-3">

                    <div class="w-10 h-10 rounded-xl bg-cyan-50 flex items-center justify-center">
                        <svg class="w-5 h-5 text-cyan-700"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </div>

                    <div>
                        <h2 class="font-bold text-[#102A43]">
                            Historique des repas
                        </h2>

                        <p class="text-sm text-gray-500">
                            Tous vos repas enregistrés.
                        </p>
                    </div>

                </div>
            </div>


            {% if meals|length > 0 %}

                {# ============== VERSION DESKTOP ============== #}
                <div class="hidden md:block overflow-x-auto">

                    <table class="w-full">

                        <thead class="bg-slate-50 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                    ID
                                </th>

                                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Repas
                                </th>

                                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Calories
                                </th>

                                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Date
                                </th>

                                <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Heure
                                </th>

                                <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-gray-500">
                                    Actions
                                </th>
                            </tr>
                        </thead>


                        <tbody class="divide-y divide-slate-100">

                            {% for meal in meals %}

                                <tr class="transition hover:bg-slate-50/80">

                                    <td class="px-6 py-5">
                                        <span class="text-sm font-semibold text-gray-400">
                                            #{{ meal.id }}
                                        </span>
                                    </td>


                                    <td class="px-6 py-5">
                                        <div class="flex items-center gap-3">

                                            <div class="w-10 h-10 flex-shrink-0 rounded-xl bg-cyan-50 flex items-center justify-center">
                                                <svg class="w-5 h-5 text-cyan-700"
                                                     fill="none"
                                                     stroke="currentColor"
                                                     viewBox="0 0 24 24">
                                                    <path stroke-linecap="round"
                                                          stroke-linejoin="round"
                                                          stroke-width="2"
                                                          d="M12 3v18M5 8h14M7 13h10"/>
                                                </svg>
                                            </div>

                                            <span class="font-bold text-[#102A43]">
                                                {{ meal.dishName }}
                                            </span>

                                        </div>
                                    </td>


                                    <td class="px-6 py-5">
                                        <span class="inline-flex items-center rounded-full bg-orange-50 px-3 py-1.5 text-sm font-bold text-orange-700">
                                            {{ meal.calories }} kcal
                                        </span>
                                    </td>


                                    <td class="px-6 py-5 text-sm font-medium text-gray-600">
                                        {{ meal.date ? meal.date|date('d/m/Y') : '—' }}
                                    </td>


                                    <td class="px-6 py-5">
                                        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-600">

                                            <svg class="w-4 h-4 text-gray-400"
                                                 fill="none"
                                                 stroke="currentColor"
                                                 viewBox="0 0 24 24">
                                                <path stroke-linecap="round"
                                                      stroke-linejoin="round"
                                                      stroke-width="2"
                                                      d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>

                                            {{ meal.hour ? meal.hour|date('H:i') : '—' }}

                                        </span>
                                    </td>


                                    <td class="px-6 py-5">

                                        <div class="flex items-center justify-end gap-2">

                                            <a
                                                href="{{ path('app_meal_show', {'id': meal.id}) }}"
                                                class="inline-flex items-center justify-center rounded-lg bg-cyan-50 px-3 py-2 text-sm font-bold text-cyan-700 transition hover:bg-cyan-100"
                                            >
                                                Détail
                                            </a>

                                            <a
                                                href="{{ path('app_meal_edit', {'id': meal.id}) }}"
                                                class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-gray-600 transition hover:bg-slate-50"
                                            >
                                                Modifier
                                            </a>

                                        </div>

                                    </td>

                                </tr>

                            {% endfor %}

                        </tbody>
                    </table>
                </div>


                {# ============== VERSION MOBILE ============== #}
                <div class="md:hidden divide-y divide-slate-100">

                    {% for meal in meals %}

                        <div class="p-5">

                            <div class="flex items-start justify-between gap-4">

                                <div class="flex items-center gap-3">

                                    <div class="w-11 h-11 flex-shrink-0 rounded-xl bg-cyan-50 flex items-center justify-center">
                                        <svg class="w-5 h-5 text-cyan-700"
                                             fill="none"
                                             stroke="currentColor"
                                             viewBox="0 0 24 24">
                                            <path stroke-linecap="round"
                                                  stroke-linejoin="round"
                                                  stroke-width="2"
                                                  d="M12 3v18M5 8h14M7 13h10"/>
                                        </svg>
                                    </div>

                                    <div>
                                        <p class="font-bold text-[#102A43]">
                                            {{ meal.dishName }}
                                        </p>

                                        <p class="text-xs text-gray-400">
                                            Repas #{{ meal.id }}
                                        </p>
                                    </div>

                                </div>

                                <span class="rounded-full bg-orange-50 px-3 py-1 text-xs font-bold text-orange-700">
                                    {{ meal.calories }} kcal
                                </span>

                            </div>


                            <div class="grid grid-cols-2 gap-3 mt-5">

                                <div class="rounded-xl bg-slate-50 p-3">
                                    <p class="text-xs font-semibold text-gray-400 mb-1">
                                        Date
                                    </p>

                                    <p class="text-sm font-bold text-gray-700">
                                        {{ meal.date ? meal.date|date('d/m/Y') : '—' }}
                                    </p>
                                </div>

                                <div class="rounded-xl bg-slate-50 p-3">
                                    <p class="text-xs font-semibold text-gray-400 mb-1">
                                        Heure
                                    </p>

                                    <p class="text-sm font-bold text-gray-700">
                                        {{ meal.hour ? meal.hour|date('H:i') : '—' }}
                                    </p>
                                </div>

                            </div>


                            <div class="grid grid-cols-2 gap-2 mt-4">

                                <a
                                    href="{{ path('app_meal_show', {'id': meal.id}) }}"
                                    class="text-center rounded-xl bg-cyan-50 px-4 py-2.5 text-sm font-bold text-cyan-700"
                                >
                                    Voir le détail
                                </a>

                                <a
                                    href="{{ path('app_meal_edit', {'id': meal.id}) }}"
                                    class="text-center rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-gray-600"
                                >
                                    Modifier
                                </a>

                            </div>

                        </div>

                    {% endfor %}

                </div>

            {% else %}

                {# ================= AUCUN REPAS ================= #}
                <div class="px-6 py-16 text-center">

                    <div class="mx-auto w-16 h-16 rounded-2xl bg-cyan-50 flex items-center justify-center mb-5">
                        <svg class="w-8 h-8 text-cyan-700"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M12 4v16m8-8H4"/>
                        </svg>
                    </div>

                    <h3 class="text-lg font-bold text-[#102A43]">
                        Aucun repas enregistré
                    </h3>

                    <p class="mt-2 text-sm text-gray-500">
                        Commencez votre suivi nutritionnel en ajoutant votre premier repas.
                    </p>

                    <a
                        href="{{ path('app_meal_new') }}"
                        class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-[#102A43] px-5 py-3 text-sm font-bold text-white transition hover:bg-[#163A5F]"
                    >
                        + Ajouter mon premier repas
                    </a>

                </div>

            {% endif %}

        </div>

    </div>
</div>
{% endblock %}