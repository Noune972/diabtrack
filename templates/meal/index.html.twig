{% extends 'base.html.twig' %}

{% block title %}Détail des plats{% endblock %}

{% block body %}
    <h1>Détail des plats</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Plat</th>
                <th>Calories</th>
                <th>Date</th>
                <th>Heure</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for meal in meals %}
            <tr>
                <td>{{ meal.id }}</td>
                <td>{{ meal.dishName }}</td>
                <td>{{ meal.calories }}</td>
                <td>{{ meal.date ? meal.date|date('Y-m-d') : '' }}</td>
                <td>{{ meal.hour ? meal.hour|date('H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_meal_show', {'id': meal.id}) }}">Détail</a>
                    <a href="{{ path('app_meal_edit', {'id': meal.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_meal_new') }}">Ajouter un nouveau plat</a>
{% endblock %}
