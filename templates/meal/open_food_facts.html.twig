{% extends 'base.html.twig' %}

{% block title %}Open Food Facts - DiabTrack{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#F5F9FC]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">

        <div class="mb-8">
            <div class="flex items-center gap-2 text-sm font-semibold text-cyan-700 mb-3">
                <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                Nutrition & alimentation
            </div>

            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#102A43]">
                Scanner un aliment
            </h1>

            <p class="mt-2 text-gray-500">
                Scannez le code-barres du produit ou saisissez-le manuellement.
            </p>
        </div>


        {# ===================== RECHERCHE ===================== #}
        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm overflow-hidden mb-6">

            <div class="border-b border-slate-100 px-6 py-5">
                <h2 class="text-lg font-bold text-[#102A43]">
                    Code-barres
                </h2>

                <p class="mt-1 text-sm text-gray-500">
                    Utilisez la caméra ou saisissez les chiffres présents sous le code-barres.
                </p>
            </div>

            <div class="p-6">

                {# ===================== SCANNER ===================== #}
                <div class="mb-6">
                    <button
                        type="button"
                        id="start-scanner"
                        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-cyan-700 px-6 py-3.5 font-bold text-white transition hover:bg-cyan-800"
                    >
                        <svg
                            class="h-5 w-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 7h3l2-3h8l2 3h3v13H3V7zm9 3a4 4 0 100 8 4 4 0 000-8z"
                            />
                        </svg>

                        Scanner avec la caméra
                    </button>


                    <div
                        id="scanner-container"
                        class="hidden mt-4 overflow-hidden rounded-2xl bg-black"
                    >
                        <div class="relative">

                            <video
                                id="scanner-video"
                                autoplay
                                playsinline
                                muted
                                class="w-full max-h-[420px] object-cover"
                            ></video>

                            {# Zone visuelle de scan #}
                            <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
                                <div class="h-28 w-4/5 rounded-xl border-2 border-white shadow-lg"></div>
                            </div>

                        </div>

                        <div class="flex items-center justify-between gap-3 bg-[#102A43] px-4 py-3">

                            <p
                                id="scanner-status"
                                class="text-sm font-semibold text-white"
                            >
                                Placez le code-barres dans le cadre.
                            </p>

                            <button
                                type="button"
                                id="stop-scanner"
                                class="rounded-lg bg-white/10 px-3 py-2 text-sm font-bold text-white transition hover:bg-white/20"
                            >
                                Fermer
                            </button>

                        </div>
                    </div>


                    <div
                        id="scanner-error"
                        class="hidden mt-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800"
                    ></div>
                </div>


                <div class="relative my-6">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-slate-200"></div>
                    </div>

                    <div class="relative flex justify-center">
                        <span class="bg-white px-3 text-xs font-bold uppercase tracking-wider text-gray-400">
                            ou saisie manuelle
                        </span>
                    </div>
                </div>


                <form
                    id="barcode-form"
                    method="get"
                    action="{{ path('app_meal_open_food_facts') }}"
                >
                    <label
                        for="barcode"
                        class="block text-sm font-bold text-[#102A43] mb-2"
                    >
                        Numéro du code-barres
                    </label>

                    <div class="flex flex-col sm:flex-row gap-3">

                        <input
                            type="text"
                            inputmode="numeric"
                            pattern="[0-9]*"
                            id="barcode"
                            name="barcode"
                            value="{{ barcode }}"
                            placeholder="Ex. 3017620422003"
                            required
                            class="flex-1 rounded-xl border border-slate-300 bg-white px-4 py-3 text-gray-800 outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100"
                        >

                        <button
                            type="submit"
                            class="inline-flex items-center justify-center rounded-xl bg-[#102A43] px-6 py-3 font-bold text-white transition hover:bg-[#163A5F]"
                        >
                            Rechercher
                        </button>

                    </div>
                </form>

            </div>
        </div>


        {# ===================== PRODUIT ===================== #}
        {% if product %}

            <div class="rounded-3xl border border-slate-200 bg-white shadow-sm overflow-hidden">

                <div class="p-6 sm:p-8">

                    <div class="flex flex-col sm:flex-row gap-6">

                        {% if product.image %}
                            <div class="flex-shrink-0">
                                <img
                                    src="{{ product.image }}"
                                    alt="{{ product.name }}"
                                    class="h-36 w-36 rounded-2xl border border-slate-200 bg-white object-contain p-2"
                                >
                            </div>
                        {% endif %}

                        <div class="flex-1">

                            <div class="flex flex-wrap items-center gap-2 mb-2">

                                <span class="rounded-full bg-cyan-100 px-3 py-1 text-xs font-bold text-cyan-800">
                                    OPEN FOOD FACTS
                                </span>

                                {% if product.nutriscore %}
                                    <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase text-slate-700">
                                        Nutri-Score {{ product.nutriscore }}
                                    </span>
                                {% endif %}

                            </div>

                            <h2 class="text-2xl font-extrabold text-[#102A43]">
                                {{ product.name }}
                            </h2>

                            {% if product.brand %}
                                <p class="mt-1 text-gray-500">
                                    {{ product.brand }}
                                </p>
                            {% endif %}

                            <p class="mt-2 text-xs text-gray-400">
                                Code-barres : {{ product.barcode }}
                            </p>

                        </div>
                    </div>


                    {# ===================== NUTRITION ===================== #}
                    <div class="mt-7">

                        <h3 class="text-sm font-bold text-[#102A43] mb-3">
                            Valeurs nutritionnelles pour 100 g
                        </h3>

                        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">

                            <div class="rounded-2xl bg-[#102A43] p-4 text-white">
                                <p class="text-xs text-blue-100">
                                    Énergie
                                </p>

                                <p class="mt-1 text-xl font-extrabold">
                                    {{ product.energyKcal100g|number_format(1, ',', ' ') }}
                                </p>

                                <p class="text-xs text-blue-100">
                                    kcal
                                </p>
                            </div>

                            <div class="rounded-2xl bg-slate-50 border border-slate-200 p-4">
                                <p class="text-xs text-gray-500">Glucides</p>

                                <p class="mt-1 font-extrabold text-[#102A43]">
                                    {% if product.carbohydrates100g is not null %}
                                        {{ product.carbohydrates100g|number_format(1, ',', ' ') }} g
                                    {% else %}
                                        —
                                    {% endif %}
                                </p>
                            </div>

                            <div class="rounded-2xl bg-slate-50 border border-slate-200 p-4">
                                <p class="text-xs text-gray-500">Sucres</p>

                                <p class="mt-1 font-extrabold text-[#102A43]">
                                    {% if product.sugars100g is not null %}
                                        {{ product.sugars100g|number_format(1, ',', ' ') }} g
                                    {% else %}
                                        —
                                    {% endif %}
                                </p>
                            </div>

                            <div class="rounded-2xl bg-slate-50 border border-slate-200 p-4">
                                <p class="text-xs text-gray-500">Protéines</p>

                                <p class="mt-1 font-extrabold text-[#102A43]">
                                    {% if product.proteins100g is not null %}
                                        {{ product.proteins100g|number_format(1, ',', ' ') }} g
                                    {% else %}
                                        —
                                    {% endif %}
                                </p>
                            </div>

                            <div class="rounded-2xl bg-slate-50 border border-slate-200 p-4">
                                <p class="text-xs text-gray-500">Lipides</p>

                                <p class="mt-1 font-extrabold text-[#102A43]">
                                    {% if product.fat100g is not null %}
                                        {{ product.fat100g|number_format(1, ',', ' ') }} g
                                    {% else %}
                                        —
                                    {% endif %}
                                </p>
                            </div>

                        </div>
                    </div>


                    {# ===================== QUANTITÉ ===================== #}
                    <div class="mt-8 rounded-2xl border-2 border-cyan-200 bg-cyan-50/60 p-5 sm:p-6">

                        <h3 class="text-lg font-extrabold text-[#102A43]">
                            Quelle quantité avez-vous consommée ?
                        </h3>

                        <p class="mt-1 text-sm text-gray-600">
                            Indiquez le poids réellement consommé.
                        </p>

                        <form
                            method="post"
                            action="{{ path('app_meal_open_food_facts_add') }}"
                            class="mt-5"
                        >
                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('add-open-food-facts-product') }}"
                            >

                            <input
                                type="hidden"
                                name="barcode"
                                value="{{ product.barcode }}"
                            >

                            <div class="grid sm:grid-cols-2 gap-4">

                                <div>
                                    <label
                                        for="quantity"
                                        class="block text-sm font-bold text-[#102A43] mb-2"
                                    >
                                        Quantité consommée
                                    </label>

                                    <div class="relative">

                                        <input
                                            type="number"
                                            id="quantity"
                                            name="quantity"
                                            min="1"
                                            step="1"
                                            placeholder="Ex. 35"
                                            required
                                            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 pr-12 text-lg font-bold text-[#102A43] outline-none focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100"
                                        >

                                        <span class="absolute right-4 top-1/2 -translate-y-1/2 font-bold text-gray-400">
                                            g
                                        </span>

                                    </div>
                                </div>

                                <div>
                                    <p class="block text-sm font-bold text-[#102A43] mb-2">
                                        Calories consommées
                                    </p>

                                    <div class="flex h-[54px] items-center rounded-xl bg-[#102A43] px-4 text-white">

                                        <span
                                            id="calculated-calories"
                                            class="text-xl font-extrabold"
                                        >
                                            0
                                        </span>

                                        <span class="ml-2 text-sm text-blue-100">
                                            kcal
                                        </span>

                                    </div>
                                </div>

                            </div>

                            <div class="mt-3 text-xs text-gray-500">
                                Calcul :
                                {{ product.energyKcal100g|number_format(1, ',', ' ') }}
                                kcal / 100 g × quantité consommée.
                            </div>

                            <button
                                type="submit"
                                class="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-cyan-700 px-6 py-3.5 font-bold text-white shadow-sm transition hover:bg-cyan-800"
                            >
                                <svg
                                    class="w-5 h-5"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 4v16m8-8H4"
                                    />
                                </svg>

                                Ajouter au repas
                            </button>

                        </form>
                    </div>


                    <div class="mt-5 rounded-xl bg-amber-50 border border-amber-100 px-4 py-3">
                        <p class="text-xs leading-relaxed text-amber-800">
                            Les informations proviennent d'Open Food Facts et peuvent être
                            incomplètes ou comporter des erreurs. Vérifiez l'étiquette du
                            produit si nécessaire.
                        </p>
                    </div>

                </div>
            </div>


        {% elseif searched %}

            <div class="rounded-3xl border border-amber-200 bg-amber-50 p-7 text-center">

                <div class="text-4xl mb-3">🔎</div>

                <h2 class="font-extrabold text-[#102A43]">
                    Produit introuvable
                </h2>

                <p class="mt-2 text-sm text-gray-600">
                    Vérifiez le code-barres ou essayez avec un autre produit.
                </p>

            </div>

        {% endif %}


        <div class="mt-6">
            <a
                href="{{ path('app_meal_new') }}"
                class="inline-flex items-center gap-2 text-sm font-bold text-gray-600 hover:text-[#102A43]"
            >
                ← Retour au repas
            </a>
        </div>

    </div>
</div>


<script>
(function () {
    let stream = null;
    let scanning = false;
    let animationFrame = null;

    async function initOpenFoodFactsPage() {
        const quantityInput = document.getElementById('quantity');
        const caloriesOutput = document.getElementById('calculated-calories');

        {% if product %}
        if (quantityInput && caloriesOutput) {
            const caloriesPer100g = {{ product.energyKcal100g|json_encode|raw }};

            const updateCalories = () => {
                const quantity = parseFloat(quantityInput.value);

                if (Number.isNaN(quantity) || quantity <= 0) {
                    caloriesOutput.textContent = '0';
                    return;
                }

                const calories = (caloriesPer100g * quantity) / 100;

                caloriesOutput.textContent = calories.toLocaleString(
                    'fr-FR',
                    {
                        minimumFractionDigits: 1,
                        maximumFractionDigits: 1
                    }
                );
            };

            if (!quantityInput.dataset.caloriesInitialized) {
                quantityInput.addEventListener('input', updateCalories);
                quantityInput.dataset.caloriesInitialized = 'true';
            }

            updateCalories();
        }
        {% endif %}

        const startButton = document.getElementById('start-scanner');
        const stopButton = document.getElementById('stop-scanner');
        const container = document.getElementById('scanner-container');
        const video = document.getElementById('scanner-video');
        const status = document.getElementById('scanner-status');
        const error = document.getElementById('scanner-error');
        const barcodeInput = document.getElementById('barcode');
        const barcodeForm = document.getElementById('barcode-form');

        if (
            !startButton ||
            !stopButton ||
            !container ||
            !video ||
            !barcodeInput ||
            !barcodeForm
        ) {
            return;
        }

        function showError(message) {
            error.textContent = message;
            error.classList.remove('hidden');
        }

        function stopScanner() {
            scanning = false;

            if (animationFrame) {
                cancelAnimationFrame(animationFrame);
                animationFrame = null;
            }

            if (stream) {
                stream.getTracks().forEach(track => track.stop());
                stream = null;
            }

            video.srcObject = null;
            container.classList.add('hidden');
        }

        async function startScanner() {
            error.classList.add('hidden');

            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                showError(
                    "La caméra n'est pas disponible dans ce navigateur."
                );
                return;
            }

            if (!('BarcodeDetector' in window)) {
                showError(
                    "Le scanner automatique n'est pas pris en charge par ce navigateur. Vous pouvez toujours saisir le code-barres manuellement."
                );
                return;
            }

            try {
                const detector = new BarcodeDetector({
                    formats: [
                        'ean_13',
                        'ean_8',
                        'upc_a',
                        'upc_e'
                    ]
                });

                stream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: {
                            ideal: 'environment'
                        }
                    },
                    audio: false
                });

                video.srcObject = stream;
                container.classList.remove('hidden');

                await video.play();

                scanning = true;

                async function detect() {
                    if (!scanning) {
                        return;
                    }

                    try {
                        const barcodes = await detector.detect(video);

                        if (barcodes.length > 0) {
                            const code = barcodes[0].rawValue;

                            if (code) {
                                scanning = false;

                                if (status) {
                                    status.textContent =
                                        'Code détecté : ' + code;
                                }

                                barcodeInput.value = code;

                                if (navigator.vibrate) {
                                    navigator.vibrate(100);
                                }

                                stopScanner();

                                barcodeForm.requestSubmit();
                                return;
                            }
                        }
                    } catch (scanError) {
                        // On continue simplement le scan.
                    }

                    animationFrame = requestAnimationFrame(detect);
                }

                detect();

            } catch (cameraError) {
                stopScanner();

                showError(
                    "Impossible d'accéder à la caméra. Vérifiez l'autorisation accordée au navigateur."
                );
            }
        }

        if (!startButton.dataset.scannerInitialized) {
            startButton.addEventListener('click', startScanner);
            stopButton.addEventListener('click', stopScanner);

            startButton.dataset.scannerInitialized = 'true';
        }
    }

    document.addEventListener(
        'DOMContentLoaded',
        initOpenFoodFactsPage
    );

    document.addEventListener(
        'turbo:load',
        initOpenFoodFactsPage
    );
})();
</script>

{% endblock %}