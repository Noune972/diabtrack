{% extends 'base.html.twig' %}

{% block title %}Créer un compte - DiabTrack{% endblock %}

{% block body %}

<section class="relative min-h-screen overflow-hidden bg-[#F5F9FC]">

    {# Décoration #}
    <div class="absolute left-0 top-0 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-200/30 blur-3xl"></div>
    <div class="absolute bottom-0 right-0 h-96 w-96 translate-x-1/3 translate-y-1/3 rounded-full bg-teal-200/30 blur-3xl"></div>

    <div class="relative mx-auto flex min-h-screen max-w-7xl items-center justify-center px-5 py-12 lg:px-8">

        <div class="grid w-full max-w-6xl overflow-hidden rounded-[32px] bg-white shadow-[0_30px_80px_rgba(15,42,67,0.15)] ring-1 ring-slate-200/60 lg:grid-cols-[0.9fr_1.1fr]">


            {# =====================================================
               COLONNE GAUCHE
               ===================================================== #}

            <div class="relative hidden overflow-hidden bg-gradient-to-br from-[#102A43] via-[#0C4A6E] to-[#0F766E] p-10 text-white lg:flex lg:flex-col lg:justify-between xl:p-12">

                <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-cyan-300/10 blur-2xl"></div>
                <div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-teal-300/10 blur-2xl"></div>


                {# Logo #}

                <div class="relative flex items-center gap-3">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-2xl ring-1 ring-white/10">
                        💧
                    </div>

                    <span class="text-2xl font-black tracking-tight">
                        Diab<span class="text-cyan-300">Track</span>
                    </span>

                </div>


                <div class="relative py-8">

                    <div class="inline-flex items-center rounded-full bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-cyan-200 ring-1 ring-white/10">
                        Votre espace santé
                    </div>

                    <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight xl:text-5xl">
                        Prenez en main
                        <span class="text-cyan-300">
                            votre suivi.
                        </span>
                    </h1>

                    <p class="mt-5 max-w-md text-sm leading-7 text-slate-300">
                        Créez votre espace personnel DiabTrack et centralisez
                        simplement les informations utiles à votre suivi quotidien.
                    </p>


                    <div class="mt-8 flex justify-center">

                        <div class="relative">

                            <div class="absolute inset-6 rounded-full bg-cyan-300/20 blur-3xl"></div>

                            <img
                                src="{{ asset('images/mascotte.png') }}"
                                alt="Mascotte DiabTrack"
                                class="relative max-h-52 w-auto object-contain"
                            >

                        </div>

                    </div>


                    <div class="mt-8 grid grid-cols-2 gap-3">

                        <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/10">

                            <div class="text-xl">
                                📊
                            </div>

                            <p class="mt-2 text-xs font-bold text-slate-200">
                                Suivi de vos données
                            </p>

                        </div>


                        <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/10">

                            <div class="text-xl">
                                🔒
                            </div>

                            <p class="mt-2 text-xs font-bold text-slate-200">
                                Espace sécurisé
                            </p>

                        </div>

                    </div>

                </div>


                <div class="relative flex items-center gap-2 text-xs font-semibold text-slate-400">

                    <span class="h-2 w-2 rounded-full bg-emerald-400"></span>

                    Données personnelles protégées

                </div>

            </div>


            {# =====================================================
               FORMULAIRE
               ===================================================== #}

            <div class="p-7 sm:p-10 lg:p-12">


                {# Logo mobile #}

                <div class="mb-8 flex items-center gap-3 lg:hidden">

                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#102A43] text-xl text-white">
                        💧
                    </div>

                    <span class="text-xl font-black text-[#102A43]">
                        Diab<span class="text-teal-500">Track</span>
                    </span>

                </div>


                <div class="mb-8">

                    <p class="text-xs font-black uppercase tracking-[0.2em] text-teal-600">
                        Inscription
                    </p>

                    <h2 class="mt-2 text-3xl font-black tracking-tight text-[#102A43] sm:text-4xl">
                        Créer un compte
                    </h2>

                    <p class="mt-3 text-sm leading-6 text-slate-500">
                        Renseignez vos informations pour créer votre espace personnel.
                    </p>

                </div>


                {# =================================================
                   ERREURS EMAIL
                   ================================================= #}

                {% for flash_error in app.flashes('verify_email_error') %}

                    <div class="mb-6 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 text-red-700">

                        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-red-100 font-black">
                            !
                        </div>

                        <div>

                            <p class="text-sm font-black">
                                Inscription impossible
                            </p>

                            <p class="mt-1 text-xs">
                                {{ flash_error }}
                            </p>

                        </div>

                    </div>

                {% endfor %}


                {{ form_errors(registrationForm) }}


                {{ form_start(registrationForm, {
                    'attr': {
                        'class': 'space-y-5'
                    }
                }) }}


                    {# =============================================
                       NOM + PRÉNOM
                       ============================================= #}

                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">


                        <div>

                            {{ form_label(
                                registrationForm.name,
                                'Nom',
                                {
                                    'label_attr': {
                                        'class': 'mb-2 block text-sm font-black text-[#102A43]'
                                    }
                                }
                            ) }}

                            {{ form_widget(
                                registrationForm.name,
                                {
                                    'attr': {
                                        'class': 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm text-[#102A43] outline-none transition placeholder:text-slate-400 focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100',
                                        'placeholder': 'Votre nom'
                                    }
                                }
                            ) }}

                            <div class="mt-1 text-xs text-red-600">
                                {{ form_errors(registrationForm.name) }}
                            </div>

                        </div>


                        <div>

                            {{ form_label(
                                registrationForm.firstname,
                                'Prénom',
                                {
                                    'label_attr': {
                                        'class': 'mb-2 block text-sm font-black text-[#102A43]'
                                    }
                                }
                            ) }}

                            {{ form_widget(
                                registrationForm.firstname,
                                {
                                    'attr': {
                                        'class': 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm text-[#102A43] outline-none transition placeholder:text-slate-400 focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100',
                                        'placeholder': 'Votre prénom'
                                    }
                                }
                            ) }}

                            <div class="mt-1 text-xs text-red-600">
                                {{ form_errors(registrationForm.firstname) }}
                            </div>

                        </div>

                    </div>


                    {# =============================================
                       EMAIL
                       ============================================= #}

                    <div>

                        {{ form_label(
                            registrationForm.email,
                            'Adresse email',
                            {
                                'label_attr': {
                                    'class': 'mb-2 block text-sm font-black text-[#102A43]'
                                }
                            }
                        ) }}

                        {{ form_widget(
                            registrationForm.email,
                            {
                                'attr': {
                                    'class': 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm text-[#102A43] outline-none transition placeholder:text-slate-400 focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100',
                                    'placeholder': 'exemple@email.com'
                                }
                            }
                        ) }}

                        <div class="mt-1 text-xs text-red-600">
                            {{ form_errors(registrationForm.email) }}
                        </div>

                    </div>


                    {# =============================================
                       GENRE + POIDS
                       ============================================= #}

                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">


                        <div>

                            {{ form_label(
                                registrationForm.gender,
                                'Genre',
                                {
                                    'label_attr': {
                                        'class': 'mb-2 block text-sm font-black text-[#102A43]'
                                    }
                                }
                            ) }}

                            {{ form_widget(
                                registrationForm.gender,
                                {
                                    'attr': {
                                        'class': 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm text-[#102A43] outline-none transition focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100'
                                    }
                                }
                            ) }}

                            <div class="mt-1 text-xs text-red-600">
                                {{ form_errors(registrationForm.gender) }}
                            </div>

                        </div>


                        <div>

                            {{ form_label(
                                registrationForm.weight,
                                'Poids',
                                {
                                    'label_attr': {
                                        'class': 'mb-2 block text-sm font-black text-[#102A43]'
                                    }
                                }
                            ) }}

                            <div class="relative">

                                {{ form_widget(
                                    registrationForm.weight,
                                    {
                                        'attr': {
                                            'class': 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 pr-12 text-sm text-[#102A43] outline-none transition placeholder:text-slate-400 focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100',
                                            'placeholder': '70'
                                        }
                                    }
                                ) }}

                                <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center text-xs font-bold text-slate-400">
                                    kg
                                </span>

                            </div>

                            <div class="mt-1 text-xs text-red-600">
                                {{ form_errors(registrationForm.weight) }}
                            </div>

                        </div>

                    </div>


                    {# =============================================
                       DATE DE NAISSANCE
                       ============================================= #}

                    <div>

                        {{ form_label(
                            registrationForm.dateOfBirth,
                            'Date de naissance',
                            {
                                'label_attr': {
                                    'class': 'mb-2 block text-sm font-black text-[#102A43]'
                                }
                            }
                        ) }}

                        {{ form_widget(
                            registrationForm.dateOfBirth,
                            {
                                'attr': {
                                    'class': 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm text-[#102A43] outline-none transition focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100'
                                }
                            }
                        ) }}

                        <div class="mt-1 text-xs text-red-600">
                            {{ form_errors(registrationForm.dateOfBirth) }}
                        </div>

                    </div>


                    {# =============================================
                       MOT DE PASSE
                       ============================================= #}

                    <div>

                        {{ form_label(
                            registrationForm.plainPassword,
                            'Mot de passe',
                            {
                                'label_attr': {
                                    'class': 'mb-2 block text-sm font-black text-[#102A43]'
                                }
                            }
                        ) }}

                        {{ form_widget(
                            registrationForm.plainPassword,
                            {
                                'attr': {
                                    'class': 'w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3.5 text-sm text-[#102A43] outline-none transition placeholder:text-slate-400 focus:border-teal-400 focus:bg-white focus:ring-4 focus:ring-teal-100',
                                    'placeholder': '••••••••'
                                }
                            }
                        ) }}

                        <div class="mt-1 text-xs text-red-600">
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>

                    </div>


                    {# =============================================
                       CONDITIONS
                       ============================================= #}

                    <div class="rounded-2xl bg-slate-50 p-4">

                        <div class="flex items-start gap-3">

                            <div class="mt-0.5">
                                {{ form_widget(registrationForm.agreeTerms, {
                                    'attr': {
                                        'class': 'h-4 w-4 rounded border-slate-300 text-teal-600 focus:ring-teal-500'
                                    }
                                }) }}
                            </div>

                            <div>

                                {{ form_label(
                                    registrationForm.agreeTerms,
                                    null,
                                    {
                                        'label_attr': {
                                            'class': 'cursor-pointer text-sm font-semibold leading-5 text-slate-600'
                                        }
                                    }
                                ) }}

                                <div class="mt-1 text-xs text-red-600">
                                    {{ form_errors(registrationForm.agreeTerms) }}
                                </div>

                            </div>

                        </div>

                    </div>


                    {# =============================================
                       BOUTON
                       ============================================= #}

                    <button
                        type="submit"
                        class="group flex w-full items-center justify-center gap-2 rounded-2xl bg-[#102A43] px-5 py-4 text-sm font-black text-white shadow-lg shadow-slate-900/10 transition duration-300 hover:-translate-y-0.5 hover:bg-[#163B5C] hover:shadow-xl"
                    >
                        Créer mon compte

                        <span class="transition-transform group-hover:translate-x-1">
                            →
                        </span>
                    </button>


                {{ form_end(registrationForm) }}


                {# =================================================
                   CONNEXION
                   ================================================= #}

                <div class="mt-7 border-t border-slate-100 pt-6 text-center">

                    <p class="text-sm text-slate-500">

                        Vous avez déjà un compte ?

                        <a
                            href="{{ path('app_login') }}"
                            class="font-black text-teal-600 transition hover:text-teal-700 hover:underline"
                        >
                            Se connecter
                        </a>

                    </p>

                </div>


                <div class="mt-6 flex items-center justify-center gap-2 text-[11px] font-semibold text-slate-400">

                    <span>🔒</span>

                    Inscription sécurisée • DiabTrack

                </div>

            </div>

        </div>

    </div>

</section>

{% endblock %}