<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
<meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
<script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
<script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
</head>
<body>
<header class="flex items-center justify-between w-full bg-gray-50 px-8 py-4">

    {% if app.user %}
<a href="{{ path('app_home') }}">
<img
src="{{ asset('images/logo.svg') }}"
alt="Logo DiabTrack"
class="h-16 w-auto">
</a>

<div class="text-right">
<p class="text-black font-semibold tracking-wide text-4xl">
                Bonjour
</p>

<h2 class="font-display font-extrabold text-[#48742C] leading-tight text-4xl">
                {{ app.user.firstname }}
</h2>
</div>
    {% endif %}

</header>

{% if app.user %}
{# Bouton menu mobile #}
<div class="lg:hidden flex items-center justify-end bg-[#48742C] px-4 py-3">
    <button id="sidebar-toggle" class="text-white p-2" aria-label="Ouvrir le menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
    </button>
</div>
{% endif %}

<div class="flex min-h-screen">

    {% if app.user %}
    {# Overlay mobile #}
    <div id="sidebar-overlay" class="hidden fixed inset-0 bg-black/40 z-30 lg:hidden"></div>

    {# Sidebar #}
    <aside id="sidebar"
        class="fixed lg:static inset-y-0 left-0 z-40 w-64 bg-[#48742C] flex flex-col
               transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out">

        <nav class="flex-1 px-4 py-6 space-y-1">
            <a href="{{ path('app_home') }}"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-green-100 hover:bg-white/10 hover:text-white transition
                {{ app.request.attributes.get('_route') == 'app_home' ? 'bg-white/15 text-white font-semibold' : '' }}">
                <img src="{{ asset('images/home.png') }}" alt="Accueil" class="h-6 w-auto">
                Accueil
            </a>

            <a href="{{ path('app_dashboard') }}"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-green-100 hover:bg-white/10 hover:text-white transition
                {{ app.request.attributes.get('_route') starts with 'app_dashboard' ? 'bg-white/15 text-white font-semibold' : '' }}">
                <img src="{{ asset('images/suivi.png') }}" alt="Dashboard" class="h-6 w-auto">
                Dashboard
            </a>


            <a href="{{ path('app_emmergency') }}"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-green-100 hover:bg-white/10 hover:text-white transition
                {{ app.request.attributes.get('_route') == 'app_emmergency' ? 'bg-white/15 text-white font-semibold' : '' }}">
                <img src="{{ asset('images/sos.png') }}" alt="Secours" class="h-6 w-auto">
                Secours
            </a>


            <a href="{{ path('app_blog_index') }}"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-green-100 hover:bg-white/10 hover:text-white transition
                {{ app.request.attributes.get('_route') == 'app_emmergency' ? 'bg-white/15 text-white font-semibold' : '' }}">
                <img src="{{ asset('images/blog.png') }}" alt="Secours" class="h-6 w-auto">
                Blog
            </a>


            <a href="{{ path('app_emmergency') }}"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-green-100 hover:bg-white/10 hover:text-white transition
                {{ app.request.attributes.get('_route') == 'app_emmergency' ? 'bg-white/15 text-white font-semibold' : '' }}">
                <img src="{{ asset('images/rappel.png') }}" alt="Rappel" class="h-6 w-auto">
                Rappel
            </a>

            <a href="{{ path('app_meal_new') }}"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-green-100 hover:bg-white/10 hover:text-white transition
                {{ app.request.attributes.get('_route') starts with 'app_meal_new' ? 'bg-white/15 text-white font-semibold' : '' }}">
               <img src="{{ asset('images/forum.png') }}" alt="Forum" class="h-6 w-auto">
                Forum
            </a>

        </nav>

        <div class="px-4 py-4 border-t border-white/10">
            <a href="{{ path('app_account_delete') }}"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-green-100 hover:bg-white/10 hover:text-white transition">
                <img src="{{ asset('images/profil.png') }}" alt="Profil" class="h-6 w-auto">
                Profil
            </a>
            <a href="{{ path('app_logout') }}"
                class="flex items-center gap-3 px-4 py-3 rounded-xl text-green-100 hover:bg-white/10 hover:text-white transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                Déconnexion
            </a>
        </div>
    </aside>
    {% endif %}

    {# Contenu principal #}
    <main class="flex-1 min-w-0">
        {% block body %}{% endblock %}
    </main>

</div>

<script>
    function initSidebar() {
        const toggle = document.getElementById('sidebar-toggle');
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebar-overlay');

        if (!toggle || !sidebar || !overlay) {
            return;
        }

        function openSidebar() {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
        }

        function closeSidebar() {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('hidden');
        }

        toggle.addEventListener('click', openSidebar);
        overlay.addEventListener('click', closeSidebar);
    }

    document.addEventListener('DOMContentLoaded', initSidebar);
    document.addEventListener('turbo:load', initSidebar);
</script>
</body>
</html>