<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{% block title %}DiabTrack{% endblock %}</title>

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}

    {% if frankenphpHotReload %}
        <meta
            name="frankenphp-hot-reload:url"
            content="{{ frankenphpHotReload }}"
        >

        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>

        <script
            src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm"
            type="module">
        </script>
    {% endif %}
</head>


<body class="min-h-screen bg-[#F5F9FC] text-slate-900">


{# ============================================================
   UTILISATEUR CONNECTÉ
   ============================================================ #}

{% if app.user %}

<div class="flex min-h-screen">


    {# ========================================================
       SIDEBAR
       ======================================================== #}

    <aside
        id="diabtrack-sidebar"
        class="fixed inset-y-0 left-0 z-50 flex w-[290px] -translate-x-full flex-col bg-[#102A43] shadow-2xl transition-transform duration-300 lg:sticky lg:top-0 lg:h-screen lg:translate-x-0 lg:shadow-none"
    >


        {# ================= LOGO ================= #}

        <div class="flex h-[92px] items-center justify-between border-b border-white/10 px-6">

            <a
                href="{{ path('app_home') }}"
                class="flex items-center gap-3"
                aria-label="Accueil DiabTrack"
            >

                <div class="flex h-12 w-12 items-center justify-center overflow-hidden rounded-2xl bg-white shadow-lg">

                    <img
                        src="{{ asset('images/logo.svg') }}"
                        alt="Logo DiabTrack"
                        class="h-11 w-11 object-contain"
                    >

                </div>

                <div>
                    <p class="text-xl font-black tracking-tight text-white">
                        Diab<span class="text-teal-300">Track</span>
                    </p>

                    <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-slate-400">
                        Mon suivi, ma santé
                    </p>
                </div>

            </a>


            <button
                type="button"
                onclick="toggleDiabTrackMenu()"
                class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-white lg:hidden"
                aria-label="Fermer le menu"
            >
                ✕
            </button>

        </div>


        {# ================= UTILISATEUR ================= #}

        <div class="px-5 pt-6">

            <div class="rounded-[22px] bg-white/[0.07] p-4 ring-1 ring-white/10">

                <div class="flex items-center gap-3">

                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-teal-400 to-cyan-500 text-lg font-black text-white">

                        {{ app.user.firstname|default('U')|first|upper }}

                    </div>

                    <div class="min-w-0">

                        <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-slate-400">
                            Bonjour
                        </p>

                        <p class="truncate font-black text-white">
                            {{ app.user.firstname }}
                        </p>

                    </div>

                </div>

            </div>

        </div>


        {# ====================================================
           NAVIGATION
           ==================================================== #}

        <nav class="flex-1 overflow-y-auto px-5 py-6">

            <p class="mb-3 px-3 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">
                Navigation
            </p>


            {# ACCUEIL #}

            <a
                href="{{ path('app_home') }}"
                class="mb-1.5 flex items-center gap-3 rounded-2xl px-4 py-3.5 text-sm font-bold transition
                {{ app.request.attributes.get('_route') == 'app_home'
                    ? 'bg-gradient-to-r from-teal-500 to-cyan-500 text-white shadow-lg'
                    : 'text-slate-300 hover:bg-white/[0.07] hover:text-white' }}"
            >

                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-lg">
                    🏠
                </span>

                <span class="flex-1">
                    Accueil
                </span>

            </a>


            {# DASHBOARD #}

            <a
                href="{{ path('app_dashboard') }}"
                class="mb-1.5 flex items-center gap-3 rounded-2xl px-4 py-3.5 text-sm font-bold transition
                {{ app.request.attributes.get('_route') starts with 'app_dashboard'
                    ? 'bg-gradient-to-r from-teal-500 to-cyan-500 text-white shadow-lg'
                    : 'text-slate-300 hover:bg-white/[0.07] hover:text-white' }}"
            >

                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-lg">
                    📊
                </span>

                <span class="flex-1">
                    Tableau de bord
                </span>

            </a>

            {# MA JOURNÉE #}

<a
    href="{{ path('app_daily_journal') }}"
    class="mb-1.5 flex items-center gap-3 rounded-2xl px-4 py-3.5 text-sm font-bold transition
    {{ app.request.attributes.get('_route') == 'app_daily_journal'
        ? 'bg-gradient-to-r from-teal-500 to-cyan-500 text-white shadow-lg'
        : 'text-slate-300 hover:bg-white/[0.07] hover:text-white' }}"
>

    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-lg">
        📅
    </span>

    <span class="flex-1">
        Ma journée
    </span>

</a>

{# MES OBJECTIFS GLYCÉMIQUES #}

<a
    href="{{ path('app_glycemic_target') }}"
    class="mb-1.5 flex items-center gap-3 rounded-2xl px-4 py-3.5 text-sm font-bold transition
    {{ app.request.attributes.get('_route') == 'app_glycemic_target'
        ? 'bg-gradient-to-r from-teal-500 to-cyan-500 text-white shadow-lg'
        : 'text-slate-300 hover:bg-white/[0.07] hover:text-white' }}"
>
    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-lg">
        🎯
    </span>

    <span class="flex-1">
        Mes objectifs
    </span>
</a>


            {# URGENCES #}

            <a
                href="{{ path('app_emmergency') }}"
                class="mb-1.5 flex items-center gap-3 rounded-2xl px-4 py-3.5 text-sm font-bold transition
                {{ app.request.attributes.get('_route') == 'app_emmergency'
                    ? 'bg-red-500 text-white shadow-lg'
                    : 'text-slate-300 hover:bg-red-500/10 hover:text-red-300' }}"
            >

                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-red-500/10 text-lg">
                    🆘
                </span>

                <span class="flex-1">
                    Urgences
                </span>

            </a>


            {# BLOG #}

            <a
                href="{{ path('app_blog_index') }}"
                class="mb-1.5 flex items-center gap-3 rounded-2xl px-4 py-3.5 text-sm font-bold transition
                {{ app.request.attributes.get('_route') starts with 'app_blog'
                    ? 'bg-gradient-to-r from-teal-500 to-cyan-500 text-white shadow-lg'
                    : 'text-slate-300 hover:bg-white/[0.07] hover:text-white' }}"
            >

                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-lg">
                    📚
                </span>

                <span class="flex-1">
                    Blog
                </span>

            </a>


            {# =================================================
               COMMUNAUTÉ
               ================================================= #}

            <div class="my-6 border-t border-white/10"></div>

            <p class="mb-3 px-3 text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">
                Communauté
            </p>


                       {# RAPPELS #}

            <a
                href="{{ path('app_reminder_index') }}"
                class="mb-1.5 flex items-center gap-3 rounded-2xl px-4 py-3.5 text-sm font-bold transition
                {{ app.request.attributes.get('_route') starts with 'app_reminder'
                    ? 'bg-gradient-to-r from-teal-500 to-cyan-500 text-white shadow-lg'
                    : 'text-slate-300 hover:bg-white/[0.07] hover:text-white' }}"
            >

                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-lg">
                    🔔
                </span>

                <span class="flex-1">
                    Rappels
                </span>

            </a>

            {# FORUM - route à ajouter plus tard #}

            <div class="mb-1.5 flex items-center gap-3 rounded-2xl px-4 py-3.5 text-sm font-bold text-slate-500">

                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/5 text-lg">
                    💬
                </span>

                <span class="flex-1">
                    Forum
                </span>

                <span class="rounded-full bg-white/5 px-2 py-1 text-[8px] font-black uppercase tracking-wider">
                    Bientôt
                </span>

            </div>


            {# =================================================
               ADMINISTRATION
               ================================================= #}

            {% if is_granted('ROLE_ADMIN') %}

                <div class="my-6 border-t border-white/10"></div>


                <div class="mb-3 flex items-center justify-between px-3">

                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">
                        Administration
                    </p>

                    <span class="rounded-full bg-amber-400/10 px-2 py-1 text-[8px] font-black uppercase tracking-wider text-amber-300">
                        Admin
                    </span>

                </div>


                <a
                    href="{{ path('app_admin') }}"
                    class="mb-1.5 flex items-center gap-3 rounded-2xl px-4 py-3.5 text-sm font-bold transition
                    {{ app.request.attributes.get('_route') starts with 'app_admin'
                        and not (app.request.attributes.get('_route') starts with 'app_admin_user')
                        ? 'bg-gradient-to-r from-teal-500 to-cyan-500 text-white shadow-lg'
                        : 'text-slate-300 hover:bg-white/[0.07] hover:text-white' }}"
                >

                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-lg">
                        ⚙️
                    </span>

                    <span class="flex-1">
                        Administration
                    </span>

                </a>


                <a
                    href="{{ path('app_admin_user') }}"
                    class="mb-1.5 flex items-center gap-3 rounded-2xl px-4 py-3.5 text-sm font-bold transition
                    {{ app.request.attributes.get('_route') starts with 'app_admin_user'
                        ? 'bg-gradient-to-r from-teal-500 to-cyan-500 text-white shadow-lg'
                        : 'text-slate-300 hover:bg-white/[0.07] hover:text-white' }}"
                >

                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-lg">
                        👥
                    </span>

                    <span class="flex-1">
                        Utilisateurs
                    </span>

                </a>

            {% endif %}

        </nav>


        {# ====================================================
           BAS SIDEBAR
           ==================================================== #}

        <div class="border-t border-white/10 p-5">


            {# Le fichier d'origine utilise app_account_delete
               pour Profil. On conserve cette route pour le moment. #}

            <a
                href="{{ path('app_account_delete') }}"
                class="mb-2 flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-slate-300 transition hover:bg-white/[0.07] hover:text-white"
            >

                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10 text-lg">
                    👤
                </span>

                <span class="flex-1">
                    Mon profil
                </span>

            </a>


            <a
                href="{{ path('app_logout') }}"
                class="flex items-center gap-3 rounded-2xl px-4 py-3 text-sm font-bold text-slate-300 transition hover:bg-red-500/10 hover:text-red-300"
            >

                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-white/10">

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                        />
                    </svg>

                </span>

                <span class="flex-1">
                    Déconnexion
                </span>

            </a>

        </div>

    </aside>


    {# ========================================================
       OVERLAY MOBILE
       ======================================================== #}

    <div
        id="diabtrack-overlay"
        onclick="toggleDiabTrackMenu()"
        class="fixed inset-0 z-40 hidden bg-slate-950/50 backdrop-blur-sm lg:hidden"
    ></div>


    {# ========================================================
       PARTIE DROITE
       ======================================================== #}

    <div class="min-w-0 flex-1">


        {# ====================================================
           HEADER
           ==================================================== #}

        <header class="sticky top-0 z-30 flex h-[92px] items-center justify-between border-b border-slate-200/70 bg-white/90 px-5 backdrop-blur-xl sm:px-7 lg:px-8">

            <div class="flex items-center gap-4">

                <button
                    type="button"
                    onclick="toggleDiabTrackMenu()"
                    class="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-100 text-slate-700 transition hover:bg-slate-200 lg:hidden"
                    aria-label="Ouvrir le menu"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-6 w-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4 6h16M4 12h16M4 18h16"
                        />
                    </svg>

                </button>


                <div>

                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-teal-600">
                        DiabTrack
                    </p>

                    <p class="mt-0.5 hidden text-sm font-bold text-slate-500 sm:block">
                        Votre espace de suivi
                    </p>

                </div>

            </div>


            <div class="flex items-center gap-3">


                <a
                    href="{{ path('app_emmergency') }}"
                    class="hidden items-center gap-2 rounded-xl bg-red-50 px-4 py-2.5 text-xs font-black text-red-600 transition hover:bg-red-100 sm:flex"
                >
                    🆘 Urgences
                </a>


                <div class="flex items-center gap-3 rounded-2xl bg-slate-50 p-2 pr-3 ring-1 ring-slate-100">

                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-teal-400 to-cyan-500 font-black text-white">

                        {{ app.user.firstname|default('U')|first|upper }}

                    </div>

                    <div class="hidden sm:block">

                        <p class="max-w-[150px] truncate text-sm font-black text-[#102A43]">
                            {{ app.user.firstname }}
                        </p>

                        <p class="text-[10px] font-semibold text-slate-400">

                            {% if is_granted('ROLE_ADMIN') %}
                                Administrateur
                            {% else %}
                                Mon compte
                            {% endif %}

                        </p>

                    </div>

                </div>

            </div>

        </header>

{% endif %}


{# ============================================================
   UNIQUE BLOCK BODY
   IMPORTANT : IL N'EXISTE QU'UNE SEULE FOIS
   ============================================================ #}

<main class="min-w-0 flex-1">
    {% block body %}
    {% endblock %}
</main>


{% if app.user %}

    </div>

</div>

{% endif %}


{# ============================================================
   MENU MOBILE
   ============================================================ #}

<script>

    function toggleDiabTrackMenu()
    {
        const sidebar = document.getElementById('diabtrack-sidebar');
        const overlay = document.getElementById('diabtrack-overlay');

        if (!sidebar || !overlay) {
            return;
        }

        sidebar.classList.toggle('-translate-x-full');
        overlay.classList.toggle('hidden');
    }

</script>


</body>
</html>