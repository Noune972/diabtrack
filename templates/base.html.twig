<!DOCTYPE html>
<html lang="fr">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        {% block title %}DiabTrack{% endblock %}
    </title>

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}

    {% if frankenphpHotReload %}

        <meta
            name="frankenphp-hot-reload:url"
            content="{{ frankenphpHotReload }}"
        >

        <script
            src="https://cdn.jsdelivr.net/npm/idiomorph">
        </script>

        <script
            src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm"
            type="module">
        </script>

    {% endif %}

</head>


<body class="min-h-screen bg-gray-50 text-gray-900">


{# ============================================================
   HEADER
   ============================================================ #}

<header class="flex w-full items-center justify-between bg-white px-6 py-4 shadow-sm lg:px-8">

    {% if app.user %}

        {# Logo #}

        <a
            href="{{ path('app_home') }}"
            class="flex items-center"
            aria-label="Retour à l'accueil DiabTrack"
        >

            <img
                src="{{ asset('images/logo.svg') }}"
                alt="Logo DiabTrack"
                class="h-16 w-auto"
            >

        </a>


        {# Bonjour utilisateur #}

        <div class="text-right">

            <p class="text-lg font-semibold text-gray-600 lg:text-xl">
                Bonjour
            </p>

            <h2 class="text-2xl font-extrabold leading-tight text-[#48742C] lg:text-3xl">

                {{ app.user.firstname }}

            </h2>

        </div>

    {% endif %}

</header>



{# ============================================================
   CONTENU (sidebar + contenu principal côte à côte)
   ============================================================ #}

<div class="flex min-h-screen">

    {% if app.user %}

        {# ========================================================
        SIDEBAR
        ======================================================== #}

        <aside
            class="hidden w-72 shrink-0 bg-[#48742C] lg:flex lg:flex-col"
        >

            {# Navigation principale #}

            <nav class="flex-1 px-4 py-7">

                <p class="mb-5 px-4 text-xs font-bold uppercase tracking-widest text-green-100/70">
                    Navigation
                </p>


                {# ACCUEIL #}

                <a
                    href="{{ path('app_home') }}"
                    class="mb-2 flex items-center gap-4 rounded-2xl px-5 py-4 text-lg font-semibold text-green-50 transition hover:bg-white/10 hover:text-white
                    {{ app.request.attributes.get('_route') == 'app_home'
                        ? 'bg-white/15 text-white'
                        : '' }}"
                >

                    <img
                        src="{{ asset('images/home.png') }}"
                        alt=""
                        class="h-7 w-7"
                    >

                    <span>
                        Accueil
                    </span>

                </a>



                {# DASHBOARD #}

                <a
                    href="{{ path('app_dashboard') }}"
                    class="mb-2 flex items-center gap-4 rounded-2xl px-5 py-4 text-lg font-semibold text-green-50 transition hover:bg-white/10 hover:text-white
                    {{ app.request.attributes.get('_route') starts with 'app_dashboard'
                        ? 'bg-white/15 text-white'
                        : '' }}"
                >

                    <img
                        src="{{ asset('images/suivi.png') }}"
                        alt=""
                        class="h-7 w-7"
                    >

                    <span>
                        Dashboard
                    </span>

                </a>



                {# SECOURS #}

                <a
                    href="{{ path('app_emmergency') }}"
                    class="mb-2 flex items-center gap-4 rounded-2xl px-5 py-4 text-lg font-semibold text-green-50 transition hover:bg-white/10 hover:text-white
                    {{ app.request.attributes.get('_route') == 'app_emmergency'
                        ? 'bg-white/15 text-white'
                        : '' }}"
                >

                    <img
                        src="{{ asset('images/sos.png') }}"
                        alt=""
                        class="h-7 w-7"
                    >

                    <span>
                        Secours
                    </span>

                </a>



                {# BLOG #}

                <a
                    href="{{ path('app_blog_index') }}"
                    class="mb-2 flex items-center gap-4 rounded-2xl px-5 py-4 text-lg font-semibold text-green-50 transition hover:bg-white/10 hover:text-white
                    {{ app.request.attributes.get('_route') starts with 'app_blog'
                        ? 'bg-white/15 text-white'
                        : '' }}"
                >

                    <img
                        src="{{ asset('images/blog.png') }}"
                        alt=""
                        class="h-7 w-7"
                    >

                    <span>
                        Blog
                    </span>

                </a>



                {# RAPPEL #}

                <a
                    href="{{ path('app_emmergency') }}"
                    class="mb-2 flex items-center gap-4 rounded-2xl px-5 py-4 text-lg font-semibold text-green-50 transition hover:bg-white/10 hover:text-white"
                >

                    <img
                        src="{{ asset('images/rappel.png') }}"
                        alt=""
                        class="h-7 w-7"
                    >

                    <span>
                        Rappel
                    </span>

                </a>



                {# FORUM #}

                <a
                    href="{{ path('app_meal_new') }}"
                    class="mb-2 flex items-center gap-4 rounded-2xl px-5 py-4 text-lg font-semibold text-green-50 transition hover:bg-white/10 hover:text-white"
                >

                    <img
                        src="{{ asset('images/forum.png') }}"
                        alt=""
                        class="h-7 w-7"
                    >

                    <span>
                        Forum
                    </span>

                </a>



                {# =================================================
                ESPACE ADMINISTRATEUR
                ================================================= #}

                {% if is_granted('ROLE_ADMIN') %}

                    <div class="my-6 border-t border-white/10"></div>

                    <p class="mb-3 px-4 text-xs font-bold uppercase tracking-widest text-green-100/70">
                        Administration
                    </p>


                    {# ADMINISTRATION #}

                    <a
                        href="{{ path('app_admin') }}"
                        class="mb-2 flex items-center gap-4 rounded-2xl px-5 py-4 text-lg font-semibold text-green-50 transition hover:bg-white/10 hover:text-white
                        {{ app.request.attributes.get('_route') starts with 'app_admin'
                            and not (app.request.attributes.get('_route') starts with 'app_admin_user')
                            ? 'bg-white/15 text-white'
                            : '' }}"
                    >

                        <span class="text-2xl">
                            ⚙️
                        </span>

                        <span>
                            Administration
                        </span>

                    </a>


                    {# GÉRER LES UTILISATEURS #}

                    <a
                        href="{{ path('app_admin_user') }}"
                        class="mb-2 flex items-center gap-4 rounded-2xl px-5 py-4 text-lg font-semibold text-green-50 transition hover:bg-white/10 hover:text-white
                        {{ app.request.attributes.get('_route') starts with 'app_admin_user'
                            ? 'bg-white/15 text-white'
                            : '' }}"
                    >

                        <span class="text-2xl">
                            👥
                        </span>

                        <span>
                            Gérer les utilisateurs
                        </span>

                    </a>

                {% endif %}

            </nav>



            {# ====================================================
            BAS DE SIDEBAR
            ==================================================== #}

            <div class="border-t border-white/10 px-4 py-5">


                {# PROFIL #}

                <a
                    href="{{ path('app_account_delete') }}"
                    class="mb-2 flex items-center gap-4 rounded-2xl px-5 py-4 text-lg font-semibold text-green-50 transition hover:bg-white/10 hover:text-white"
                >

                    <img
                        src="{{ asset('images/profil.png') }}"
                        alt=""
                        class="h-7 w-7"
                    >

                    <span>
                        Profil
                    </span>

                </a>



                {# DÉCONNEXION #}

                <a
                    href="{{ path('app_logout') }}"
                    class="flex items-center gap-4 rounded-2xl px-5 py-4 text-lg font-semibold text-green-50 transition hover:bg-white/10 hover:text-white"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-7 w-7"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2"
                    >

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                        />

                    </svg>

                    <span>
                        Déconnexion
                    </span>

                </a>

            </div>

        </aside>

    {% endif %}


    {# ========================================================
        CONTENU PRINCIPAL
        ======================================================== #}

    <main class="min-w-0 flex-1">

        {% block body %}
        {% endblock %}

    </main>

</div>


</body>

</html>