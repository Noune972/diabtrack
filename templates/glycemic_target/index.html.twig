{% extends 'base.html.twig' %}

{% block title %}Mes objectifs glycémiques | DiabTrack{% endblock %}

{% block body %}

<div class="min-h-screen bg-[#F5F9FC]">

    {# HERO #}
    <section class="relative overflow-hidden bg-gradient-to-br from-[#102A43] via-[#0C4A6E] to-[#0F766E]">

        <div class="absolute -right-24 -top-32 h-96 w-96 rounded-full bg-cyan-300/10 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-teal-300/10 blur-3xl"></div>

        <div class="relative mx-auto max-w-5xl px-6 py-12 lg:px-8">

            <a
                href="{{ path('app_dashboard') }}"
                class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-cyan-100 transition hover:text-white"
            >
                ← Retour au tableau de bord
            </a>

            <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-cyan-100 ring-1 ring-white/10">
                🎯 Suivi personnalisé
            </div>

            <h1 class="mt-5 text-4xl font-black tracking-tight text-white sm:text-5xl">
                Mes objectifs
                <span class="text-cyan-300">glycémiques</span>
            </h1>

            <p class="mt-4 max-w-2xl text-sm leading-6 text-cyan-50/80 sm:text-base">
                Enregistrez les plages glycémiques adaptées à votre suivi
                afin de mieux contextualiser vos mesures.
            </p>

        </div>

    </section>


    <main class="mx-auto max-w-5xl px-6 py-10 lg:px-8">

        {# FLASH #}
        {% for message in app.flashes('success') %}
            <div class="mb-7 flex items-center gap-4 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-800">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-emerald-100 font-black">
                    ✓
                </div>

                <p class="text-sm font-bold">
                    {{ message }}
                </p>
            </div>
        {% endfor %}


        <div class="grid gap-7 lg:grid-cols-[1fr_300px]">

            {# FORMULAIRE #}
            <section class="rounded-[28px] border border-slate-200 bg-white p-6 shadow-sm md:p-8">

                <div class="mb-8">
                    <p class="text-xs font-black uppercase tracking-[0.15em] text-teal-600">
                        Plages personnalisées
                    </p>

                    <h2 class="mt-2 text-2xl font-black text-[#102A43]">
                        Définir mes objectifs
                    </h2>

                    <p class="mt-2 text-sm leading-6 text-slate-500">
                        Toutes les valeurs sont exprimées en g/L.
                    </p>
                </div>


                {{ form_start(form) }}

                <div class="space-y-7">

                    {# À JEUN #}
                    <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5">

                        <div class="mb-5 flex items-center gap-3">
                            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-cyan-100 text-xl">
                                🌅
                            </span>

                            <div>
                                <h3 class="font-black text-[#102A43]">
                                    À jeun / avant repas
                                </h3>

                                <p class="text-xs text-slate-400">
                                    Plage souhaitée avant de manger
                                </p>
                            </div>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">

                            <div>
                                <label class="mb-2 block text-xs font-black uppercase tracking-wider text-slate-500">
                                    Minimum
                                </label>

                                {{ form_widget(form.fastingMin, {
                                    attr: {
                                        class: 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-[#102A43] outline-none focus:border-teal-400 focus:ring-4 focus:ring-teal-100'
                                    }
                                }) }}

                                <div class="mt-1 text-xs text-red-600">
                                    {{ form_errors(form.fastingMin) }}
                                </div>
                            </div>

                            <div>
                                <label class="mb-2 block text-xs font-black uppercase tracking-wider text-slate-500">
                                    Maximum
                                </label>

                                {{ form_widget(form.fastingMax, {
                                    attr: {
                                        class: 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-[#102A43] outline-none focus:border-teal-400 focus:ring-4 focus:ring-teal-100'
                                    }
                                }) }}

                                <div class="mt-1 text-xs text-red-600">
                                    {{ form_errors(form.fastingMax) }}
                                </div>
                            </div>

                        </div>

                    </div>


                    {# APRÈS REPAS #}
                    <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5">

                        <div class="mb-5 flex items-center gap-3">
                            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-xl">
                                🍽️
                            </span>

                            <div>
                                <h3 class="font-black text-[#102A43]">
                                    Après repas
                                </h3>

                                <p class="text-xs text-slate-400">
                                    Plage souhaitée après avoir mangé
                                </p>
                            </div>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">

                            <div>
                                <label class="mb-2 block text-xs font-black uppercase tracking-wider text-slate-500">
                                    Minimum
                                </label>

                                {{ form_widget(form.postMealMin, {
                                    attr: {
                                        class: 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-[#102A43] outline-none focus:border-teal-400 focus:ring-4 focus:ring-teal-100'
                                    }
                                }) }}

                                <div class="mt-1 text-xs text-red-600">
                                    {{ form_errors(form.postMealMin) }}
                                </div>
                            </div>

                            <div>
                                <label class="mb-2 block text-xs font-black uppercase tracking-wider text-slate-500">
                                    Maximum
                                </label>

                                {{ form_widget(form.postMealMax, {
                                    attr: {
                                        class: 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-[#102A43] outline-none focus:border-teal-400 focus:ring-4 focus:ring-teal-100'
                                    }
                                }) }}

                                <div class="mt-1 text-xs text-red-600">
                                    {{ form_errors(form.postMealMax) }}
                                </div>
                            </div>

                        </div>

                    </div>


                    {# COUCHER #}
                    <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5">

                        <div class="mb-5 flex items-center gap-3">
                            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-100 text-xl">
                                🌙
                            </span>

                            <div>
                                <h3 class="font-black text-[#102A43]">
                                    Au coucher
                                </h3>

                                <p class="text-xs text-slate-400">
                                    Plage souhaitée avant de dormir
                                </p>
                            </div>
                        </div>

                        <div class="grid gap-4 sm:grid-cols-2">

                            <div>
                                <label class="mb-2 block text-xs font-black uppercase tracking-wider text-slate-500">
                                    Minimum
                                </label>

                                {{ form_widget(form.bedtimeMin, {
                                    attr: {
                                        class: 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-[#102A43] outline-none focus:border-teal-400 focus:ring-4 focus:ring-teal-100'
                                    }
                                }) }}

                                <div class="mt-1 text-xs text-red-600">
                                    {{ form_errors(form.bedtimeMin) }}
                                </div>
                            </div>

                            <div>
                                <label class="mb-2 block text-xs font-black uppercase tracking-wider text-slate-500">
                                    Maximum
                                </label>

                                {{ form_widget(form.bedtimeMax, {
                                    attr: {
                                        class: 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-[#102A43] outline-none focus:border-teal-400 focus:ring-4 focus:ring-teal-100'
                                    }
                                }) }}

                                <div class="mt-1 text-xs text-red-600">
                                    {{ form_errors(form.bedtimeMax) }}
                                </div>
                            </div>

                        </div>

                    </div>


                    <div class="text-sm text-red-600">
                        {{ form_errors(form) }}
                    </div>


                    <button
                        type="submit"
                        class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-teal-500 to-cyan-500 px-6 py-4 text-sm font-black text-white shadow-lg shadow-teal-500/20 transition hover:-translate-y-0.5 hover:shadow-xl"
                    >
                        💾 Enregistrer mes objectifs
                    </button>

                </div>

                {{ form_end(form) }}

            </section>


            {# INFORMATIONS #}
            <aside class="space-y-5">

                <div class="rounded-[24px] bg-[#102A43] p-6 text-white shadow-sm">

                    <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-white/10 text-xl">
                        🎯
                    </div>

                    <h3 class="mt-4 text-sm font-black">
                        Des objectifs personnels
                    </h3>

                    <p class="mt-2 text-xs leading-6 text-slate-300">
                        Ces plages seront utilisées par DiabTrack pour
                        contextualiser vos mesures selon le moment où elles
                        ont été réalisées.
                    </p>

                </div>


                <div class="rounded-[24px] border border-amber-200 bg-amber-50 p-6">

                    <div class="text-xl">
                        🩺
                    </div>

                    <h3 class="mt-3 text-sm font-black text-amber-900">
                        Important
                    </h3>

                    <p class="mt-2 text-xs leading-6 text-amber-800/80">
                        Les objectifs glycémiques peuvent varier selon votre
                        situation. Utilisez les valeurs définies avec votre
                        professionnel de santé.
                    </p>

                </div>


                <a
                    href="{{ path('app_blood_sugar_index') }}"
                    class="block rounded-[24px] border border-cyan-100 bg-cyan-50 p-5 transition hover:bg-cyan-100/60"
                >
                    <p class="text-xs font-black uppercase tracking-wider text-cyan-700">
                        💧 Ma glycémie
                    </p>

                    <p class="mt-2 text-xs leading-5 text-cyan-700/70">
                        Consulter mes mesures →
                    </p>
                </a>

            </aside>

        </div>

    </main>

</div>

{% endblock %}