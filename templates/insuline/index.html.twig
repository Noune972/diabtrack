{% extends 'base.html.twig' %}

{% block title %}Mon insuline - DiabTrack{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#F5F9FC]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12">

        {# ===================== EN-TÊTE ===================== #}
        <div class="mb-8">
            <div class="flex items-center gap-2 text-sm font-semibold text-cyan-700 mb-3">
                <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                Traitement & insuline
            </div>

            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#102A43]">
                Mon insuline
            </h1>

            <p class="mt-2 text-gray-500 max-w-2xl">
                Enregistrez vos injections d'insuline et retrouvez facilement
                l'historique de vos doses.
            </p>
        </div>


        {# ===================== FLASH ===================== #}
        {% for message in app.flashes('success') %}
            <div class="mb-6 flex items-start gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-emerald-800">

                <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-emerald-100">
                    <svg class="h-4 w-4"
                         fill="none"
                         stroke="currentColor"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 13l4 4L19 7"/>
                    </svg>
                </div>

                <div>
                    <p class="font-bold">Injection enregistrée</p>
                    <p class="mt-0.5 text-sm">{{ message }}</p>
                </div>
            </div>
        {% endfor %}


        {# ===================== CONTENU ===================== #}
        <div class="grid lg:grid-cols-[0.9fr_1.25fr] gap-7 items-start mb-10">

            {# ===================== VISUEL ===================== #}
            <div class="space-y-5">

                <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#102A43] to-[#164E63] shadow-lg">

                    <div class="flex h-80 lg:h-[430px] items-center justify-center p-8">

                        <div class="absolute top-6 left-6">
                            <span class="inline-flex rounded-full bg-white/15 backdrop-blur-sm px-3 py-1 text-xs font-bold text-white">
                                SUIVI DU TRAITEMENT
                            </span>
                        </div>

                        <div class="absolute h-64 w-64 rounded-full bg-cyan-400/10 blur-2xl"></div>

                        <img
                            src="{{ asset('images/insuinsu.png') }}"
                            alt="Illustration insuline"
                            class="relative z-10 h-52 w-52 sm:h-60 sm:w-60 object-contain"
                        >

                    </div>

                    <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-[#102A43] to-transparent px-6 pb-6 pt-16">

                        <h2 class="text-2xl font-bold text-white">
                            Suivez vos injections
                        </h2>

                        <p class="mt-2 text-sm leading-relaxed text-blue-100">
                            Gardez une trace de votre type d'insuline,
                            de vos doses et de vos horaires d'injection.
                        </p>

                    </div>
                </div>


                {# ===================== INFORMATION ===================== #}
                <div class="rounded-2xl border border-cyan-100 bg-cyan-50 p-5">

                    <div class="flex gap-4">

                        <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-white shadow-sm">

                            <svg class="h-5 w-5 text-cyan-700"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>

                        </div>

                        <div>
                            <p class="font-bold text-[#102A43]">
                                Votre suivi
                            </p>

                            <p class="mt-1 text-sm leading-relaxed text-gray-600">
                                L'historique vous permet de retrouver rapidement
                                les injections que vous avez enregistrées.
                            </p>
                        </div>

                    </div>
                </div>

            </div>


            {# ===================== FORMULAIRE ===================== #}
            <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">

                <div class="border-b border-slate-100 px-6 py-6 sm:px-8">

                    <div class="flex items-center gap-4">

                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#102A43]">

                            <svg class="h-5 w-5 text-white"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M12 4v16m8-8H4"/>
                            </svg>

                        </div>

                        <div>
                            <h2 class="text-xl font-bold text-[#102A43]">
                                Ajouter une injection
                            </h2>

                            <p class="text-sm text-gray-500">
                                Renseignez les informations de votre injection.
                            </p>
                        </div>

                    </div>

                </div>


                {{ form_start(form, {
                    'attr': {
                        'class': 'p-6 sm:p-8',
                        'novalidate': 'novalidate'
                    }
                }) }}


                    {# ===================== DATE / HEURE ===================== #}
                    <div class="grid sm:grid-cols-2 gap-5 mb-6">

                        <div>
                            <label class="block text-sm font-bold text-[#102A43] mb-2">
                                Date
                            </label>

                            {{ form_widget(form.date, {
                                'attr': {
                                    'class': 'w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-gray-800 outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(form.date) }}
                            </div>
                        </div>


                        <div>
                            <label class="block text-sm font-bold text-[#102A43] mb-2">
                                Heure
                            </label>

                            {{ form_widget(form.hour, {
                                'attr': {
                                    'class': 'w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-gray-800 outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(form.hour) }}
                            </div>
                        </div>

                    </div>


                    {# ===================== TYPE INSULINE ===================== #}
                    <div class="mb-6">

                        <label class="block text-sm font-bold text-[#102A43] mb-2">
                            Type d'insuline
                        </label>

                        {{ form_widget(form.type_of_insuline, {
                            'attr': {
                                'class': 'w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-gray-800 outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                            }
                        }) }}

                        <p class="mt-2 text-xs text-gray-400">
                            Sélectionnez le type d'insuline utilisé pour cette injection.
                        </p>

                        <div class="mt-1 text-sm text-red-600">
                            {{ form_errors(form.type_of_insuline) }}
                        </div>

                    </div>


                    {# ===================== DOSE ===================== #}
                    <div class="mb-8">

                        <label class="block text-sm font-bold text-[#102A43] mb-2">
                            Dose
                        </label>

                        <div class="relative">

                            {{ form_widget(form.dose, {
                                'attr': {
                                    'class': 'w-full rounded-xl border border-slate-300 bg-white px-4 py-3 pr-16 text-gray-800 outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100',
                                    'placeholder': 'Ex. 8'
                                }
                            }) }}

                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-sm font-bold text-gray-400">
                                U
                            </span>

                        </div>

                        <div class="mt-1 text-sm text-red-600">
                            {{ form_errors(form.dose) }}
                        </div>

                    </div>


                    {# ===================== BOUTONS ===================== #}
                    <div class="flex flex-col-reverse sm:flex-row gap-3">

                        <a
                            href="{{ path('app_home') }}"
                            class="flex items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-3.5 font-bold text-gray-600 transition hover:bg-slate-50"
                        >
                            Retour
                        </a>

                        <button
                            type="submit"
                            class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#102A43] px-6 py-3.5 font-bold text-white shadow-sm transition hover:bg-[#163A5F] focus:ring-4 focus:ring-blue-100"
                        >

                            <svg class="h-5 w-5"
                                 fill="none"
                                 stroke="currentColor"
                                 viewBox="0 0 24 24">
                                <path stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M5 13l4 4L19 7"/>
                            </svg>

                            Enregistrer l'injection

                        </button>

                    </div>

                {{ form_end(form) }}

            </div>
        </div>


        {# ========================================================== #}
        {# HISTORIQUE                                                 #}
        {# ========================================================== #}

        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">

            <div class="flex flex-col gap-4 border-b border-slate-100 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">

                <div class="flex items-center gap-3">

                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-50">

                        <svg class="h-5 w-5 text-cyan-700"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>

                    </div>

                    <div>
                        <h2 class="font-bold text-[#102A43]">
                            Historique récent
                        </h2>

                        <p class="text-sm text-gray-500">
                            Vos dernières injections enregistrées.
                        </p>
                    </div>

                </div>


                {% if insulines is not empty %}

                    <span class="inline-flex w-fit rounded-full bg-cyan-50 px-3 py-1 text-xs font-bold text-cyan-700">

                        {{ insulines|length }}

                        injection{% if insulines|length > 1 %}s{% endif %}

                    </span>

                {% endif %}

            </div>


            {% if insulines is empty %}

                {# ===================== VIDE ===================== #}
                <div class="px-6 py-14 text-center">

                    <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-cyan-50">

                        <svg class="h-8 w-8 text-cyan-700"
                             fill="none"
                             stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M12 6v6l4 2"/>
                        </svg>

                    </div>

                    <h3 class="font-bold text-[#102A43]">
                        Aucune injection enregistrée
                    </h3>

                    <p class="mt-2 text-sm text-gray-500">
                        Votre prochaine injection apparaîtra ici après son enregistrement.
                    </p>

                </div>

            {% else %}

                <div class="divide-y divide-slate-100">

                    {% for insuline in insulines %}

                        <a
                            href="{{ path('app_insuline_show', {id: insuline.id}) }}"
                            class="group flex flex-col gap-4 p-5 transition hover:bg-slate-50 sm:flex-row sm:items-center sm:justify-between"
                        >

                            <div class="flex items-center gap-4">

                                {# Icône #}
                                <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl bg-cyan-50 transition group-hover:bg-cyan-100">

                                    <svg class="h-6 w-6 text-cyan-700"
                                         fill="none"
                                         stroke="currentColor"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                                    </svg>

                                </div>


                                <div>

                                    <p class="font-bold text-[#102A43]">
                                        Insuline {{ insuline.typeOfInsuline.value|default(insuline.typeOfInsuline) }}
                                    </p>


                                    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500">

                                        <span>
                                            {{ insuline.date|date('d/m/Y') }}
                                        </span>

                                        <span class="hidden sm:inline text-gray-300">
                                            •
                                        </span>

                                        <span>
                                            {{ insuline.hour }}h
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <div class="flex items-center justify-between gap-5 pl-16 sm:pl-0">

                                <div class="text-right">

                                    <p class="text-xl font-extrabold text-cyan-700">
                                        {{ insuline.dose }}
                                    </p>

                                    <p class="text-xs font-bold text-gray-400">
                                        unités
                                    </p>

                                </div>


                                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-gray-400 transition group-hover:bg-[#102A43] group-hover:text-white">

                                    <svg class="h-4 w-4"
                                         fill="none"
                                         stroke="currentColor"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M9 5l7 7-7 7"/>
                                    </svg>

                                </div>

                            </div>

                        </a>

                    {% endfor %}

                </div>

            {% endif %}

        </div>

    </div>
</div>
{% endblock %}