{% extends 'base.html.twig' %}

{% block title %}Mon insuline - DiabTrack{% endblock %}

{% block body %}
<section class="min-h-screen bg-white py-10 px-4">
    <div class="max-w-md mx-auto">

        <a href="{{ path('app_home') }}" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-6">
            &larr; Retour au tableau de bord
        </a>

        <h1 class="text-3xl mb-8">
            <span class="font-extrabold italic text-gray-900">AJOUTER</span>
            <span class="font-extrabold italic text-green-700">INSULINE</span>
        </h1>

    
        <div class="bg-teal-50 rounded-2xl flex items-center justify-center mb-8 h-56">
            <img src="{{ asset('images/insuinsu.png') }}"
                 alt="Illustration seringue d'insuline"
                 class="h-40 w-40 object-contain">
        </div>

        {% for message in app.flashes('success') %}
            <div class="bg-green-50 text-green-700 border border-green-200 rounded-xl px-4 py-3 mb-6 text-sm">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'flex flex-col gap-6', 'novalidate': 'novalidate'}}) }}

            <div>
                <label class="block text-gray-800 font-medium mb-2">Date</label>
                {{ form_widget(form.date) }}
                {{ form_errors(form.date) }}
            </div>

            <div>
                <label class="block text-gray-800 font-medium mb-2">Heure</label>
                {{ form_widget(form.hour) }}
                {{ form_errors(form.hour) }}
            </div>

            <div>
                <label class="block text-gray-800 font-medium mb-2">Lente ou rapide</label>
                {{ form_widget(form.type_of_insuline) }}
                {{ form_errors(form.type_of_insuline) }}
            </div>

            <div>
                <label class="block text-gray-800 font-medium mb-2">Dose</label>
                {{ form_widget(form.dose) }}
                {{ form_errors(form.dose) }}
            </div>

            <button type="submit"
                    class="w-full bg-blue-900 hover:bg-blue-800 text-white font-semibold py-3 rounded-xl transition">
                Envoyer
            </button>

        {{ form_end(form) }}

        {# ---------------------------------------------------- #}
        {# HISTORIQUE #}
        {# ---------------------------------------------------- #}
        <h2 class="text-lg font-semibold text-gray-800 mt-12 mb-4">Historique récent</h2>

        {% if insulines is empty %}
            <p class="text-gray-500 text-sm">Aucune injection enregistrée pour le moment.</p>
        {% else %}
            <div class="flex flex-col gap-3">
                {% for insuline in insulines %}
                    <a href="{{ path('app_insuline_show', {id: insuline.id}) }}"
                       class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 flex items-center justify-between hover:border-amber-300 transition">
                        <div>
                            <p class="font-medium text-gray-800">
                                Insuline {{ insuline.typeOfInsuline.value|default(insuline.typeOfInsuline) }}
                            </p>
                            <p class="text-sm text-gray-500">
                                {{ insuline.date|date('d/m/Y') }} à {{ insuline.hour }}h
                            </p>
                        </div>
                        <span class="text-lg font-semibold text-amber-700">
                            {{ insuline.dose }} U
                        </span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
{% endblock %}