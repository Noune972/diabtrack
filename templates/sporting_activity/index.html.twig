{% extends 'base.html.twig' %}

{% block title %}Mon activité physique - DiabTrack{% endblock %}

{% block body %}
<section class="min-h-screen bg-white py-10 px-4">
    <div class="max-w-md mx-auto">

        

        <h1 class="text-3xl mb-8">
            <span class="font-extrabold italic text-gray-900">AJOUT</span>
            <span class="font-extrabold italic text-green-700">ACTIVITÉS</span>
        </h1>

        
        <div class=" overflow-hidden">
            <img src="{{ asset('images/sporting.png') }}"
                 alt="Illustration activité physique"
                 class="w-full h-full object-cover">
        </div>

        {% for message in app.flashes('success') %}
            <div class="bg-green-50 text-green-700 border border-green-200 rounded-xl px-4 py-3 mb-6 text-sm">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'flex flex-col gap-6', 'novalidate': 'novalidate'}}) }}

            <div>
                <label class="block text-gray-800 font-medium mb-2">Date</label>
                {{ form_widget(form.date) }}
                {{ form_errors(form.date) }}
            </div>

            <div>
                <label class="block text-gray-800 font-medium mb-2">Heure</label>
                {{ form_widget(form.hour) }}
                {{ form_errors(form.hour) }}
            </div>

            <div>
                {{ form_label(form.duration) }}
                {{ form_widget(form.duration) }}
                {{ form_errors(form.duration) }}
            </div>

            <div>
                <label class="block text-gray-800 font-medium mb-2">Activité</label>
                {{ form_widget(form.type_of_activity) }}
                {{ form_errors(form.type_of_activity) }}
            </div>

            <div>
                <label class="block text-gray-800 font-medium mb-2">Calories</label>
                {{ form_widget(form.calories) }}
                {{ form_errors(form.calories) }}
            </div>

            <button type="submit"
                    class="w-full bg-blue-900 hover:bg-blue-800 text-white font-semibold py-3 rounded-xl transition">
                Envoyer
            </button>

        {{ form_end(form) }}

        {# ---------------------------------------------------- #}
        {# HISTORIQUE #}
        {# ---------------------------------------------------- #}
        <h2 class="text-lg font-semibold text-gray-800 mt-12 mb-4">Historique récent</h2>

        {% if sporting_activities is empty %}
            <p class="text-gray-500 text-sm">Aucune activité enregistrée pour le moment.</p>
        {% else %}
            <div class="flex flex-col gap-3">
                {% for activity in sporting_activities %}
                    <a href="{{ path('app_sporting_activity_show', {id: activity.id}) }}"
                       class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 flex items-center justify-between hover:border-green-300 transition">
                        <div>
                            <p class="font-medium text-gray-800">
                                {{ activity.typeOfActivity|capitalize }}
                            </p>
                            <p class="text-sm text-gray-500">
                                {{ activity.date|date('d/m/Y') }} à {{ activity.hour|date('H:i') }} — {{ activity.duration }} min
                            </p>
                        </div>
                        <span class="text-lg font-semibold text-green-700">
                            {{ activity.calories }} kcal
                        </span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
{% endblock %}