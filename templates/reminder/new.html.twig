{% extends 'base.html.twig' %}

{% block title %}Nouveau rappel - DiabTrack{% endblock %}

{% block body %}

<div class="min-h-screen bg-[#F5F9FC]">

    {# ================= HERO ================= #}
    <section class="relative overflow-hidden bg-gradient-to-br from-[#0F2D46] via-[#0C4A6E] to-[#0F766E]">

        <div class="absolute -right-24 -top-32 h-96 w-96 rounded-full bg-cyan-300/10 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-teal-300/10 blur-3xl"></div>

        <div class="relative mx-auto max-w-7xl px-6 py-12 lg:px-8">

            <a
                href="{{ path('app_reminder_index') }}"
                class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-cyan-100 transition hover:text-white"
            >
                ← Mes rappels
            </a>

            <div class="max-w-2xl">

                <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-cyan-100 ring-1 ring-white/10">
                    <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
                    Nouveau rappel
                </div>

                <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl">
                    Programmer un rappel
                </h1>

                <p class="mt-4 max-w-xl text-base leading-7 text-cyan-50/80">
                    Choisissez le type de suivi, sa fréquence et l'heure
                    à laquelle vous souhaitez le retrouver dans votre planning.
                </p>

            </div>

        </div>

    </section>


    {# ================= CONTENU ================= #}
    <main class="mx-auto max-w-7xl px-6 py-10 lg:px-8">

        <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_340px]">

            {# ================= FORMULAIRE ================= #}
            <section class="rounded-[30px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70 sm:p-8">

                <div class="mb-7">

                    <div class="flex items-center gap-4">

                        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-cyan-50 text-2xl">
                            🔔
                        </div>

                        <div>
                            <p class="text-xs font-black uppercase tracking-[0.18em] text-teal-600">
                                Configuration
                            </p>

                            <h2 class="mt-1 text-2xl font-black text-[#102A43]">
                                Mon nouveau rappel
                            </h2>
                        </div>

                    </div>

                    <p class="mt-4 text-sm leading-6 text-slate-500">
                        Les informations ci-dessous vous permettront d'organiser
                        votre suivi quotidien dans DiabTrack.
                    </p>

                </div>

                {{ include('reminder/_form.html.twig', {
                    button_label: 'Créer le rappel'
                }) }}

            </section>


            {# ================= AIDE ================= #}
            <aside class="space-y-5">

                <section class="rounded-[28px] bg-[#102A43] p-6 text-white shadow-lg">

                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white/10 text-2xl">
                        💡
                    </div>

                    <h2 class="mt-5 text-xl font-black">
                        À quoi servent les rappels ?
                    </h2>

                    <p class="mt-3 text-sm leading-6 text-slate-300">
                        Ils vous aident à organiser les actions importantes
                        de votre suivi au fil de la journée.
                    </p>

                </section>


                <section class="rounded-[28px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70">

                    <p class="text-xs font-black uppercase tracking-[0.18em] text-teal-600">
                        Exemples
                    </p>

                    <div class="mt-5 space-y-4">

                        <div class="flex items-center gap-3">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-rose-50">
                                🩸
                            </span>

                            <div>
                                <p class="text-sm font-black text-[#102A43]">
                                    Glycémie
                                </p>
                                <p class="text-xs text-slate-400">
                                    Réveil, repas ou coucher
                                </p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-50">
                                💉
                            </span>

                            <div>
                                <p class="text-sm font-black text-[#102A43]">
                                    Insuline
                                </p>
                                <p class="text-xs text-slate-400">
                                    Lente, rapide ou repas
                                </p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-sky-50">
                                🏃
                            </span>

                            <div>
                                <p class="text-sm font-black text-[#102A43]">
                                    Activité physique
                                </p>
                                <p class="text-xs text-slate-400">
                                    Sport ou marche
                                </p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-violet-50">
                                🩺
                            </span>

                            <div>
                                <p class="text-sm font-black text-[#102A43]">
                                    Suivi médical
                                </p>
                                <p class="text-xs text-slate-400">
                                    Examens et rendez-vous
                                </p>
                            </div>
                        </div>

                    </div>

                </section>


                <section class="rounded-[28px] border border-cyan-100 bg-cyan-50 p-5">

                    <div class="flex gap-3">

                        <span class="text-xl">ℹ️</span>

                        <p class="text-xs leading-5 text-slate-600">
                            Les rappels servent à organiser votre suivi personnel.
                            Pour les horaires de traitement ou les consignes médicales,
                            suivez les indications données par votre professionnel de santé.
                        </p>

                    </div>

                </section>

            </aside>

        </div>

    </main>

</div>

{% endblock %}