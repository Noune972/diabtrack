{% extends 'base.html.twig' %}

{% block title %}Détails du rappel - DiabTrack{% endblock %}

{% block body %}

{% set frequency_labels = {
    'daily': 'Tous les jours',
    'weekdays': 'Du lundi au vendredi',
    'weekly': 'Chaque semaine',
    'biweekly': 'Toutes les 2 semaines',
    'monthly': 'Chaque mois',
    'quarterly': 'Tous les 3 mois',
    'semiannual': 'Tous les 6 mois',
    'yearly': 'Chaque année',
    'once': 'Une seule fois'
} %}

<div class="min-h-screen bg-[#F5F9FC]">

    {# ================= HERO ================= #}
    <section class="relative overflow-hidden bg-gradient-to-br from-[#0F2D46] via-[#0C4A6E] to-[#0F766E]">

        <div class="absolute -right-24 -top-32 h-96 w-96 rounded-full bg-cyan-300/10 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-teal-300/10 blur-3xl"></div>

        <div class="relative mx-auto max-w-7xl px-6 py-12 lg:px-8">

            <a
                href="{{ path('app_reminder_index') }}"
                class="mb-6 inline-flex items-center gap-2 text-sm font-bold text-cyan-100 transition hover:text-white"
            >
                ← Mes rappels
            </a>

            <div class="flex flex-col gap-7 lg:flex-row lg:items-end lg:justify-between">

                <div class="max-w-2xl">

                    <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-cyan-100 ring-1 ring-white/10">
                        <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
                        Détails du rappel
                    </div>

                    <div class="flex items-center gap-4">

                        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-white/10 text-3xl ring-1 ring-white/10">
                            {{ reminder.type.icon }}
                        </div>

                        <div>
                            <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl">
                                {{ reminder.type.label }}
                            </h1>

                            <p class="mt-2 text-sm font-semibold text-cyan-100/80">
                                {{ reminder.type.category|capitalize }}
                            </p>
                        </div>

                    </div>

                </div>

                <a
                    href="{{ path('app_reminder_edit', {'id': reminder.id}) }}"
                    class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-6 py-3.5 text-sm font-black text-[#102A43] shadow-lg transition hover:-translate-y-0.5 hover:bg-cyan-50"
                >
                    ✏️ Modifier le rappel
                </a>

            </div>

        </div>

    </section>


    {# ================= CONTENU ================= #}
    <main class="mx-auto max-w-7xl px-6 py-10 lg:px-8">

        <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_340px]">

            {# ================= INFORMATIONS ================= #}
            <section class="rounded-[30px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70 sm:p-8">

                <div class="mb-8">

                    <p class="text-xs font-black uppercase tracking-[0.18em] text-teal-600">
                        Configuration
                    </p>

                    <h2 class="mt-2 text-2xl font-black text-[#102A43]">
                        Informations du rappel
                    </h2>

                    <p class="mt-2 text-sm text-slate-500">
                        Retrouvez ici les paramètres actuellement enregistrés.
                    </p>

                </div>


                <div class="grid gap-5 sm:grid-cols-2">

                    {# TYPE #}
                    <div class="rounded-[24px] bg-slate-50 p-5">

                        <div class="flex items-center gap-4">

                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white text-2xl shadow-sm">
                                {{ reminder.type.icon }}
                            </div>

                            <div>
                                <p class="text-[10px] font-black uppercase tracking-[0.16em] text-slate-400">
                                    Type
                                </p>

                                <p class="mt-1 font-black text-[#102A43]">
                                    {{ reminder.type.label }}
                                </p>
                            </div>

                        </div>

                    </div>


                    {# HEURE #}
                    <div class="rounded-[24px] bg-cyan-50 p-5">

                        <div class="flex items-center gap-4">

                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white text-2xl shadow-sm">
                                🕐
                            </div>

                            <div>
                                <p class="text-[10px] font-black uppercase tracking-[0.16em] text-cyan-600">
                                    Heure
                                </p>

                                <p class="mt-1 text-2xl font-black text-[#102A43]">
                                    {{ reminder.time ? reminder.time|date('H:i') : '--:--' }}
                                </p>
                            </div>

                        </div>

                    </div>


                    {# FRÉQUENCE #}
                    <div class="rounded-[24px] bg-slate-50 p-5">

                        <div class="flex items-center gap-4">

                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white text-xl shadow-sm">
                                🔁
                            </div>

                            <div>
                                <p class="text-[10px] font-black uppercase tracking-[0.16em] text-slate-400">
                                    Fréquence
                                </p>

                                <p class="mt-1 font-black text-[#102A43]">
                                    {{ frequency_labels[reminder.frequency]|default(reminder.frequency) }}
                                </p>
                            </div>

                        </div>

                    </div>


                    {# CATÉGORIE #}
                    <div class="rounded-[24px] bg-teal-50 p-5">

                        <div class="flex items-center gap-4">

                            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white text-xl shadow-sm">
                                📋
                            </div>

                            <div>
                                <p class="text-[10px] font-black uppercase tracking-[0.16em] text-teal-600">
                                    Catégorie
                                </p>

                                <p class="mt-1 font-black text-[#102A43]">
                                    {{ reminder.type.category|capitalize }}
                                </p>
                            </div>

                        </div>

                    </div>

                </div>


                {# ACTIONS #}
                <div class="mt-8 flex flex-col gap-3 border-t border-slate-100 pt-6 sm:flex-row">

                    <a
                        href="{{ path('app_reminder_index') }}"
                        class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-3 text-sm font-black text-slate-600 transition hover:bg-slate-50"
                    >
                        ← Retour aux rappels
                    </a>

                    <a
                        href="{{ path('app_reminder_edit', {'id': reminder.id}) }}"
                        class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-teal-500 to-cyan-500 px-5 py-3 text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5"
                    >
                        ✏️ Modifier
                    </a>

                </div>

            </section>


            {# ================= COLONNE DROITE ================= #}
            <aside class="space-y-5">

                {# CARTE HEURE #}
                <section class="relative overflow-hidden rounded-[28px] bg-[#102A43] p-6 text-white shadow-lg">

                    <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-cyan-400/10"></div>

                    <div class="relative">

                        <p class="text-xs font-black uppercase tracking-[0.18em] text-cyan-300">
                            Heure programmée
                        </p>

                        <p class="mt-3 text-5xl font-black tracking-tight">
                            {{ reminder.time ? reminder.time|date('H:i') : '--:--' }}
                        </p>

                        <div class="mt-5 inline-flex rounded-full bg-white/10 px-4 py-2 text-xs font-bold text-cyan-50">
                            {{ frequency_labels[reminder.frequency]|default(reminder.frequency) }}
                        </div>

                    </div>

                </section>


                {# INFO #}
                <section class="rounded-[28px] border border-cyan-100 bg-cyan-50 p-6">

                    <div class="flex gap-4">

                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-xl shadow-sm">
                            ℹ️
                        </div>

                        <div>
                            <h3 class="font-black text-[#102A43]">
                                Mon suivi
                            </h3>

                            <p class="mt-2 text-xs leading-5 text-slate-600">
                                Vous pouvez modifier l'heure, le type ou la fréquence
                                de ce rappel à tout moment.
                            </p>
                        </div>

                    </div>

                </section>


                {# SUPPRESSION #}
                <section class="rounded-[28px] border border-red-100 bg-white p-6 shadow-sm">

                    <p class="text-xs font-black uppercase tracking-[0.18em] text-red-500">
                        Zone de suppression
                    </p>

                    <h3 class="mt-2 text-lg font-black text-[#102A43]">
                        Supprimer ce rappel
                    </h3>

                    <p class="mt-2 text-xs leading-5 text-slate-500">
                        Cette action supprimera définitivement ce rappel.
                    </p>

                    <div class="mt-5">
                        {{ include('reminder/_delete_form.html.twig') }}
                    </div>

                </section>

            </aside>

        </div>

    </main>

</div>

{% endblock %}