{% extends 'base.html.twig' %}

{% block title %}Mes rappels - DiabTrack{% endblock %}

{% block body %}

{% set frequency_labels = {
    'daily': 'Tous les jours',
    'weekdays': 'Du lundi au vendredi',
    'weekly': 'Chaque semaine',
    'biweekly': 'Toutes les 2 semaines',
    'monthly': 'Chaque mois',
    'quarterly': 'Tous les 3 mois',
    'semiannual': 'Tous les 6 mois',
    'yearly': 'Chaque année',
    'once': 'Une seule fois'
} %}

<div class="min-h-screen bg-[#F5F9FC]">

    {# ================= HERO ================= #}
    <section class="relative overflow-hidden bg-gradient-to-br from-[#0F2D46] via-[#0C4A6E] to-[#0F766E]">

        <div class="absolute -right-24 -top-32 h-96 w-96 rounded-full bg-cyan-300/10 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/3 h-96 w-96 rounded-full bg-teal-300/10 blur-3xl"></div>

        <div class="relative mx-auto max-w-7xl px-6 py-12 lg:px-8">

            <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">

                <div class="max-w-2xl">

                    <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.18em] text-cyan-100 ring-1 ring-white/10">
                        <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
                        Organisation quotidienne
                    </div>

                    <h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl">
                        Mes rappels
                    </h1>

                    <p class="mt-4 max-w-xl text-base leading-7 text-cyan-50/80">
                        Organisez vos mesures, traitements, activités et rendez-vous
                        pour retrouver facilement les moments importants de votre suivi.
                    </p>

                </div>

                <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">

                    <div class="rounded-2xl bg-white/10 px-6 py-4 backdrop-blur ring-1 ring-white/10">
                        <p class="text-xs font-bold uppercase tracking-wider text-cyan-200">
                            Rappels programmés
                        </p>

                        <p class="mt-1 text-4xl font-black text-white">
                            {{ reminders|length }}
                        </p>
                    </div>

                    <a href="{{ path('app_reminder_new') }}"
                       class="inline-flex items-center justify-center gap-2 rounded-2xl bg-white px-6 py-4 text-sm font-black text-[#102A43] shadow-lg transition hover:-translate-y-0.5 hover:bg-cyan-50">

                        <span class="text-lg">＋</span>
                        Nouveau rappel

                    </a>

                </div>

            </div>

        </div>

    </section>


    <main class="mx-auto max-w-7xl px-6 py-10 lg:px-8">

        {# ================= FLASH ================= #}

        {% for message in app.flashes('success') %}
            <div class="mb-6 flex items-center gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-bold text-emerald-700">
                <span>✓</span>
                {{ message }}
            </div>
        {% endfor %}


        {# ================= TITRE ================= #}

        <div class="mb-7 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">

            <div>
                <p class="text-xs font-black uppercase tracking-[0.2em] text-teal-600">
                    Mon planning
                </p>

                <h2 class="mt-1 text-3xl font-black tracking-tight text-[#102A43]">
                    Rappels programmés
                </h2>

                <p class="mt-2 text-sm text-slate-500">
                    Vos rappels sont classés par heure.
                </p>
            </div>

            {% if reminders is not empty %}
                <a href="{{ path('app_reminder_new') }}"
                   class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#102A43] px-5 py-3 text-sm font-black text-white transition hover:bg-[#163A5F]">

                    <span>＋</span>
                    Ajouter

                </a>
            {% endif %}

        </div>


        {% if reminders is empty %}

            {# ================= ÉTAT VIDE ================= #}

            <section class="rounded-[30px] border border-dashed border-slate-300 bg-white px-6 py-16 text-center shadow-sm">

                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-[24px] bg-cyan-50 text-4xl">
                    🔔
                </div>

                <h3 class="mt-6 text-2xl font-black text-[#102A43]">
                    Aucun rappel programmé
                </h3>

                <p class="mx-auto mt-3 max-w-lg text-sm leading-6 text-slate-500">
                    Créez votre premier rappel pour vos glycémies, votre insuline,
                    vos médicaments, votre activité physique ou vos rendez-vous.
                </p>

                <a href="{{ path('app_reminder_new') }}"
                   class="mt-7 inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-teal-500 to-cyan-500 px-6 py-3.5 text-sm font-black text-white shadow-lg transition hover:-translate-y-0.5">

                    <span>＋</span>
                    Créer mon premier rappel

                </a>

            </section>

        {% else %}

            {# ================= LISTE ================= #}

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">

                {% for reminder in reminders %}

                    <article class="group relative overflow-hidden rounded-[28px] bg-white p-6 shadow-sm ring-1 ring-slate-200/70 transition duration-300 hover:-translate-y-1 hover:shadow-xl">

                        <div class="absolute -right-12 -top-12 h-36 w-36 rounded-full bg-cyan-50"></div>

                        <div class="relative">

                            <div class="flex items-start justify-between gap-4">

                                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#F0FAFC] text-2xl">
                                    {{ reminder.type.icon }}
                                </div>

                                <div class="rounded-2xl bg-[#102A43] px-4 py-2 text-center text-white shadow-sm">

                                    <p class="text-[9px] font-black uppercase tracking-wider text-cyan-200">
                                        Heure
                                    </p>

                                    <p class="text-lg font-black">
                                        {{ reminder.time ? reminder.time|date('H:i') : '--:--' }}
                                    </p>

                                </div>

                            </div>


                            <div class="mt-6">

                                <span class="inline-flex rounded-full bg-teal-50 px-3 py-1 text-[10px] font-black uppercase tracking-wider text-teal-700">
                                    {{ reminder.type.category }}
                                </span>

                                <h3 class="mt-3 text-xl font-black leading-tight text-[#102A43]">
                                    {{ reminder.type.label }}
                                </h3>

                                <div class="mt-4 flex items-center gap-3 rounded-2xl bg-slate-50 px-4 py-3">

                                    <span class="text-lg">
                                        🔁
                                    </span>

                                    <div>
                                        <p class="text-[10px] font-black uppercase tracking-wider text-slate-400">
                                            Fréquence
                                        </p>

                                        <p class="text-sm font-bold text-slate-700">
                                            {{ frequency_labels[reminder.frequency]|default(reminder.frequency) }}
                                        </p>
                                    </div>

                                </div>

                            </div>


                            <div class="mt-6 flex gap-2 border-t border-slate-100 pt-5">

                                <a href="{{ path('app_reminder_show', {'id': reminder.id}) }}"
                                   class="flex-1 rounded-xl bg-slate-50 px-3 py-2.5 text-center text-xs font-black text-slate-600 transition hover:bg-slate-100">
                                    Détails
                                </a>

                                <a href="{{ path('app_reminder_edit', {'id': reminder.id}) }}"
                                   class="flex-1 rounded-xl bg-cyan-50 px-3 py-2.5 text-center text-xs font-black text-cyan-700 transition hover:bg-cyan-100">
                                    Modifier
                                </a>

                            </div>

                        </div>

                    </article>

                {% endfor %}

            </div>

        {% endif %}


        {# ================= INFO ================= #}

        <section class="relative mt-8 overflow-hidden rounded-[30px] bg-[#102A43] p-7 text-white shadow-xl lg:p-9">

            <div class="absolute -right-16 -top-20 h-64 w-64 rounded-full bg-teal-400/10 blur-2xl"></div>

            <div class="relative flex flex-col gap-5 md:flex-row md:items-center md:justify-between">

                <div class="flex items-start gap-5">

                    <div class="hidden h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/10 text-2xl sm:flex">
                        🔔
                    </div>

                    <div>

                        <p class="text-xs font-black uppercase tracking-[0.2em] text-cyan-300">
                            DiabTrack
                        </p>

                        <h2 class="mt-2 text-xl font-black sm:text-2xl">
                            Un suivi plus facile à organiser
                        </h2>

                        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-300">
                            Les rappels vous permettent de planifier les actions importantes
                            de votre suivi. Ils ne remplacent pas les recommandations de
                            votre équipe soignante.
                        </p>

                    </div>

                </div>

                <a href="{{ path('app_daily_journal') }}"
                   class="shrink-0 rounded-xl bg-white/10 px-5 py-3 text-sm font-black text-white ring-1 ring-white/10 transition hover:bg-white/20">
                    Voir ma journée →
                </a>

            </div>

        </section>

    </main>

</div>

{% endblock %}