<form
    method="post"
    action="{{ path('app_reminder_delete', {'id': reminder.id}) }}"
    onsubmit="return confirm('Voulez-vous vraiment supprimer ce rappel ? Cette action est définitive.');"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('delete' ~ reminder.id) }}"
    >

    <button
        type="submit"
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-red-200 bg-red-50 px-5 py-3 text-sm font-black text-red-600 transition hover:border-red-300 hover:bg-red-100"
    >
        <span>🗑️</span>
        Supprimer ce rappel
    </button>
</form>