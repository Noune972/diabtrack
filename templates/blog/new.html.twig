{% extends 'base.html.twig' %}

{% block title %}Nouvel article - DiabTrack{% endblock %}

{% block body %}
<section class="min-h-screen bg-white py-12 px-4">
    <div class="max-w-2xl mx-auto">

        <a href="{{ path('app_blog_index') }}" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-6">
            &larr; Retour au blog
        </a>

        <h1 class="text-3xl font-bold text-gray-800 mb-8">Nouvel article</h1>

        {{ form_start(form, {'attr': {'class': 'flex flex-col gap-6'}}) }}

            <div>
                {{ form_label(form.title, null, {'label_attr': {'class': 'block text-gray-800 font-medium mb-2'}}) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>

            <div>
                {{ form_label(form.content, null, {'label_attr': {'class': 'block text-gray-800 font-medium mb-2'}}) }}
                {{ form_widget(form.content) }}
                {{ form_errors(form.content) }}
            </div>

            <div>
                {{ form_label(form.category, null, {'label_attr': {'class': 'block text-gray-800 font-medium mb-2'}}) }}
                {{ form_widget(form.category) }}
                {{ form_errors(form.category) }}
            </div>

            <div>
                {{ form_label(form.status, null, {'label_attr': {'class': 'block text-gray-800 font-medium mb-2'}}) }}
                {{ form_widget(form.status) }}
                {{ form_errors(form.status) }}
            </div>

            <div>
                {{ form_label(form.date, null, {'label_attr': {'class': 'block text-gray-800 font-medium mb-2'}}) }}
                {{ form_widget(form.date) }}
                {{ form_errors(form.date) }}
            </div>

            <button type="submit"
                    class="w-full bg-blue-900 hover:bg-blue-800 text-white font-semibold py-3 rounded-xl transition">
                Publier
            </button>

        {{ form_end(form) }}
    </div>
</section>
{% endblock %}