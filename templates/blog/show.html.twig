{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} - DiabTrack{% endblock %}

{% block body %}
<section class="min-h-screen bg-white py-12 px-4">
    <div class="max-w-2xl mx-auto">

        <a href="{{ path('app_blog_index') }}" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-6">
            &larr; Retour au blog
        </a>

        {% if article.category %}
            <span class="inline-block text-xs font-medium text-blue-700 bg-blue-50 px-3 py-1 rounded-full mb-4">
                {{ article.category.title }}
            </span>
        {% endif %}

        <h1 class="text-3xl font-bold text-gray-800 mb-2">{{ article.title }}</h1>
        <p class="text-sm text-gray-400 mb-8">{{ article.author }} — {{ article.date|date('d/m/Y') }}</p>

        <div class="prose max-w-none text-gray-700 whitespace-pre-line mb-12">
            {{ article.content }}
        </div>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="flex gap-3 mb-12">
                <a href="{{ path('app_blog_edit', {id: article.id}) }}"
                   class="text-sm font-medium text-blue-700 hover:text-blue-900">
                    Modifier
                </a>
                <form method="post" action="{{ path('app_blog_delete', {id: article.id}) }}"
                      onsubmit="return confirm('Supprimer définitivement cet article ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ article.id) }}">
                    <button type="submit" class="text-sm font-medium text-red-600 hover:text-red-800">
                        Supprimer
                    </button>
                </form>
            </div>
        {% endif %}

        {# ---------------------------------------------------- #}
        {# COMMENTAIRES #}
        {# ---------------------------------------------------- #}
        <h2 class="text-lg font-semibold text-gray-800 mb-4">
            Commentaires ({{ article.commentArticle|length }})
        </h2>

        {% if article.commentArticle is empty %}
            <p class="text-gray-500 text-sm">Aucun commentaire pour le moment.</p>
        {% else %}
            <div class="flex flex-col gap-4">
                {% for comment in article.commentArticle %}
                    <div class="bg-gray-50 rounded-xl p-4">
                        <p class="text-sm text-gray-700">{{ comment.content }}</p>
                        <p class="text-xs text-gray-400 mt-2">
                            {{ comment.date|date('d/m/Y') }}
                        </p>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
{% endblock %}