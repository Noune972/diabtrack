{% extends 'base.html.twig' %}

{% block title %}Blog - DiabTrack{% endblock %}

{% block body %}
<section class="min-h-screen bg-gray-50 py-12 px-4">
    <div class="max-w-5xl mx-auto">

        <div class="flex items-center justify-between mb-10">
            <h1 class="text-3xl font-bold text-gray-800">Blog</h1>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_blog_new') }}"
                   class="bg-blue-900 hover:bg-blue-800 text-white font-medium px-5 py-2.5 rounded-xl transition">
                    + Nouvel article
                </a>
            {% endif %}
        </div>

        {% for message in app.flashes('success') %}
            <div class="bg-green-50 text-green-700 border border-green-200 rounded-xl px-4 py-3 mb-6 text-sm">
                {{ message }}
            </div>
        {% endfor %}

        {% if articles is empty %}
            <p class="text-gray-500 text-sm">Aucun article publié pour le moment.</p>
        {% else %}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for article in articles %}
                    <a href="{{ path('app_blog_show', {id: article.id}) }}"
                       class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition flex flex-col">
                        <div class="p-6 flex flex-col gap-3 flex-1">
                            {% if article.category %}
                                <span class="self-start text-xs font-medium text-blue-700 bg-blue-50 px-3 py-1 rounded-full">
                                    {{ article.category.title }}
                                </span>
                            {% endif %}
                            <h2 class="text-lg font-semibold text-gray-800">
                                {{ article.title }}
                            </h2>
                            <p class="text-gray-500 text-sm line-clamp-3">
                                {{ article.content|excerpt(180) }}
                            </p>
                            <p class="text-xs text-gray-400 mt-auto pt-2">
                                {{ article.author }} — {{ article.date|date('d/m/Y') }}
                            </p>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
{% endblock %}