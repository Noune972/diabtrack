{% extends 'base.html.twig' %}

{% block title %}Supprimer mon compte{% endblock %}

{% block body %}
<div class="max-w-lg mx-auto py-12 px-4">

    <div class="bg-white rounded-2xl shadow-lg ring-1 ring-red-100 p-6">

        <h1 class="text-2xl font-bold text-red-800 mb-4">⚠️ Supprimer mon compte</h1>

        <p class="text-gray-700 mb-4">
            Cette action est <strong>définitive et irréversible</strong>. En confirmant, vous supprimez :
        </p>

        <ul class="list-disc list-inside text-gray-700 mb-6 space-y-1">
            <li>Votre compte utilisateur et vos informations personnelles</li>
            <li>Tout votre historique de glycémie</li>
            <li>Tous vos repas enregistrés</li>
            <li>Tout vos commentaires</li>
            <li>Et tout l'ensemble de vos données confondues</li>
        </ul>

        {% for message in app.flashes('error') %}
            <div class="bg-red-50 text-red-800 text-sm font-semibold rounded-lg px-4 py-3 mb-4">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" action="{{ path('app_account_delete') }}"
            onsubmit="return confirm('Dernière confirmation : supprimer définitivement votre compte et toutes vos données ?');">

            <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">

            <label class="block font-semibold mb-2" for="password">
                Confirmez avec votre mot de passe
            </label>
            <input type="password" id="password" name="password" required
                class="w-full border-2 border-gray-200 rounded-xl px-3 py-2 mb-6 focus:border-red-600 outline-none">

            <button type="submit"
                class="w-full bg-red-700 hover:bg-red-800 text-white font-bold rounded-xl py-3">
                Supprimer définitivement mon compte
            </button>
        </form>

        <a href="{{ path('app_home') }}" class="block text-center mt-4 text-gray-500 hover:text-gray-700">
            Annuler, retourner à l'accueil
        </a>
    </div>
</div>
{% endblock %}