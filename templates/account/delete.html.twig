{% extends 'base.html.twig' %}

{% block title %}Supprimer mon compte{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-red-50 via-gray-50 to-gray-50 flex items-center justify-center px-4 py-12">

    <div class="max-w-lg w-full">

        <div class="bg-white rounded-3xl shadow-xl ring-1 ring-red-100 overflow-hidden">

            {# Bandeau d'alerte #}
            <div class="bg-gradient-to-r from-red-700 to-red-800 px-8 py-6 text-center">
                <div class="w-14 h-14 rounded-full bg-white/15 flex items-center justify-center mx-auto mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
                    </svg>
                </div>
                <h1 class="text-xl font-bold text-white">Supprimer mon compte</h1>
            </div>

            <div class="px-8 py-8">

                <p class="text-gray-600 mb-5 leading-relaxed">
                    Cette action est <strong class="text-red-700">définitive et irréversible</strong>.
                    En confirmant, vous supprimez :
                </p>

                <ul class="space-y-3 mb-8">
                    <li class="flex items-center gap-3 bg-red-50 rounded-xl px-4 py-3">
                        <span class="text-red-600">●</span>
                        <span class="text-gray-700 text-sm font-medium">Votre compte et vos informations personnelles</span>
                    </li>
                    <li class="flex items-center gap-3 bg-red-50 rounded-xl px-4 py-3">
                        <span class="text-red-600">●</span>
                        <span class="text-gray-700 text-sm font-medium">Tout votre historique de glycémie</span>
                    </li>
                    <li class="flex items-center gap-3 bg-red-50 rounded-xl px-4 py-3">
                        <span class="text-red-600">●</span>
                        <span class="text-gray-700 text-sm font-medium">Tous vos repas enregistrés</span>
                    </li>
                     <li class="flex items-center gap-3 bg-red-50 rounded-xl px-4 py-3">
                        <span class="text-red-600">●</span>
                        <span class="text-gray-700 text-sm font-medium"> Ainsi que toutes vos données confondues sur l 'application DiabTrack</span>
                    </li>
                    
                </ul>

                {% for message in app.flashes('error') %}
                    <div class="bg-red-50 border border-red-200 text-red-800 text-sm font-semibold rounded-xl px-4 py-3 mb-5 flex items-center gap-2">
                        <span>⚠️</span>
                        <span>{{ message }}</span>
                    </div>
                {% endfor %}

                <form method="post" action="{{ path('app_account_delete') }}"
                    onsubmit="return confirm('Dernière confirmation : supprimer définitivement votre compte et toutes vos données ?');">

                    <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">

                    <label class="block text-sm font-semibold text-gray-700 mb-2" for="password">
                        Confirmez avec votre mot de passe
                    </label>
                    <input type="password" id="password" name="password" required
                        placeholder="••••••••"
                        class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 mb-6 text-gray-800
                               focus:border-red-500 focus:ring-4 focus:ring-red-100 outline-none transition">

                    <button type="submit"
                        class="w-full bg-red-700 hover:bg-red-800 active:scale-[0.98] text-white font-bold
                               rounded-xl py-3.5 shadow-lg shadow-red-700/25 transition">
                        Supprimer définitivement mon compte
                    </button>
                </form>

                <a href="{{ path('app_home') }}"
                    class="block text-center mt-5 text-sm text-gray-500 hover:text-gray-700 font-medium transition">
                    ← Annuler, retourner à l'accueil
                </a>

            </div>
        </div>

    </div>
</div>
{% endblock %}