{% extends 'base.html.twig' %}

{% block title %}Mon compte - DiabTrack{% endblock %}

{% block body %}

<div class="min-h-screen bg-[#F5F9FC] px-4 py-6 sm:px-6 lg:px-8">

    <div class="mx-auto max-w-7xl">

        {# ================= HEADER ================= #}
        <section class="relative overflow-hidden rounded-[2rem] bg-[#102A43] px-6 py-8 text-white shadow-xl sm:px-8 lg:px-10">

            <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-cyan-400/10"></div>
            <div class="absolute -bottom-24 right-40 h-56 w-56 rounded-full bg-teal-400/10"></div>

            <div class="relative flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">

                <div>
                    <div class="mb-3 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-cyan-100">
                        <span class="h-2 w-2 rounded-full bg-cyan-300"></span>
                        Profil personnel
                    </div>

                    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
                        Mon compte
                    </h1>

                    <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-300 sm:text-base">
                        Consultez et mettez à jour vos informations personnelles
                        utilisées dans votre espace DiabTrack.
                    </p>
                </div>

                <div class="rounded-2xl border border-white/10 bg-white/10 px-5 py-4 backdrop-blur">
                    <p class="text-xs font-semibold uppercase tracking-wider text-cyan-200">
                        Compte connecté
                    </p>

                    <p class="mt-1 text-lg font-bold text-white">
                        {{ app.user.firstname }} {{ app.user.name }}
                    </p>

                    <p class="mt-1 text-sm text-slate-300">
                        {{ app.user.email }}
                    </p>
                </div>

            </div>
        </section>


        {# ================= FLASH MESSAGES ================= #}
        {% for message in app.flashes('success') %}
            <div class="mt-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm font-semibold text-emerald-800">
                ✓ {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm font-semibold text-red-700">
                {{ message }}
            </div>
        {% endfor %}


        {# ================= FORMULAIRE ================= #}
        <section class="mt-6 overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white shadow-sm">

            <div class="border-b border-slate-100 px-6 py-5 sm:px-8">
                <h2 class="text-xl font-bold text-[#102A43]">
                    Informations personnelles
                </h2>

                <p class="mt-1 text-sm text-slate-500">
                    Gardez vos informations à jour pour personnaliser votre espace.
                </p>
            </div>

            <div class="p-6 sm:p-8">

                {{ form_start(profileForm) }}

                {% if not profileForm.vars.valid %}
                    <div class="mb-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
                        {{ form_errors(profileForm) }}
                    </div>
                {% endif %}


                {# IDENTITÉ #}
                <div>
                    <div class="mb-5 flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-50 text-lg">
                            👤
                        </div>

                        <div>
                            <h3 class="font-bold text-[#102A43]">
                                Identité
                            </h3>

                            <p class="text-sm text-slate-500">
                                Vos informations principales.
                            </p>
                        </div>
                    </div>

                    <div class="grid gap-5 md:grid-cols-2">

                        <div>
                            {{ form_label(profileForm.firstname, null, {
                                label_attr: {
                                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                                }
                            }) }}

                            {{ form_widget(profileForm.firstname, {
                                attr: {
                                    class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(profileForm.firstname) }}
                            </div>
                        </div>


                        <div>
                            {{ form_label(profileForm.name, null, {
                                label_attr: {
                                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                                }
                            }) }}

                            {{ form_widget(profileForm.name, {
                                attr: {
                                    class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(profileForm.name) }}
                            </div>
                        </div>


                        <div>
                            {{ form_label(profileForm.gender, null, {
                                label_attr: {
                                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                                }
                            }) }}

                            {{ form_widget(profileForm.gender, {
                                attr: {
                                    class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(profileForm.gender) }}
                            </div>
                        </div>


                        <div>
                            {{ form_label(profileForm.dateOfBirth, null, {
                                label_attr: {
                                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                                }
                            }) }}

                            {{ form_widget(profileForm.dateOfBirth, {
                                attr: {
                                    class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(profileForm.dateOfBirth) }}
                            </div>
                        </div>

                    </div>
                </div>


                {# CONTACT #}
                <div class="mt-8 border-t border-slate-100 pt-8">

                    <div class="mb-5 flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-50 text-lg">
                            ✉️
                        </div>

                        <div>
                            <h3 class="font-bold text-[#102A43]">
                                Coordonnées
                            </h3>

                            <p class="text-sm text-slate-500">
                                Vos informations de contact.
                            </p>
                        </div>
                    </div>

                    <div class="grid gap-5 md:grid-cols-2">

                        <div>
                            {{ form_label(profileForm.email, null, {
                                label_attr: {
                                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                                }
                            }) }}

                            {{ form_widget(profileForm.email, {
                                attr: {
                                    class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(profileForm.email) }}
                            </div>
                        </div>


                        <div>
                            {{ form_label(profileForm.phone, null, {
                                label_attr: {
                                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                                }
                            }) }}

                            {{ form_widget(profileForm.phone, {
                                attr: {
                                    class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(profileForm.phone) }}
                            </div>
                        </div>

                    </div>


                    <div class="mt-5">
                        {{ form_label(profileForm.adress, null, {
                            label_attr: {
                                class: 'mb-2 block text-sm font-semibold text-slate-700'
                            }
                        }) }}

                        {{ form_widget(profileForm.adress, {
                            attr: {
                                class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                            }
                        }) }}

                        <div class="mt-1 text-sm text-red-600">
                            {{ form_errors(profileForm.adress) }}
                        </div>
                    </div>


                    <div class="mt-5 grid gap-5 md:grid-cols-2">

                        <div>
                            {{ form_label(profileForm.postalCode, null, {
                                label_attr: {
                                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                                }
                            }) }}

                            {{ form_widget(profileForm.postalCode, {
                                attr: {
                                    class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(profileForm.postalCode) }}
                            </div>
                        </div>


                        <div>
                            {{ form_label(profileForm.city, null, {
                                label_attr: {
                                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                                }
                            }) }}

                            {{ form_widget(profileForm.city, {
                                attr: {
                                    class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(profileForm.city) }}
                            </div>
                        </div>

                    </div>

                </div>


                {# INFORMATIONS PHYSIQUES #}
                <div class="mt-8 border-t border-slate-100 pt-8">

                    <div class="mb-5 flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-50 text-lg">
                            ⚖️
                        </div>

                        <div>
                            <h3 class="font-bold text-[#102A43]">
                                Informations physiques
                            </h3>

                            <p class="text-sm text-slate-500">
                                Votre poids et votre taille.
                            </p>
                        </div>
                    </div>

                    <div class="grid gap-5 md:grid-cols-2">

                        <div>
                            {{ form_label(profileForm.weight, null, {
                                label_attr: {
                                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                                }
                            }) }}

                            {{ form_widget(profileForm.weight, {
                                attr: {
                                    class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(profileForm.weight) }}
                            </div>
                        </div>


                        <div>
                            {{ form_label(profileForm.height, null, {
                                label_attr: {
                                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                                }
                            }) }}

                            {{ form_widget(profileForm.height, {
                                attr: {
                                    class: 'w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-[#102A43] outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-100'
                                }
                            }) }}

                            <div class="mt-1 text-sm text-red-600">
                                {{ form_errors(profileForm.height) }}
                            </div>
                        </div>

                    </div>

                </div>


                {# ACTION #}
                <div class="mt-8 flex justify-end border-t border-slate-100 pt-6">

                    <button
                        type="submit"
                        class="inline-flex items-center justify-center gap-2 rounded-xl bg-[#102A43] px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-[#163A5F] focus:outline-none focus:ring-4 focus:ring-cyan-100"
                    >
                        Enregistrer les modifications
                    </button>

                </div>

                {{ form_end(profileForm) }}

            </div>

        </section>


        {# ================= ZONE DANGER ================= #}
        <section class="mt-6 rounded-[1.75rem] border border-red-200 bg-white p-6 shadow-sm sm:p-8">

            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">

                <div>
                    <div class="mb-2 inline-flex rounded-full bg-red-50 px-3 py-1 text-xs font-bold uppercase tracking-wider text-red-700">
                        Zone sensible
                    </div>

                    <h2 class="text-lg font-bold text-[#102A43]">
                        Supprimer mon compte
                    </h2>

                    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
                        Cette action entraîne la suppression définitive de votre
                        compte et des données qui lui sont associées.
                    </p>
                </div>

                <a
                    href="{{ path('app_account_delete') }}"
                    class="inline-flex shrink-0 items-center justify-center rounded-xl border border-red-200 bg-red-50 px-5 py-3 text-sm font-bold text-red-700 transition hover:bg-red-100"
                >
                    Supprimer mon compte
                </a>

            </div>

        </section>

    </div>

</div>

{% endblock %}
